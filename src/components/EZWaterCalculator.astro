---
/* EZ Water & Cellular Charge Transport Interactive Calculator */

/* The programme this tool points at is passed in by the page, so the calculator
   cannot recommend a different spiral than the rest of the brief. It leads to the
   programme, not the Canadian dispensary — the tool's payoff should be reachable
   by the two thirds of readers Fullscript cannot ship to. */
interface Props {
  protocolName?: string;
  protocolHref?: string;
}
const {
  protocolName = "Living Waters",
  protocolHref = "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NA=="
} = Astro.props;
---

<div class="ez-calculator-card" id="ez-water-calculator">
  <div class="ez-header">
    <div class="ez-badge">🌊 Biophysics Interactive Tool</div>
    <h3>EZ Water & Cellular Charge Transport Calculator</h3>
    <p>Estimate your Exclusion Zone (H4O3 / H3O2) structured water formation potential and intracellular electrical potential based on light, solutes, and hydration inputs.</p>
  </div>

  <div class="ez-grid">
    <div class="ez-controls">
      <div class="ez-input-group">
        <label for="ez-weight">Body Weight (lbs): <span id="ez-weight-val">160</span> lbs</label>
        <input type="range" id="ez-weight" min="90" max="280" value="160" step="5" />
      </div>

      <div class="ez-input-group">
        <label for="ez-sunlight">Daily Infrared / Sunlight Exposure: <span id="ez-sunlight-val">30</span> mins</label>
        <input type="range" id="ez-sunlight" min="0" max="120" value="30" step="5" />
      </div>

      <div class="ez-input-group">
        <label for="ez-water-type">Water Quality Source:</label>
        <select id="ez-water-type">
          <option value="1.0">Spring / Glacial Mineral Water (100% EZ Potential)</option>
          <option value="0.85" selected>Remineralized Reverse Osmosis (85% EZ Potential)</option>
          <option value="0.60">Standard Filtered Tap Water (60% EZ Potential)</option>
          <option value="0.30">Unfiltered Municipal Tap Water (30% EZ Potential)</option>
        </select>
      </div>

      <div class="ez-input-group">
        <label for="ez-electrolytes">Electrolyte / Mineral Solute Level:</label>
        <select id="ez-electrolytes">
          <option value="1.2">Optimal (Sodium + Potassium + Magnesium + Trace Minerals)</option>
          <option value="1.0" selected>Moderate (Basic Salt or Electrolyte Powder)</option>
          <option value="0.7">Low (Plain De-mineralized Water Only)</option>
        </select>
      </div>
    </div>

    <div class="ez-results">
      <div class="ez-score-box">
        <div class="ez-score-label">Exclusion Zone (H3O2) Formation Potential</div>
        <div class="ez-score-number"><span id="ez-score">78</span>%</div>
        <div class="ez-meter"><div id="ez-meter-fill" class="ez-meter-fill" style="width: 78%;"></div></div>
      </div>

      <div class="ez-metrics">
        <div class="ez-metric">
          <span class="metric-title">Cellular Charge Potential</span>
          <span class="metric-value" id="ez-charge-val">-142 mV</span>
        </div>
        <div class="ez-metric">
          <span class="metric-title">Optimal Daily Water Target</span>
          <span class="metric-value" id="ez-volume-val">80 oz (2.4 L)</span>
        </div>
      </div>

      <div class="ez-recommendation" id="ez-rec">
        <strong>💡 Recommendation:</strong> Your EZ formation potential is in the <em>Optimal Range</em>. To boost cellular charge, pair morning infrared sunlight with ionic trace minerals.
      </div>

      <form class="ez-email-row" id="ez-email-form">
        <label for="ez-email-input" class="ez-email-label">Get the daily briefs, 6 field guides & every calculator update</label>
        <div class="ez-email-fields">
          <input
            type="email"
            id="ez-email-input"
            name="email"
            placeholder="Enter your email address..."
            required
            class="ez-email-input"
            aria-label="Email address"
          />
          <button type="submit" id="ez-email-submit" class="ez-email-submit">Email my breakdown</button>
        </div>
        <p class="ez-email-sent" id="ez-email-sent" hidden>We opened Substack in a new tab — confirm there to finish.</p>
      </form>

      <a href={protocolHref} target="_blank" rel="noopener noreferrer" class="ez-fullscript-btn">
        <span>View the {protocolName} protocol</span> ↗
      </a>
    </div>
  </div>
</div>

<style>
  .ez-calculator-card {
    margin: 40px 0;
    padding: 32px;
    background: color-mix(in oklch, var(--saffron) 6%, var(--paper));
    border: 1px solid color-mix(in oklch, var(--saffron) 35%, transparent);
    border-radius: 24px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
  }
  .ez-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--saffron-ink);
    background: color-mix(in oklch, var(--saffron) 15%, transparent);
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 12px;
  }
  .ez-header h3 {
    margin: 0 0 8px;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }
  .ez-header p {
    margin: 0 0 24px;
    font-size: 0.95rem;
    color: var(--muted);
    max-width: 680px;
  }
  .ez-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  @media (max-width: 840px) {
    .ez-grid {
      grid-template-columns: 1fr;
    }
  }
  .ez-input-group {
    margin-bottom: 20px;
  }
  .ez-input-group label {
    display: block;
    font-size: 0.84rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--ink);
  }
  .ez-input-group input[type="range"] {
    width: 100%;
    accent-color: var(--saffron-ink);
  }
  .ez-input-group select {
    width: 100%;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.85rem;
  }
  .ez-results {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: var(--paper);
    padding: 24px;
    border-radius: 20px;
    border: 1px solid var(--line);
  }
  .ez-score-box {
    text-align: center;
  }
  .ez-score-label {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ez-score-number {
    font-family: var(--serif);
    font-size: 3.2rem;
    font-weight: 700;
    color: var(--saffron-ink);
    line-height: 1;
    margin: 6px 0 10px;
  }
  .ez-meter {
    height: 8px;
    background: var(--line);
    border-radius: 4px;
    overflow: hidden;
  }
  .ez-meter-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--saffron) 0%, var(--saffron-ink) 100%);
    transition: width 0.3s ease;
  }
  .ez-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .ez-metric {
    background: color-mix(in oklch, var(--saffron) 6%, transparent);
    padding: 12px;
    border-radius: 12px;
    text-align: center;
  }
  .metric-title {
    display: block;
    font-size: 0.7rem;
    color: var(--muted);
    font-weight: 600;
    text-transform: uppercase;
  }
  .metric-value {
    display: block;
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--ink);
  }
  .ez-recommendation {
    font-size: 0.85rem;
    color: var(--ink-soft);
    line-height: 1.5;
    background: var(--cream);
    padding: 12px 16px;
    border-radius: 12px;
    border-left: 3px solid var(--saffron);
  }
  .ez-email-row {
    background: color-mix(in oklch, var(--saffron) 6%, transparent);
    padding: 14px 16px;
    border-radius: 12px;
  }
  .ez-email-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .ez-email-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ez-email-input {
    flex: 1 1 12rem;
    min-width: 0;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
    font: inherit;
    font-size: 0.85rem;
  }
  .ez-email-submit {
    flex: 0 0 auto;
    padding: 10px 16px;
    border: 0;
    border-radius: 10px;
    background: var(--saffron-ink);
    color: #fff;
    font: inherit;
    font-size: 0.83rem;
    font-weight: 700;
    cursor: pointer;
  }
  .ez-email-submit:hover { background: var(--ink); }
  .ez-email-submit:disabled { cursor: default; opacity: 0.7; }
  .ez-email-sent {
    margin: 8px 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .ez-fullscript-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 16px;
    background: var(--saffron-ink);
    color: var(--paper);
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    transition: all 0.2s ease;
    text-align: center;
  }
  .ez-fullscript-btn:hover {
    background: var(--ink);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }
</style>

<script>
  function initEZCalculator() {
    const weightInput = document.getElementById('ez-weight') as HTMLInputElement;
    const sunlightInput = document.getElementById('ez-sunlight') as HTMLInputElement;
    const waterSelect = document.getElementById('ez-water-type') as HTMLSelectElement;
    const electrolyteSelect = document.getElementById('ez-electrolytes') as HTMLSelectElement;

    const weightVal = document.getElementById('ez-weight-val');
    const sunlightVal = document.getElementById('ez-sunlight-val');
    const scoreVal = document.getElementById('ez-score');
    const meterFill = document.getElementById('ez-meter-fill');
    const chargeVal = document.getElementById('ez-charge-val');
    const volumeVal = document.getElementById('ez-volume-val');
    const recVal = document.getElementById('ez-rec');

    if (!weightInput || !sunlightInput || !waterSelect || !electrolyteSelect) return;

    function calculate() {
      const weight = parseFloat(weightInput.value);
      const sunlight = parseFloat(sunlightInput.value);
      const waterMult = parseFloat(waterSelect.value);
      const electrolyteMult = parseFloat(electrolyteSelect.value);

      if (weightVal) weightVal.textContent = String(weight);
      if (sunlightVal) sunlightVal.textContent = String(sunlight);

      // EZ Formation Potential (0 - 100%)
      const baseSunlightBonus = Math.min(30, (sunlight / 120) * 30);
      const baseScore = (45 + baseSunlightBonus) * waterMult * electrolyteMult;
      const finalScore = Math.min(99, Math.max(15, Math.round(baseScore)));

      if (scoreVal) scoreVal.textContent = String(finalScore);
      if (meterFill) meterFill.style.width = `${finalScore}%`;

      // Cellular charge potential (-80 mV to -175 mV)
      const charge = Math.round(-90 - (finalScore * 0.85));
      if (chargeVal) chargeVal.textContent = `${charge} mV`;

      // Water target (oz): weight * 0.5 * multiplier
      const volumeOz = Math.round(weight * 0.5);
      const volumeL = (volumeOz * 0.0295735).toFixed(1);
      if (volumeVal) volumeVal.textContent = `${volumeOz} oz (${volumeL} L)`;

      // Dynamic recommendation
      if (recVal) {
        if (finalScore >= 80) {
          recVal.innerHTML = `<strong>💡 Optimal EZ State:</strong> Your cellular charge potential (${charge} mV) supports maximum nutrient transport and mitochondrial ATP generation. Keep up morning sunlight!`;
        } else if (finalScore >= 55) {
          recVal.innerHTML = `<strong>💡 Moderate EZ State:</strong> Increasing morning infrared light (15+ mins) and adding ionic minerals can elevate your cellular charge from ${charge} mV toward -160 mV.`;
        } else {
          recVal.innerHTML = `<strong>⚠️ Low EZ Formation:</strong> Unfiltered tap water and low mineral solute limits cellular exclusion zone thickness. Consider remineralized spring water.`;
        }
      }
    }

    weightInput.addEventListener('input', calculate);
    sunlightInput.addEventListener('input', calculate);
    waterSelect.addEventListener('change', calculate);
    electrolyteSelect.addEventListener('change', calculate);

    calculate();

    const emailForm = document.getElementById('ez-email-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('ez-email-input') as HTMLInputElement | null;
    const emailSubmit = document.getElementById('ez-email-submit') as HTMLButtonElement | null;
    const emailSent = document.getElementById('ez-email-sent');

    emailForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = emailInput?.value.trim();
      if (!email) return;

      // Same Substack handoff as the rest of the site: the list is owned there,
      // so this is a lead capture that finishes on their confirmation page.
      const handoff = "https://agewellbrief.substack.com/subscribe?email=" + encodeURIComponent(email);
      window.open(handoff, "_blank", "noopener");

      try {
        localStorage.setItem("agewell:guide-email-given", "1");
      } catch {
        /* blocked storage: the field guide gate defaults to open */
      }

      if (emailSubmit) {
        emailSubmit.disabled = true;
        emailSubmit.textContent = "Opened in a new tab →";
      }
      if (emailForm) emailForm.style.display = "none";
      if (emailSent) emailSent.hidden = false;
    });
  }

  document.addEventListener('DOMContentLoaded', initEZCalculator);
</script>
