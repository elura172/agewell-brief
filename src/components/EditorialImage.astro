---
interface Props {
  src: string;
  alt: string;
  photographer?: string;
  photographerUrl?: string;
  sourceUrl?: string;
  provider?: "Pexels" | "Pixabay" | "Unsplash" | "Gemini" | "Agewell Visual Desk";
  width?: number;
  height?: number;
  avgColor?: string;
  variant?: "featured" | "card" | "article";
  eager?: boolean;
}

const {
  src,
  alt,
  photographer = "Photo contributor",
  photographerUrl,
  sourceUrl,
  provider = "Pexels",
  width = 1200,
  height = 627,
  avgColor = "#e6dfd3",
  variant = "article",
  eager = false
} = Astro.props;

const isLithograph = provider === "Gemini" || provider === "Agewell Visual Desk";
---
<figure class:list={["editorial-image", `editorial-image--${variant}`, isLithograph && "editorial-image--lithograph"]} style={`--image-tone: ${avgColor}`}>
  <div class="editorial-image-frame">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? "eager" : "lazy"}
      {...(eager ? { fetchpriority: "high" } : {})}
      decoding="async"
    />
  </div>
  <figcaption>
    {isLithograph ? (
      <>Editorial lithograph · {photographer && photographer !== "Photo contributor" ? photographer : "Agewell Brief Visual Desk"}</>
    ) : (
      <>
        Illustrative photo by
        {photographerUrl ? <a href={photographerUrl} rel="noopener noreferrer">{photographer}</a> : photographer}
        {sourceUrl ? <> on <a href={sourceUrl} rel="noopener noreferrer">{provider}</a></> : <> via {provider}</>}
      </>
    )}
  </figcaption>
</figure>
