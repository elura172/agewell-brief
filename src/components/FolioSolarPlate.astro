---
interface Props {
  season: "winter-solstice" | "vernal-equinox" | "summer-solstice" | "autumnal-equinox";
  size?: "hero" | "card" | "compact";
}

const { season, size = "card" } = Astro.props;
---
<div class={`folio-solar-plate folio-solar-plate--${size}`} aria-hidden="true">
  {season === "winter-solstice" && (
    <svg viewBox="0 0 240 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      {/* Outer celestial meridian & horizon */}
      <circle cx="120" cy="80" r="64" stroke="currentColor" stroke-width="1" opacity="0.82" />
      <circle cx="120" cy="80" r="58" stroke="currentColor" stroke-width="0.6" stroke-dasharray="2 3" opacity="0.45" />
      <line x1="36" y1="80" x2="204" y2="80" stroke="currentColor" stroke-width="1" />
      <line x1="120" y1="10" x2="120" y2="150" stroke="currentColor" stroke-width="0.6" stroke-dasharray="2 3" opacity="0.5" />

      {/* Hatching in the lower night hemisphere */}
      <path d="M62 96 H178 M68 108 H172 M78 120 H162 M93 132 H147" stroke="currentColor" stroke-width="0.55" opacity="0.22" />

      {/* Low winter solar arc above horizon + deep slow-wave curve below */}
      <path d="M66 80 Q120 48 174 80" stroke="var(--saffron-ink)" stroke-width="1.4" />
      <path d="M64 98 C82 84, 98 114, 120 98 C142 82, 158 114, 176 98" stroke="currentColor" stroke-width="1.05" opacity="0.78" />

      {/* Nadir cellular furnace / solstice star */}
      <circle cx="120" cy="64" r="4.2" fill="var(--saffron)" stroke="var(--saffron-ink)" stroke-width="1" />
      <circle cx="120" cy="122" r="3" fill="var(--paper)" stroke="var(--saffron-ink)" stroke-width="1.2" />
      <path d="M120 114 V130 M112 122 H128" stroke="var(--saffron-ink)" stroke-width="0.9" />

      {/* Degree ticks */}
      <text x="208" y="83" fill="currentColor" font-size="7.5" font-family="var(--sans)" letter-spacing="0.08em" opacity="0.68">270°</text>
      <text x="16" y="83" fill="currentColor" font-size="7.5" font-family="var(--sans)" letter-spacing="0.08em" opacity="0.68">N</text>
    </svg>
  )}

  {season === "vernal-equinox" && (
    <svg viewBox="0 0 240 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="120" cy="80" r="60" stroke="currentColor" stroke-width="1" opacity="0.8" />
      <line x1="44" y1="80" x2="196" y2="80" stroke="currentColor" stroke-width="1" />
      <ellipse cx="120" cy="80" rx="60" ry="22" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2.5 2.5" opacity="0.55" />
      <path d="M60 80 C85 38, 155 122, 180 80" stroke="var(--saffron-ink)" stroke-width="1.35" />
      <circle cx="120" cy="80" r="4" fill="var(--saffron)" stroke="var(--saffron-ink)" stroke-width="1" />
      <text x="202" y="83" fill="currentColor" font-size="7.5" font-family="var(--sans)" letter-spacing="0.08em" opacity="0.65">0°</text>
    </svg>
  )}

  {season === "summer-solstice" && (
    <svg viewBox="0 0 240 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="120" cy="80" r="60" stroke="currentColor" stroke-width="1" opacity="0.8" />
      <circle cx="120" cy="52" r="18" stroke="var(--saffron-ink)" stroke-width="0.75" stroke-dasharray="2 2.5" opacity="0.65" />
      <line x1="44" y1="96" x2="196" y2="96" stroke="currentColor" stroke-width="1" />
      <path d="M62 96 Q120 12 178 96" stroke="var(--saffron-ink)" stroke-width="1.4" />
      <circle cx="120" cy="52" r="4.5" fill="var(--saffron)" stroke="var(--saffron-ink)" stroke-width="1" />
      <text x="202" y="83" fill="currentColor" font-size="7.5" font-family="var(--sans)" letter-spacing="0.08em" opacity="0.65">90°</text>
    </svg>
  )}

  {season === "autumnal-equinox" && (
    <svg viewBox="0 0 240 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="120" cy="80" r="60" stroke="currentColor" stroke-width="1" opacity="0.8" />
      <circle cx="120" cy="80" r="36" stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 2.5" opacity="0.55" />
      <line x1="44" y1="80" x2="196" y2="80" stroke="currentColor" stroke-width="1" />
      <line x1="120" y1="20" x2="120" y2="140" stroke="currentColor" stroke-width="0.75" opacity="0.5" />
      <path d="M84 80 A36 36 0 0 1 156 80" stroke="var(--saffron-ink)" stroke-width="1.4" />
      <circle cx="120" cy="80" r="4" fill="var(--saffron)" stroke="var(--saffron-ink)" stroke-width="1" />
      <text x="202" y="83" fill="currentColor" font-size="7.5" font-family="var(--sans)" letter-spacing="0.08em" opacity="0.65">180°</text>
    </svg>
  )}
</div>
