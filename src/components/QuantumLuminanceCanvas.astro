---
export type PaletteKey = "default" | "living-waters" | "inner-garden" | "cell-shedding" | "higher-flame" | "luminous-mind" | "dark-mirror" | "functional-health" | "regenerative-health" | "quantum-biology" | "vibrational-health";

interface Props {
  class?: string;
  height?: number;
  palette?: PaletteKey;
}

const { class: className = "", height = 340, palette = "default" } = Astro.props;
---
<div class:list={["quantum-luminance-container", className]}>
  <canvas class="quantum-luminance-canvas" data-height={height} data-palette={palette}></canvas>
  <div class="quantum-luminance-overlay" aria-hidden="true"></div>
</div>

<style>
  .quantum-luminance-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: oklch(0.96 0.015 85);
    box-shadow: var(--shadow-md);
  }
  .quantum-luminance-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .quantum-luminance-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 50% 50%, transparent 40%, oklch(0.978 0.012 85 / 0.3) 100%);
  }
</style>

<script>
  const PALETTES = {
    "default": {
      p1: "oklch(0.72 0.15 62)",
      p2: "oklch(0.55 0.12 175)",
      bg0: "oklch(0.97 0.016 85)",
      bg1: "oklch(0.945 0.022 175)",
      bg2: "oklch(0.92 0.028 240 / 0.15)",
      w0: "oklch(0.72 0.15 62 / 0.28)",
      w1: "oklch(0.46 0.14 52 / 0.22)",
      w2: "oklch(0.55 0.1 175 / 0.25)"
    },
    "living-waters": {
      p1: "oklch(0.58 0.16 230)",
      p2: "oklch(0.68 0.14 190)",
      bg0: "oklch(0.96 0.02 220)",
      bg1: "oklch(0.93 0.03 210)",
      bg2: "oklch(0.90 0.04 240 / 0.18)",
      w0: "oklch(0.58 0.16 230 / 0.28)",
      w1: "oklch(0.45 0.15 220 / 0.22)",
      w2: "oklch(0.68 0.14 190 / 0.25)"
    },
    "inner-garden": {
      p1: "oklch(0.60 0.15 140)",
      p2: "oklch(0.72 0.12 110)",
      bg0: "oklch(0.97 0.018 135)",
      bg1: "oklch(0.94 0.025 140)",
      bg2: "oklch(0.91 0.03 150 / 0.18)",
      w0: "oklch(0.60 0.15 140 / 0.28)",
      w1: "oklch(0.45 0.14 130 / 0.22)",
      w2: "oklch(0.72 0.12 110 / 0.25)"
    },
    "cell-shedding": {
      p1: "oklch(0.68 0.14 350)",
      p2: "oklch(0.75 0.08 40)",
      bg0: "oklch(0.97 0.015 350)",
      bg1: "oklch(0.94 0.02 340)",
      bg2: "oklch(0.92 0.025 20 / 0.18)",
      w0: "oklch(0.68 0.14 350 / 0.28)",
      w1: "oklch(0.55 0.12 330 / 0.22)",
      w2: "oklch(0.75 0.08 40 / 0.25)"
    },
    "higher-flame": {
      p1: "oklch(0.74 0.18 55)",
      p2: "oklch(0.62 0.16 35)",
      bg0: "oklch(0.97 0.02 65)",
      bg1: "oklch(0.94 0.03 50)",
      bg2: "oklch(0.91 0.04 40 / 0.18)",
      w0: "oklch(0.74 0.18 55 / 0.28)",
      w1: "oklch(0.55 0.16 45 / 0.22)",
      w2: "oklch(0.62 0.16 35 / 0.25)"
    },
    "luminous-mind": {
      p1: "oklch(0.58 0.18 280)",
      p2: "oklch(0.65 0.15 250)",
      bg0: "oklch(0.96 0.02 280)",
      bg1: "oklch(0.93 0.03 270)",
      bg2: "oklch(0.90 0.04 260 / 0.18)",
      w0: "oklch(0.58 0.18 280 / 0.28)",
      w1: "oklch(0.45 0.16 270 / 0.22)",
      w2: "oklch(0.65 0.15 250 / 0.25)"
    },
    "dark-mirror": {
      p1: "oklch(0.48 0.08 260)",
      p2: "oklch(0.65 0.12 70)",
      bg0: "oklch(0.95 0.01 260)",
      bg1: "oklch(0.92 0.018 265)",
      bg2: "oklch(0.89 0.025 270 / 0.18)",
      w0: "oklch(0.48 0.08 260 / 0.28)",
      w1: "oklch(0.38 0.08 250 / 0.22)",
      w2: "oklch(0.65 0.12 70 / 0.25)"
    },
    "functional-health": {
      p1: "oklch(0.65 0.16 160)",
      p2: "oklch(0.72 0.14 85)",
      bg0: "oklch(0.97 0.018 150)",
      bg1: "oklch(0.94 0.025 140)",
      bg2: "oklch(0.91 0.03 160 / 0.18)",
      w0: "oklch(0.65 0.16 160 / 0.28)",
      w1: "oklch(0.50 0.14 140 / 0.22)",
      w2: "oklch(0.72 0.14 85 / 0.25)"
    },
    "regenerative-health": {
      p1: "oklch(0.70 0.18 50)",
      p2: "oklch(0.62 0.15 20)",
      bg0: "oklch(0.97 0.02 55)",
      bg1: "oklch(0.94 0.03 40)",
      bg2: "oklch(0.91 0.035 30 / 0.18)",
      w0: "oklch(0.70 0.18 50 / 0.28)",
      w1: "oklch(0.52 0.15 35 / 0.22)",
      w2: "oklch(0.62 0.15 20 / 0.25)"
    },
    "quantum-biology": {
      p1: "oklch(0.60 0.18 290)",
      p2: "oklch(0.68 0.15 200)",
      bg0: "oklch(0.96 0.02 290)",
      bg1: "oklch(0.93 0.03 270)",
      bg2: "oklch(0.90 0.04 240 / 0.18)",
      w0: "oklch(0.60 0.18 290 / 0.28)",
      w1: "oklch(0.46 0.15 260 / 0.22)",
      w2: "oklch(0.68 0.15 200 / 0.25)"
    },
    "vibrational-health": {
      p1: "oklch(0.74 0.15 85)",
      p2: "oklch(0.65 0.14 175)",
      bg0: "oklch(0.97 0.016 85)",
      bg1: "oklch(0.945 0.022 175)",
      bg2: "oklch(0.92 0.028 200 / 0.18)",
      w0: "oklch(0.74 0.15 85 / 0.28)",
      w1: "oklch(0.52 0.14 120 / 0.22)",
      w2: "oklch(0.65 0.14 175 / 0.25)"
    }
  };

  function initQuantumCanvas() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const containers = document.querySelectorAll<HTMLElement>(".quantum-luminance-container");
    containers.forEach((container) => {
      const canvas = container.querySelector<HTMLCanvasElement>(".quantum-luminance-canvas");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      const paletteKey = (canvas.dataset.palette || "default") as keyof typeof PALETTES;
      const colors = PALETTES[paletteKey] || PALETTES["default"];

      let animId: number;
      let width = 0;
      let height = 0;
      let isVisible = false;

      interface Particle {
        x: number;
        y: number;
        radius: number;
        vx: number;
        vy: number;
        hue: string;
        alpha: number;
        phase: number;
      }

      const particles: Particle[] = [];

      function resize() {
        const rect = container.getBoundingClientRect();
        width = rect.width;
        height = parseInt(canvas?.dataset.height || "340", 10);
        if (!canvas) return;
        canvas.width = width * window.devicePixelRatio;
        canvas.height = height * window.devicePixelRatio;
        ctx?.scale(window.devicePixelRatio, window.devicePixelRatio);
        canvas.style.height = `${height}px`;

        if (particles.length === 0) {
          const numParticles = Math.min(Math.floor(width / 22), 36);
          for (let i = 0; i < numParticles; i++) {
            particles.push({
              x: Math.random() * width,
              y: Math.random() * height,
              radius: Math.random() * 3 + 1.5,
              vx: (Math.random() - 0.5) * 0.3,
              vy: (Math.random() - 0.5) * 0.3,
              hue: Math.random() > 0.4 ? colors.p1 : colors.p2,
              alpha: Math.random() * 0.35 + 0.2,
              phase: Math.random() * Math.PI * 2
            });
          }
        }
      }

      function draw(time: number) {
        if (!isVisible || !ctx) return;
        ctx.clearRect(0, 0, width, height);

        // Draw soft ambient wave interference background
        const grad = ctx.createLinearGradient(0, 0, width, height);
        grad.addColorStop(0, colors.bg0);
        grad.addColorStop(0.5, colors.bg1);
        grad.addColorStop(1, colors.bg2);
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, width, height);

        // Draw flowing biophotonic wave lines
        ctx.lineWidth = 1.5;
        const waveColors = [colors.w0, colors.w1, colors.w2];
        for (let w = 0; w < 3; w++) {
          ctx.beginPath();
          ctx.strokeStyle = waveColors[w];

          for (let x = 0; x <= width; x += 10) {
            const y = height / 2 + Math.sin(x * 0.008 + time * 0.001 + w * 1.5) * 26 + Math.cos(x * 0.004 + time * 0.0008) * 14;
            if (x === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          ctx.stroke();
        }

        // Draw particles & biophotonic light nodes
        particles.forEach((p) => {
          p.x += p.vx;
          p.y += p.vy;
          p.phase += 0.02;

          if (p.x < 0) p.x = width;
          if (p.x > width) p.x = 0;
          if (p.y < 0) p.y = height;
          if (p.y > height) p.y = 0;

          const currentAlpha = p.alpha + Math.sin(p.phase) * 0.15;
          ctx.fillStyle = p.hue;
          ctx.globalAlpha = Math.max(0.1, Math.min(1, currentAlpha));

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
          ctx.fill();

          // Subdued light aura
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.radius * 3.5, 0, Math.PI * 2);
          ctx.fillStyle = p.hue;
          ctx.globalAlpha = Math.max(0.02, Math.min(0.2, currentAlpha * 0.2));
          ctx.fill();
        });

        ctx.globalAlpha = 1;
        animId = requestAnimationFrame(draw);
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible) {
            cancelAnimationFrame(animId);
            animId = requestAnimationFrame(draw);
          } else {
            cancelAnimationFrame(animId);
          }
        });
      });

      window.addEventListener("resize", resize);
      resize();
      observer.observe(container);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initQuantumCanvas);
  } else {
    initQuantumCanvas();
  }
</script>
