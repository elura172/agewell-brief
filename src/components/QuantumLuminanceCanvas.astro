---
interface Props {
  class?: string;
  height?: number;
}
const { class: className = "", height = 340 } = Astro.props;
---
<div class:list={["quantum-luminance-container", className]}>
  <canvas class="quantum-luminance-canvas" data-height={height}></canvas>
  <div class="quantum-luminance-overlay" aria-hidden="true"></div>
</div>

<style>
  .quantum-luminance-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: oklch(0.96 0.015 85);
    box-shadow: var(--shadow-md);
  }
  .quantum-luminance-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .quantum-luminance-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 50% 50%, transparent 40%, oklch(0.978 0.012 85 / 0.3) 100%);
  }
</style>

<script>
  function initQuantumCanvas() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const containers = document.querySelectorAll<HTMLElement>(".quantum-luminance-container");
    containers.forEach((container) => {
      const canvas = container.querySelector<HTMLCanvasElement>(".quantum-luminance-canvas");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      let animId: number;
      let width = 0;
      let height = 0;
      let isVisible = false;

      interface Particle {
        x: number;
        y: number;
        radius: number;
        vx: number;
        vy: number;
        hue: string;
        alpha: number;
        phase: number;
      }

      const particles: Particle[] = [];

      function resize() {
        const rect = container.getBoundingClientRect();
        width = rect.width;
        height = parseInt(canvas?.dataset.height || "340", 10);
        if (!canvas) return;
        canvas.width = width * window.devicePixelRatio;
        canvas.height = height * window.devicePixelRatio;
        ctx?.scale(window.devicePixelRatio, window.devicePixelRatio);
        canvas.style.height = `${height}px`;

        if (particles.length === 0) {
          const numParticles = Math.min(Math.floor(width / 22), 36);
          for (let i = 0; i < numParticles; i++) {
            particles.push({
              x: Math.random() * width,
              y: Math.random() * height,
              radius: Math.random() * 3 + 1.5,
              vx: (Math.random() - 0.5) * 0.3,
              vy: (Math.random() - 0.5) * 0.3,
              hue: Math.random() > 0.4 ? "oklch(0.72 0.15 62)" : "oklch(0.55 0.12 175)",
              alpha: Math.random() * 0.35 + 0.2,
              phase: Math.random() * Math.PI * 2
            });
          }
        }
      }

      function draw(time: number) {
        if (!isVisible || !ctx) return;
        ctx.clearRect(0, 0, width, height);

        // Draw soft ambient wave interference background
        const grad = ctx.createLinearGradient(0, 0, width, height);
        grad.addColorStop(0, "oklch(0.97 0.016 85)");
        grad.addColorStop(0.5, "oklch(0.945 0.022 175)");
        grad.addColorStop(1, "oklch(0.92 0.028 240 / 0.15)");
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, width, height);

        // Draw flowing biophotonic wave lines
        ctx.lineWidth = 1.5;
        const numWaves = 3;
        for (let w = 0; w < numWaves; w++) {
          ctx.beginPath();
          const waveColor = w === 0 ? "oklch(0.72 0.15 62 / 0.28)" : w === 1 ? "oklch(0.46 0.14 52 / 0.22)" : "oklch(0.55 0.1 175 / 0.25)";
          ctx.strokeStyle = waveColor;

          for (let x = 0; x <= width; x += 10) {
            const y = height / 2 + Math.sin(x * 0.008 + time * 0.001 + w * 1.5) * 26 + Math.cos(x * 0.004 + time * 0.0008) * 14;
            if (x === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          ctx.stroke();
        }

        // Draw particles & biophotonic light nodes
        particles.forEach((p) => {
          p.x += p.vx;
          p.y += p.vy;
          p.phase += 0.02;

          if (p.x < 0) p.x = width;
          if (p.x > width) p.x = 0;
          if (p.y < 0) p.y = height;
          if (p.y > height) p.y = 0;

          const currentAlpha = p.alpha + Math.sin(p.phase) * 0.15;
          ctx.fillStyle = p.hue;
          ctx.globalAlpha = Math.max(0.1, Math.min(1, currentAlpha));

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
          ctx.fill();

          // Subdued light aura
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.radius * 3.5, 0, Math.PI * 2);
          ctx.fillStyle = p.hue;
          ctx.globalAlpha = Math.max(0.02, Math.min(0.2, currentAlpha * 0.2));
          ctx.fill();
        });

        ctx.globalAlpha = 1;
        animId = requestAnimationFrame(draw);
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible) {
            cancelAnimationFrame(animId);
            animId = requestAnimationFrame(draw);
          } else {
            cancelAnimationFrame(animId);
          }
        });
      });

      window.addEventListener("resize", resize);
      resize();
      observer.observe(container);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initQuantumCanvas);
  } else {
    initQuantumCanvas();
  }
</script>
