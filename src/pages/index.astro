---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import EditorialImage from "../components/EditorialImage.astro";
import { linkRel, typographic } from "../lib/publishing";

const showDrafts = import.meta.env.DEV;
const entries = (await getCollection("briefs"))
  .filter((entry) => showDrafts || !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.edition_rank - b.data.edition_rank);
const editionKey = (entry: (typeof entries)[number]) =>
  entry.data.edition_id ?? entry.data.date.toISOString().slice(0, 10);
const latestEdition = entries[0] ? editionKey(entries[0]) : undefined;
const editionEntries = entries.filter((entry) => editionKey(entry) === latestEdition);
const featured = editionEntries.find((entry) => entry.data.content_type === "lead") ?? editionEntries[0];
const recent = editionEntries.filter((entry) => entry.id !== featured?.id).slice(0, 2);
const displayedCount = (featured ? 1 : 0) + recent.length;
const latestIds = new Set([featured?.id, ...recent.map((entry) => entry.id)]);
const earlier = entries.filter((entry) => !latestIds.has(entry.id));
const formatDate = (date: Date) => date.toLocaleDateString("en-CA", { month: "long", day: "numeric", year: "numeric" });
const editionDate = featured ? formatDate(featured.data.date) : formatDate(new Date());
// Brief pages already carry NewsArticle + BreadcrumbList JSON-LD; the
// homepage itself had none. Organization + WebSite here is what search
// engines use to attribute the individual articles back to the publication.
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Agewell Brief",
    url: new URL("/", Astro.site).href,
    logo: new URL("/logo.svg", Astro.site).href,
    sameAs: ["https://agewellbrief.substack.com"]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Agewell Brief",
    url: new URL("/", Astro.site).href,
    publisher: { "@type": "Organization", name: "Agewell Brief" }
  }
];
---
<Layout structuredData={structuredData}>
  {showDrafts && <div class="edition-strip" aria-label="Preview status"><span>LOCAL DRAFT PREVIEW</span><span>NOT PUBLIC</span></div>}
  
  {/* The edition leads; publication context lives in the masthead and about page. */}
  <section id="latest" class="edition-hero" aria-labelledby="edition-heading">
    <div class="edition-mast">
      <span>Latest edition{featured && <> · <time datetime={featured.data.date.toISOString()}>{editionDate}</time></>}</span>
      <span>{displayedCount} {displayedCount === 1 ? "brief" : "briefs"}</span>
      <span>Original sources</span>
    </div>
    {featured ? (
      <article class:list={["lead-story", { "has-image": featured.data.image }]}>
        <div class="lead-story-copy">
          <div class="lead-kicker"><span>{featured.data.content_type === "lead" ? "The deep read" : "Featured brief"}</span><span>{featured.data.category}</span></div>
          <h1 id="edition-heading"><a href={`/brief/${featured.id}/`}>{typographic(featured.data.title)}</a></h1>
          <p class="lead-dek">{featured.data.description ?? featured.body.split(/\n\s*\n/)[0]?.replace(/^#+\s*/, "")}</p>
          <div class="lead-actions">
            <a class="primary-link" href={`/brief/${featured.id}/`}>Read the full analysis <span>→</span></a>
            <p>Original reporting: <a href={featured.data.source_url} rel={linkRel(featured.data.source_url)}>{featured.data.source_name}</a></p>
          </div>
        </div>
        {featured.data.image && <EditorialImage
          src={featured.data.image}
          alt={featured.data.image_alt ?? "Illustrative photograph for this Agewell Brief article"}
          photographer={featured.data.image_photographer}
          photographerUrl={featured.data.image_photographer_url}
          sourceUrl={featured.data.image_source_url}
          provider={featured.data.image_provider}
          width={featured.data.image_width}
          height={featured.data.image_height}
          avgColor={featured.data.image_avg_color}
          variant="featured"
          eager={true}
        />}
      </article>
    ) : (
      <div class="empty-state"><h1 id="edition-heading">The first signal is on its way.</h1><p>Fresh briefs appear here after editorial review.</p></div>
    )}

    {recent.length > 0 && <div class="quick-signals">
      <div class="quick-signals-heading">
        <div>
          <p class="eyebrow">Also in Today’s Edition</p>
          <h2>{recent.length === 1 ? "Further dispatch" : "Further dispatches"}</h2>
        </div>
        <p>Concise signals from today’s desk.</p>
      </div>
      <div class="quick-signals-layout">
        {recent.map((entry, index) => (
          <article class="quick-story">
            {entry.data.image && <EditorialImage
              src={entry.data.image}
              alt={entry.data.image_alt ?? "Illustrative photograph for this Agewell Brief signal"}
              photographer={entry.data.image_photographer}
              photographerUrl={entry.data.image_photographer_url}
              sourceUrl={entry.data.image_source_url}
              provider={entry.data.image_provider}
              width={entry.data.image_width}
              height={entry.data.image_height}
              avgColor={entry.data.image_avg_color}
              variant="card"
            />}
            <div class="quick-story-copy">
              <div class="story-topline">
                <span>{entry.data.category}</span>
                <span class={`evidence-badge evidence-badge--${entry.data.evidence_position}`}>{entry.data.evidence_position}</span>
                <span>{String(index + 2).padStart(2, "0")}</span>
              </div>
              <h3><a href={`/brief/${entry.id}/`}>{typographic(entry.data.title)}</a></h3>
              <div class="story-foot"><span>{formatDate(entry.data.date)}</span><a href={`/brief/${entry.id}/`}>Read signal <span>→</span></a></div>
            </div>
          </article>
        ))}
      </div>
    </div>}
  </section>

  {/* 3. Recent archive — capped and linked to the full filterable archive
       rather than rendering all ~109 entries unpaginated. A homepage-scoped
       filter bar was removed on purpose: with only 15 items in the DOM here,
       pill counts drawn from the full archive would promise more results
       than this page could ever show — the same mismatch bug fixed above,
       just reintroduced a different way. */}
  {earlier.length > 0 && <section id="archive" class="archive-section" aria-labelledby="archive-heading">
    <div class="section-heading archive-heading">
      <div>
        <p class="eyebrow">Archive Index</p>
        <h2 id="archive-heading" class="section-title">Recent briefs</h2>
      </div>
      <p class="section-caption">The useful signals stay available.</p>
    </div>

    <ol class="archive-list" id="archive-list">
      {earlier.slice(0, 15).map((entry, index) => (
        <li class="archive-item">
          <article class="archive-entry">
            <div class="archive-index">{String(index + displayedCount + 1).padStart(2, "0")}</div>
            <div class="archive-copy">
              <p>
                <span>{entry.data.category}</span> · <span class={`evidence-badge evidence-badge--${entry.data.evidence_position}`}>{entry.data.evidence_position}</span> · <span>{formatDate(entry.data.date)}</span>
              </p>
              <h3><a href={`/brief/${entry.id}/`}>{typographic(entry.data.title)}</a></h3>
            </div>
            <a class="archive-source" href={entry.data.source_url} rel={linkRel(entry.data.source_url)}>Original source <span>↗</span></a>
          </article>
        </li>
      ))}
    </ol>

    <p class="archive-view-all"><a href="/archive/">View the full archive ({entries.length} briefs) <span aria-hidden="true">→</span></a></p>
  </section>}

  {/* 4. Spiral of Cellular Light — minimal typographic index */}
  <section class="frameworks-guide-section" aria-labelledby="frameworks-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Spiral of Cellular Light</p>
        <h2 id="frameworks-heading" class="section-title">Six Research Lenses</h2>
      </div>
      <p class="section-caption"><a href="/spiral-of-cellular-light/">Explore the full framework <span aria-hidden="true">→</span></a></p>
    </div>
    <ol class="frameworks-grid">
      <li class="framework-card">
        <span class="framework-num" aria-hidden="true">01</span>
        <div class="framework-body">
          <p class="framework-tag">Fluid &amp; Micro-Circulation</p>
          <h3><a href="/spiral-of-cellular-light/#living-waters">Living Waters</a></h3>
          <p class="framework-desc">Interfacial exclusion zone (H₃O₂) hydration, hepatic Phase I/II clearance, and vascular transport kinetics.</p>
          <p class="framework-links"><a href="/spiral-of-cellular-light/#living-waters">Lens overview <span>→</span></a> · <a href="/topics/longevity/">Longevity archive</a></p>
        </div>
      </li>
      <li class="framework-card">
        <span class="framework-num" aria-hidden="true">02</span>
        <div class="framework-body">
          <p class="framework-tag">Gut Microbiome Ecology</p>
          <h3><a href="/spiral-of-cellular-light/#inner-garden">Inner Garden</a></h3>
          <p class="framework-desc">Short-chain fatty acid signaling, mucosal barrier integrity, and microbial circadian rhythmicity.</p>
          <p class="framework-links"><a href="/spiral-of-cellular-light/#inner-garden">Lens overview <span>→</span></a> · <a href="/topics/gut-health/">Gut health archive</a></p>
        </div>
      </li>
      <li class="framework-card">
        <span class="framework-num" aria-hidden="true">03</span>
        <div class="framework-body">
          <p class="framework-tag">Senescence &amp; Cellular Renewal</p>
          <h3><a href="/spiral-of-cellular-light/#cell-shedding">Cell Shedding</a></h3>
          <p class="framework-desc">Targeted senolytic clearing cycles, autophagic lysosomal renewal, and SASP attenuation.</p>
          <p class="framework-links"><a href="/spiral-of-cellular-light/#cell-shedding">Lens overview <span>→</span></a> · <a href="/topics/cellular-senescence/">Senescence archive</a></p>
        </div>
      </li>
      <li class="framework-card">
        <span class="framework-num" aria-hidden="true">04</span>
        <div class="framework-body">
          <p class="framework-tag">Metabolic Resilience &amp; Mitochondria</p>
          <h3><a href="/spiral-of-cellular-light/#higher-flame">Higher Flame</a></h3>
          <p class="framework-desc">Mitochondrial respiration voltage, AMPK and NAD+ salvage pathways, and dual-fuel metabolic flexibility.</p>
          <p class="framework-links"><a href="/spiral-of-cellular-light/#higher-flame">Lens overview <span>→</span></a> · <a href="/topics/metabolic-health/">Metabolic archive</a></p>
        </div>
      </li>
      <li class="framework-card">
        <span class="framework-num" aria-hidden="true">05</span>
        <div class="framework-body">
          <p class="framework-tag">Cognitive &amp; Neural Coherence</p>
          <h3><a href="/spiral-of-cellular-light/#luminous-mind">Luminous Mind</a></h3>
          <p class="framework-desc">Slow-wave N3 glymphatic clearance, neuroplasticity, and BDNF-supported synaptic maintenance.</p>
          <p class="framework-links"><a href="/spiral-of-cellular-light/#luminous-mind">Lens overview <span>→</span></a> · <a href="/topics/brain-health/">Brain health archive</a></p>
        </div>
      </li>
      <li class="framework-card">
        <span class="framework-num" aria-hidden="true">06</span>
        <div class="framework-body">
          <p class="framework-tag">Mineral Balance &amp; Bio-Clearing</p>
          <h3><a href="/spiral-of-cellular-light/#dark-mirror">Dark Mirror</a></h3>
          <p class="framework-desc">Intracellular trace mineral equilibrium, membrane potential, and deep tissue bio-clearing pathways.</p>
          <p class="framework-links"><a href="/spiral-of-cellular-light/#dark-mirror">Lens overview <span>→</span></a> · <a href="/topics/detoxification/">Detoxification archive</a></p>
        </div>
      </li>
    </ol>
  </section>

  {/* 5. Subscribe */}
  <section id="subscribe" class="subscribe-card">
    <div class="subscribe-heading">
      <img src="/logo-mark.svg" width="72" height="72" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="subscribe-title-wrap">
        <h2>Your morning<br />intelligence brief.</h2>
        <p class="subscribe-lead-note">One daily edition: a deep read, two concise signals, and six biophysics field guides to explore.</p>
      </div>
    </div>
    <div class="subscribe-form-container">
      <form id="loops-subscribe-form" class="subscribe-form">
        <div class="subscribe-input-group">
          <input
            type="email"
            id="subscribe-email-input"
            name="email"
            placeholder="Enter your email address..."
            required
            class="subscribe-input"
            aria-label="Email address"
          />
          <button type="submit" id="subscribe-submit-btn" class="subscribe-btn">
            Get Daily Briefs + 6 Guides <span aria-hidden="true">→</span>
          </button>
        </div>
        <p class="subscribe-privacy">Zero spam. Pure biophysics intelligence. Unsubscribe anytime.</p>
      </form>

      <div id="subscribe-success-box" class="subscribe-success is-hidden">
        <h3>One step left — confirm on Substack.</h3>
        <p id="subscribe-handoff-lead">
          We opened Substack in a new tab; your subscription is live once you confirm there.
        </p>
        <p>
          <a
            id="subscribe-handoff-link"
            href="https://agewellbrief.substack.com/subscribe"
            target="_blank"
            rel="noopener"
            class="magnet-link"
            >→ Confirm your subscription on Substack</a
          >
        </p>
        <p>All 6 Biophysics Field Guides (PDF) are yours to download right now:</p>
        <div class="lead-magnet-grid">
          <a href="/downloads/field-guides/living-waters-field-guide.pdf" download class="magnet-link">01 Living Waters <em>(Fluid &amp; Transport)</em></a>
          <a href="/downloads/field-guides/inner-garden-field-guide.pdf" download class="magnet-link">02 Inner Garden <em>(Gut Ecology)</em></a>
          <a href="/downloads/field-guides/cell-shedding-field-guide.pdf" download class="magnet-link">03 Cell Shedding <em>(Senescence &amp; Renewal)</em></a>
          <a href="/downloads/field-guides/higher-flame-field-guide.pdf" download class="magnet-link">04 Higher Flame <em>(Metabolism &amp; Respiration)</em></a>
          <a href="/downloads/field-guides/luminous-mind-field-guide.pdf" download class="magnet-link">05 Luminous Mind <em>(Cognition &amp; Neural Coherence)</em></a>
          <a href="/downloads/field-guides/dark-mirror-field-guide.pdf" download class="magnet-link">06 Dark Mirror <em>(Mineral &amp; Bio-clearing)</em></a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById("loops-subscribe-form") as HTMLFormElement;
    const emailInput = document.getElementById("subscribe-email-input") as HTMLInputElement;
    const submitBtn = document.getElementById("subscribe-submit-btn") as HTMLButtonElement;
    const successBox = document.getElementById("subscribe-success-box");

    // Subscription is completed on Substack, which owns the list. Handing off
    // rather than posting in the background keeps the confirmation honest:
    // the reader only ever sees "subscribed" from Substack itself.
    function handOffToSubstack(email: string) {
      const handoff =
        "https://agewellbrief.substack.com/subscribe?email=" + encodeURIComponent(email);
      const opened = window.open(handoff, "_blank", "noopener");

      // If the popup was blocked there is no Substack tab, so the copy must not
      // claim one opened. Point the reader at a link they can actually click.
      const link = document.getElementById("subscribe-handoff-link") as HTMLAnchorElement;
      const lead = document.getElementById("subscribe-handoff-lead");
      if (link) link.href = handoff;
      if (lead && !opened) {
        lead.textContent =
          "Your browser blocked the new tab. Finish subscribing here — it takes one click:";
      }

      // This reader has just given an email, and the success box hands them all
      // six guides. Record it before revealing the box, or the field-guide gate
      // will stop them on the very links they were just promised.
      try {
        localStorage.setItem("agewell:guide-email-given", "1");
      } catch {
        /* blocked storage: the gate defaults to open, so the links still work */
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = opened ? "Opened in a new tab →" : "Finish on Substack →";
      }
      if (form) form.style.display = "none";
      if (successBox) successBox.classList.remove("is-hidden");
    }

    if (form && emailInput && submitBtn && successBox) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        if (!email) return;
        handOffToSubstack(email);
      });
    }

  </script>
</Layout>

<style>
  .subscribe-card {
    border-top: 1px solid var(--ink);
    background: color-mix(in oklch, var(--mist) 45%, var(--paper));
    color: var(--ink);
  }
  .subscribe-lead-note {
    font-family: var(--serif);
    font-size: 1.12rem;
    color: var(--ink-soft);
    margin-top: 12px;
    line-height: 1.55;
    max-width: 46ch;
  }
  .subscribe-form-container {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .subscribe-input-group {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 10px;
  }
  .subscribe-input {
    flex: 1;
    min-width: 240px;
    padding: 13px 16px;
    font-family: var(--sans);
    font-size: 0.92rem;
    border: 1px solid var(--ink);
    border-radius: 2px;
    background: var(--paper);
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s ease;
  }
  .subscribe-input::placeholder {
    color: var(--muted);
  }
  .subscribe-input:focus {
    border-color: var(--saffron-ink);
  }
  .subscribe-btn {
    padding: 13px 22px;
    font-family: var(--sans);
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    border-radius: 2px;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .subscribe-btn:hover {
    background: var(--saffron-ink);
    border-color: var(--saffron-ink);
  }
  .subscribe-privacy {
    font-size: 0.76rem;
    color: var(--muted);
    margin: 4px 0 0;
  }
  .subscribe-success.is-hidden {
    display: none;
  }
  .subscribe-success {
    background: var(--paper);
    border-top: 2px solid var(--saffron);
    border-bottom: 1px solid var(--line);
    padding: 24px 0;
    margin-top: 16px;
    color: var(--ink);
  }
  .subscribe-success h3 {
    margin: 0 0 6px;
    color: var(--ink);
    font-size: 1.4rem;
  }
  .subscribe-success p {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .lead-magnet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 10px 18px;
    margin-top: 16px;
  }
  .magnet-link {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    transition: color 0.2s ease, border-color 0.2s ease;
    display: block;
  }
  .magnet-link em {
    font-style: normal;
    color: var(--muted);
    font-weight: 400;
  }
  .magnet-link:hover {
    color: var(--saffron-ink);
    border-color: var(--saffron-ink);
  }

  .archive-view-all {
    margin: 28px 0 0;
  }
  .archive-view-all a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 4px 0;
    border-bottom: 1.5px solid var(--saffron);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.84rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .archive-view-all a span {
    color: var(--saffron-ink);
  }
  .archive-view-all a:hover {
    color: var(--saffron-ink);
  }
  /* 4. Spiral of Cellular Light — Minimal Typographic Index */
  .frameworks-guide-section {
    max-width: 1320px;
    margin: 0 auto;
    padding: 72px 4vw 84px;
    border-top: 1px solid var(--line);
  }
  .frameworks-guide-section .section-caption a {
    color: var(--ink);
    font-family: var(--sans);
    font-style: normal;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }
  .frameworks-guide-section .section-caption a span {
    color: var(--saffron-ink);
    padding-left: 6px;
  }
  .frameworks-guide-section .section-caption a:hover {
    color: var(--saffron-ink);
  }
  .frameworks-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 clamp(28px, 4vw, 56px);
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  .framework-card {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    column-gap: 14px;
    align-items: start;
    padding: 26px 0 28px;
    border-top: 1px solid var(--line);
  }
  .framework-num {
    font-family: var(--serif);
    font-size: 1.35rem;
    line-height: 1.1;
    color: var(--saffron-ink);
  }
  .framework-body {
    min-width: 0;
  }
  .framework-tag {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 6px;
  }
  .framework-card h3 {
    margin: 0 0 8px;
    font-size: 1.45rem;
    line-height: 1.12;
  }
  .framework-card h3 a {
    text-decoration: none;
  }
  .framework-card h3 a:hover {
    color: var(--saffron-ink);
  }
  .framework-desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0 0 12px;
  }
  .framework-links {
    margin: 0;
    font-size: 0.76rem;
    color: var(--muted);
  }
  .framework-links a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .framework-links a span {
    color: var(--saffron-ink);
    padding-left: 3px;
  }
  .framework-links a:hover {
    color: var(--saffron-ink);
  }
  @media (max-width: 960px) {
    .frameworks-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .frameworks-guide-section { padding: 48px 6vw 64px; }
    .frameworks-grid { grid-template-columns: 1fr; }
  }
</style>
