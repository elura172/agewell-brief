---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import EditorialImage from "../components/EditorialImage.astro";
import trendingData from "../data/trending.json";
import { linkRel, typographic } from "../lib/publishing";

const showDrafts = import.meta.env.DEV;
const entries = (await getCollection("briefs"))
  .filter((entry) => showDrafts || !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.edition_rank - b.data.edition_rank);
const featured = entries.find((entry) => entry.data.content_type === "lead") ?? entries[0];
const featuredEdition = featured?.data.edition_id;
const recent = entries
  .filter((entry) => entry.id !== featured?.id && (!featuredEdition || entry.data.edition_id === featuredEdition))
  .slice(0, 2);
const latestIds = new Set([featured?.id, ...recent.map((entry) => entry.id)]);
const earlier = entries.filter((entry) => !latestIds.has(entry.id));
const formatDate = (date: Date) => date.toLocaleDateString("en-CA", { month: "long", day: "numeric", year: "numeric" });
const editionDate = featured ? formatDate(featured.data.date) : formatDate(new Date());
const trending = (trendingData.articles ?? [])
  .map((item) => ({ item, entry: entries.find((entry) => entry.id === item.slug) }))
  .filter((row) => Boolean(row.entry && row.item.visits > 0));
---
<Layout>
  {showDrafts && <div class="edition-strip" aria-label="Preview status"><span>LOCAL DRAFT PREVIEW</span><span>NOT PUBLIC</span></div>}
  
  {/* 1. Explicit Brand Hero Banner */}
  <header class="brand-hero" aria-labelledby="hero-title">
    <div class="hero-inner">
      <p class="hero-eyebrow">Source-Led Biophysics & Functional Longevity Intelligence</p>
      <h1 id="hero-title">Health reporting built <em>for human vitality.</em></h1>
      <p class="hero-lede">
        Three source-linked briefs a day, translated from cutting-edge bioRxiv and PubMed research — cellular renewal, biophotonic biology, and functional longevity, with zero medical condescension.
      </p>

      {/* Lightweight Top Email Capture Bar */}
      <form id="hero-subscribe-form" class="top-subscribe-bar">
        <span class="bar-pill">📩 Daily Briefs + 6 PDF Field Guides</span>
        <input
          type="email"
          id="hero-email-input"
          name="email"
          placeholder="Enter your email address..."
          required
          class="hero-email-input"
          aria-label="Email address"
        />
        <button type="submit" id="hero-submit-btn" class="hero-join-btn">Subscribe Free <span aria-hidden="true">→</span></button>
      </form>

      <p class="hero-desk-note">Written by the <a href="/about/#editorial-desk">Agewell Brief editorial desk</a> — systematic source monitoring, human review before every brief publishes.</p>
    </div>
  </header>

  {/* 2. Today's Edition */}
  <section id="latest" class="edition-hero" aria-labelledby="edition-heading">
    <div class="edition-mast">
      <span><span class="live-dot" aria-hidden="true"></span> Today’s edition · {editionDate}</span>
      <span>One deep read · Two signals · Original sources</span>
      <span>⏱ About 8 min read</span>
    </div>
    {featured ? (
      <article class:list={["lead-story", { "has-image": featured.data.image }]}>
        <div class="lead-story-copy">
          <div class="lead-kicker"><span>Today’s deep read</span><span>{featured.data.category}</span></div>
          <h2 id="edition-heading"><a href={`/brief/${featured.id}/`}>{typographic(featured.data.title)}</a></h2>
          <p class="lead-dek">Cutting-edge research translated into actionable intelligence: what was discovered, why it matters for cellular & functional health, and where the science is heading.</p>
          <div class="lead-actions">
            <a class="primary-link" href={`/brief/${featured.id}/`}>Read the full analysis <span>→</span></a>
            <p>Original reporting: <a href={featured.data.source_url} rel={linkRel(featured.data.source_url)}>{featured.data.source_name}</a></p>
          </div>
        </div>
        {featured.data.image && <EditorialImage
          src={featured.data.image}
          alt={featured.data.image_alt ?? "Illustrative photograph for this Agewell Brief article"}
          photographer={featured.data.image_photographer}
          photographerUrl={featured.data.image_photographer_url}
          sourceUrl={featured.data.image_source_url}
          provider={featured.data.image_provider}
          width={featured.data.image_width}
          height={featured.data.image_height}
          avgColor={featured.data.image_avg_color}
          variant="featured"
          eager={true}
        />}
        <div class="lead-index" aria-hidden="true">01</div>
      </article>
    ) : (
      <div class="empty-state"><h2>The first signal is on its way.</h2><p>Fresh briefs appear here after editorial review.</p></div>
    )}

    {recent.length > 0 && <div class="quick-signals">
      <div class="quick-signals-heading">
        <h2>Two more signals</h2>
        <p>Useful in under two minutes each.</p>
      </div>
      <div class="quick-signals-layout">
        {recent.map((entry, index) => (
          <article class:list={["quick-story", index === 0 ? "quick-story--wide" : "quick-story--compact"]}>
            {entry.data.image && <EditorialImage
              src={entry.data.image}
              alt={entry.data.image_alt ?? "Illustrative photograph for this Agewell Brief signal"}
              photographer={entry.data.image_photographer}
              photographerUrl={entry.data.image_photographer_url}
              sourceUrl={entry.data.image_source_url}
              provider={entry.data.image_provider}
              width={entry.data.image_width}
              height={entry.data.image_height}
              avgColor={entry.data.image_avg_color}
              variant="card"
            />}
            <div class="quick-story-copy">
              <div class="story-topline">
                <span>{entry.data.category}</span>
                <span class={`evidence-badge evidence-badge--${entry.data.evidence_position}`}>{entry.data.evidence_position}</span>
                <span>{String(index + 2).padStart(2, "0")}</span>
              </div>
              <h3><a href={`/brief/${entry.id}/`}>{typographic(entry.data.title)}</a></h3>
              <div class="story-foot"><span>{formatDate(entry.data.date)}</span><a href={`/brief/${entry.id}/`}>Read signal <span>→</span></a></div>
            </div>
          </article>
        ))}
      </div>
    </div>}
  </section>

  {/* 3. Trending This Week (Social Proof) */}
  {trending.length > 0 && <section class="trending-section" aria-labelledby="trending-heading">
    <div class="trending-heading">
      <div>
        <p class="eyebrow">Reader signal</p>
        <h2 id="trending-heading">{trendingData.window_days === 1 ? "Trending today" : "Trending this week"}</h2>
      </div>
      <p>
        {trendingData.window_days === 1
          ? "Most visited briefs over the last 24 hours."
          : `Most visited briefs over the last ${trendingData.window_days} days.`}
      </p>
    </div>
    <ol class="trending-list">
      {trending.map(({ item, entry }, index) => <li>
        <span class="trending-index">{String(index + 1).padStart(2, "0")}</span>
        <a href={`/brief/${entry.id}/`}>{typographic(entry.data.title)}</a>
      </li>)}
    </ol>
  </section>}

  {/* 4. Our Biophysics Frameworks (Demystifying Jargon & Key Concepts) */}
  <section class="frameworks-guide-section" aria-labelledby="frameworks-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Proprietary Lens</p>
        <h2 id="frameworks-heading" class="section-title">Our Biophysics Frameworks</h2>
      </div>
      <p class="section-caption">Six foundational lenses translating cellular physics into everyday healthspan. Click a card to see related briefs, or walk the spiral to explore the framework.</p>
    </div>
    <div class="frameworks-grid">
      <article class="framework-card" data-framework-topic="longevity">
        <span class="framework-icon">🌊</span>
        <h3>Living Waters</h3>
        <p class="framework-tag">Fluid & Micro-Circulation</p>
        <p class="framework-desc">Interfacial exclusion zone (EZ) structured water (H₃O₂) and vascular transport kinetics.</p>
        <a href="/spiral-of-cellular-light/" class="framework-spiral-link" aria-label="Walk the Living Waters spiral">Walk this spiral <span aria-hidden="true">→</span></a>
      </article>
      <article class="framework-card" data-framework-topic="gut health">
        <span class="framework-icon">🌱</span>
        <h3>Inner Garden</h3>
        <p class="framework-tag">Gut Microbiome Ecology</p>
        <p class="framework-desc">Short-chain fatty acid signaling, gut barrier integrity, and microbial circadian rhythmicity.</p>
        <a href="/spiral-of-cellular-light/" class="framework-spiral-link" aria-label="Walk the Inner Garden spiral">Walk this spiral <span aria-hidden="true">→</span></a>
      </article>
      <article class="framework-card" data-framework-topic="cellular senescence">
        <span class="framework-icon">🍃</span>
        <h3>Cell Shedding</h3>
        <p class="framework-tag">Senescence & Cellular Renewal</p>
        <p class="framework-desc">Targeted senolytic clearing, autophagy activation, and SASP inflammatory reduction.</p>
        <a href="/spiral-of-cellular-light/" class="framework-spiral-link" aria-label="Walk the Cell Shedding spiral">Walk this spiral <span aria-hidden="true">→</span></a>
      </article>
      <article class="framework-card" data-framework-topic="metabolic health">
        <span class="framework-icon">🔥</span>
        <h3>Higher Flame</h3>
        <p class="framework-tag">Metabolic Resilience & Mitochondria</p>
        <p class="framework-desc">Mitochondrial respiration voltage, metabolic flexibility, and non-shivering thermogenesis.</p>
        <a href="/spiral-of-cellular-light/" class="framework-spiral-link" aria-label="Walk the Higher Flame spiral">Walk this spiral <span aria-hidden="true">→</span></a>
      </article>
      <article class="framework-card" data-framework-topic="brain health">
        <span class="framework-icon">⚡</span>
        <h3>Luminous Mind</h3>
        <p class="framework-tag">Cognitive & Neural Coherence</p>
        <p class="framework-desc">Glymphatic clearance during sleep, neuro-plasticity, and biophotonic brain entrainment.</p>
        <a href="/spiral-of-cellular-light/" class="framework-spiral-link" aria-label="Walk the Luminous Mind spiral">Walk this spiral <span aria-hidden="true">→</span></a>
      </article>
      <article class="framework-card" data-framework-topic="detoxification">
        <span class="framework-icon">🪞</span>
        <h3>Dark Mirror</h3>
        <p class="framework-tag">Mineral Balance & Bio-Clearing</p>
        <p class="framework-desc">Heavy metal chelation, systemic mineral ratios, and deep tissue clearing pathways.</p>
        <a href="/spiral-of-cellular-light/" class="framework-spiral-link" aria-label="Walk the Dark Mirror spiral">Walk this spiral <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  {/* 5. Recent archive — capped and linked to the full filterable archive
       rather than rendering all ~109 entries unpaginated. A homepage-scoped
       filter bar was removed on purpose: with only 15 items in the DOM here,
       pill counts drawn from the full archive would promise more results
       than this page could ever show — the same mismatch bug fixed above,
       just reintroduced a different way. */}
  {earlier.length > 0 && <section id="archive" class="archive-section" aria-labelledby="archive-heading">
    <div class="section-heading archive-heading">
      <div>
        <p class="eyebrow">Archive Index</p>
        <h2 id="archive-heading" class="section-title">Recent briefs</h2>
      </div>
      <p class="section-caption">The useful signals stay available.</p>
    </div>

    <ol class="archive-list" id="archive-list">
      {earlier.slice(0, 15).map((entry, index) => (
        <li class="archive-item">
          <article class="archive-entry">
            <div class="archive-index">{String(index + 4).padStart(2, "0")}</div>
            <div class="archive-copy">
              <p>
                <span>{entry.data.category}</span> · <span class={`evidence-badge evidence-badge--${entry.data.evidence_position}`}>{entry.data.evidence_position}</span> · <span>{formatDate(entry.data.date)}</span>
              </p>
              <h3><a href={`/brief/${entry.id}/`}>{typographic(entry.data.title)}</a></h3>
            </div>
            <a class="archive-source" href={entry.data.source_url} rel={linkRel(entry.data.source_url)}>Original source <span>↗</span></a>
          </article>
        </li>
      ))}
    </ol>

    <p class="archive-view-all"><a href="/archive/">View the full archive ({entries.length} briefs) <span aria-hidden="true">→</span></a></p>
  </section>}

  <script>
    const frameworkCards = document.querySelectorAll<HTMLElement>(".framework-card");

    frameworkCards.forEach((card) => {
      card.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest(".framework-spiral-link")) return;
        const topic = card.getAttribute("data-framework-topic");
        if (topic) {
          window.location.href = `/archive/?topic=${encodeURIComponent(topic)}`;
        }
      });
    });
  </script>

  {/* 6. Subscribe Card with Explicit Parenthetical Lead Magnet Labels */}
  <section id="subscribe" class="subscribe-card">
    <div class="subscribe-heading">
      <img src="/logo-mark.svg" width="72" height="72" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="subscribe-title-wrap">
        <h2>Your morning<br />intelligence brief.</h2>
        <p class="subscribe-lead-note">Subscribe for 3x daily scientific briefs & get instant access to all 6 Spiral Biophysics Field Guides (PDF).</p>
      </div>
    </div>
    <div class="subscribe-form-container">
      <form id="loops-subscribe-form" class="subscribe-form">
        <div class="subscribe-input-group">
          <input
            type="email"
            id="subscribe-email-input"
            name="email"
            placeholder="Enter your email address..."
            required
            class="subscribe-input"
            aria-label="Email address"
          />
          <button type="submit" id="subscribe-submit-btn" class="subscribe-btn">
            Get Daily Briefs + 6 Guides <span aria-hidden="true">→</span>
          </button>
        </div>
        <p class="subscribe-privacy">Zero spam. Pure biophysics intelligence. Unsubscribe anytime.</p>
      </form>

      <div id="subscribe-success-box" class="subscribe-success is-hidden">
        <span class="success-icon">✨</span>
        <h3>One step left — confirm on Substack.</h3>
        <p id="subscribe-handoff-lead">
          We opened Substack in a new tab; your subscription is live once you confirm there.
        </p>
        <p>
          <a
            id="subscribe-handoff-link"
            href="https://agewellbrief.substack.com/subscribe"
            target="_blank"
            rel="noopener"
            class="magnet-link"
            >→ Confirm your subscription on Substack</a
          >
        </p>
        <p>All 6 Biophysics Field Guides (PDF) are yours to download right now:</p>
        <div class="lead-magnet-grid">
          <a href="/downloads/field-guides/living-waters-field-guide.pdf" download class="magnet-link">🌊 Living Waters <em>(Fluid & Transport)</em></a>
          <a href="/downloads/field-guides/inner-garden-field-guide.pdf" download class="magnet-link">🌱 Inner Garden <em>(Gut Ecology)</em></a>
          <a href="/downloads/field-guides/cell-shedding-field-guide.pdf" download class="magnet-link">🍃 Cell Shedding <em>(Senescence & Renewal)</em></a>
          <a href="/downloads/field-guides/higher-flame-field-guide.pdf" download class="magnet-link">🔥 Higher Flame <em>(Metabolism & Respiration)</em></a>
          <a href="/downloads/field-guides/luminous-mind-field-guide.pdf" download class="magnet-link">⚡ Luminous Mind <em>(Cognition & Neural Coherence)</em></a>
          <a href="/downloads/field-guides/dark-mirror-field-guide.pdf" download class="magnet-link">🪞 Dark Mirror <em>(Mineral & Bio-clearing)</em></a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById("loops-subscribe-form") as HTMLFormElement;
    const emailInput = document.getElementById("subscribe-email-input") as HTMLInputElement;
    const submitBtn = document.getElementById("subscribe-submit-btn") as HTMLButtonElement;
    const successBox = document.getElementById("subscribe-success-box");

    // Subscription is completed on Substack, which owns the list. Handing off
    // rather than posting in the background keeps the confirmation honest:
    // the reader only ever sees "subscribed" from Substack itself.
    function handOffToSubstack(email: string) {
      const handoff =
        "https://agewellbrief.substack.com/subscribe?email=" + encodeURIComponent(email);
      const opened = window.open(handoff, "_blank", "noopener");

      // If the popup was blocked there is no Substack tab, so the copy must not
      // claim one opened. Point the reader at a link they can actually click.
      const link = document.getElementById("subscribe-handoff-link") as HTMLAnchorElement;
      const lead = document.getElementById("subscribe-handoff-lead");
      if (link) link.href = handoff;
      if (lead && !opened) {
        lead.textContent =
          "Your browser blocked the new tab. Finish subscribing here — it takes one click:";
      }

      // This reader has just given an email, and the success box hands them all
      // six guides. Record it before revealing the box, or the field-guide gate
      // will stop them on the very links they were just promised.
      try {
        localStorage.setItem("agewell:guide-email-given", "1");
      } catch {
        /* blocked storage: the gate defaults to open, so the links still work */
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = opened ? "Opened in a new tab →" : "Finish on Substack →";
      }
      if (form) form.style.display = "none";
      if (successBox) successBox.classList.remove("is-hidden");
    }

    if (form && emailInput && submitBtn && successBox) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        if (!email) return;
        handOffToSubstack(email);
      });
    }

    // Hero bar: same handoff, but the reader hasn't scrolled to #subscribe yet,
    // so bring the success box (and the six guide links it reveals) into view.
    const heroForm = document.getElementById("hero-subscribe-form") as HTMLFormElement;
    const heroEmailInput = document.getElementById("hero-email-input") as HTMLInputElement;
    const heroSubmitBtn = document.getElementById("hero-submit-btn") as HTMLButtonElement;

    if (heroForm && heroEmailInput) {
      heroForm.addEventListener("submit", (e) => {
        e.preventDefault();
        const email = heroEmailInput.value.trim();
        if (!email) return;
        if (emailInput) emailInput.value = email;
        handOffToSubstack(email);
        if (heroSubmitBtn) {
          heroSubmitBtn.disabled = true;
          heroSubmitBtn.textContent = "Opened below ↓";
        }
        successBox?.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    }
  </script>
</Layout>

<style>
  .subscribe-card {
    border-top: 1px solid rgba(245, 158, 11, 0.2);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .subscribe-lead-note {
    font-size: 1.05rem;
    color: rgba(247, 245, 240, 0.88);
    margin-top: 14px;
    line-height: 1.55;
    max-width: 480px;
  }
  .subscribe-form-container {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .subscribe-input-group {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 12px;
  }
  .subscribe-input {
    flex: 1;
    min-width: 260px;
    padding: 14px 20px;
    font-family: var(--sans);
    font-size: 0.95rem;
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .subscribe-input::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }
  .subscribe-input:focus {
    border-color: var(--saffron);
    box-shadow: 0 0 16px rgba(245, 158, 11, 0.25);
  }
  .subscribe-btn {
    padding: 14px 28px;
    font-family: var(--sans);
    font-size: 0.92rem;
    font-weight: 700;
    background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
    color: #ffffff;
    border: none;
    border-radius: 28px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(217, 119, 6, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .subscribe-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(217, 119, 6, 0.5);
  }
  .subscribe-privacy {
    font-size: 0.78rem;
    color: rgba(247, 245, 240, 0.6);
    margin: 4px 0 0;
  }
  .subscribe-success.is-hidden {
    display: none;
  }
  .subscribe-success {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 16px;
    padding: 28px;
    margin-top: 20px;
    color: #ffffff;
  }
  .subscribe-success h3 {
    margin: 8px 0 6px;
    color: #ffffff;
    font-size: 1.4rem;
  }
  .subscribe-success p {
    color: rgba(247, 245, 240, 0.85);
    font-size: 0.92rem;
  }
  .lead-magnet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
    margin-top: 18px;
  }
  .magnet-link {
    font-size: 0.84rem;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    padding: 10px 16px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    transition: all 0.2s ease;
    display: block;
  }
  .magnet-link em {
    font-style: normal;
    color: var(--saffron);
    font-weight: 400;
  }
  .magnet-link:hover {
    border-color: var(--saffron);
    background: rgba(245, 158, 11, 0.15);
    transform: translateY(-1px);
  }

  /* 1. Explicit Brand Hero Banner */
  .brand-hero {
    padding: 60px 5vw 40px;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, var(--paper) 0%, var(--cream) 100%);
  }
  .hero-inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .hero-eyebrow {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--saffron-ink);
    margin-bottom: 12px;
  }
  .hero-inner h1 {
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    line-height: 1.05;
    margin: 0 0 16px;
    letter-spacing: -0.03em;
  }
  .hero-inner h1 em {
    font-weight: 400;
    color: var(--muted);
  }
  .hero-lede {
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    line-height: 1.45;
    color: var(--ink);
    max-width: 780px;
    margin: 0 0 24px;
  }
  .hero-desk-note {
    margin: 16px 0 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .hero-desk-note a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .archive-view-all {
    margin: 32px 0 0;
    text-align: center;
  }
  .archive-view-all a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 22px;
    border: 1px solid var(--line);
    border-radius: 30px;
    color: var(--ink);
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .archive-view-all a:hover {
    border-color: var(--saffron-ink);
    color: var(--saffron-ink);
  }
  .top-subscribe-bar {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding: 10px 20px;
