---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import EditorialImage from "../components/EditorialImage.astro";

const showDrafts = import.meta.env.DEV;
const entries = (await getCollection("briefs"))
  .filter((entry) => showDrafts || !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.edition_rank - b.data.edition_rank);
const featured = entries.find((entry) => entry.data.content_type === "lead") ?? entries[0];
const featuredEdition = featured?.data.edition_id;
const recent = entries
  .filter((entry) => entry.id !== featured?.id && (!featuredEdition || entry.data.edition_id === featuredEdition))
  .slice(0, 2);
const formatDate = (date: Date) => date.toLocaleDateString("en-CA", { month: "long", day: "numeric", year: "numeric" });
---
<Layout>
  {showDrafts && <div class="edition-strip" aria-label="Preview status"><span>LOCAL DRAFT PREVIEW</span><span>NOT PUBLIC</span></div>}
  <section class="hero">
    <div class="hero-copy">
      <h1>Stay capable.<br /><span>Stay curious.</span></h1>
      <p class="hero-lede">A clear-eyed brief on the research, habits, and decisions that help you keep doing what matters.</p>
      <a class="text-link" href="#latest">Read today’s signal <span>↓</span></a>
    </div>
    <div class="hero-note" aria-label="Editorial promise">
      <span class="note-label">OUR PROMISE</span>
      <p>Plain language.<br />Original sources.<br />Clear takeaways.</p>
      <span class="note-rule"></span>
      <small>Made for people<br />who still have plans.</small>
    </div>
  </section>

  <section class="edition-strip" aria-label="Edition information">
    <span>TODAY’S EDITION</span><span>1 DEEP READ · 2 SIGNALS</span><span>READ IN 8 MINUTES</span>
  </section>

  <section id="latest" class="briefs-section">
    <div class="section-heading">
      <h2 class="section-title">Latest signals</h2>
      <p class="section-caption">Worth your attention, not all of it.</p>
    </div>
    {featured ? (
      <article class:list={["featured-card", { "has-image": featured.data.image }]}>
        <div class="signal-rail"><span>{featured.data.category}</span><i></i><span>{formatDate(featured.data.date)}</span></div>
        <div class="featured-body">
          <h2><a href={`/brief/${featured.id}/`}>{featured.data.title}</a></h2>
          <p class="card-source">Based on <a href={featured.data.source_url} rel="noopener noreferrer">{featured.data.source_title}</a></p>
          <a class="arrow-link" href={`/brief/${featured.id}/`}>{featured.data.content_type === "lead" ? "Read the full analysis" : "Read the brief"} <span>→</span></a>
        </div>
        {featured.data.image && <EditorialImage
          src={featured.data.image}
          alt={featured.data.image_alt ?? "Illustrative photograph for this Agewell Brief article"}
          photographer={featured.data.image_photographer}
          photographerUrl={featured.data.image_photographer_url}
          sourceUrl={featured.data.image_source_url}
          provider={featured.data.image_provider}
          width={featured.data.image_width}
          height={featured.data.image_height}
          avgColor={featured.data.image_avg_color}
          variant="featured"
          eager={true}
        />}
        <div class="featured-index">01</div>
      </article>
    ) : (
      <div class="empty-state"><h2>The first signal is on its way.</h2><p>Fresh briefs appear here after editorial review.</p></div>
    )}

    {recent.length > 0 && <div class="brief-grid">
      {recent.map((entry, index) => (
        <article class:list={["brief-card", { "has-image": entry.data.image }]}>
          {entry.data.image && <EditorialImage
            src={entry.data.image}
            alt={entry.data.image_alt ?? "Illustrative photograph for this Agewell Brief signal"}
            photographer={entry.data.image_photographer}
            photographerUrl={entry.data.image_photographer_url}
            sourceUrl={entry.data.image_source_url}
            provider={entry.data.image_provider}
            width={entry.data.image_width}
            height={entry.data.image_height}
            avgColor={entry.data.image_avg_color}
            variant="card"
          />}
          <div class="card-topline"><span>{entry.data.category} · Quick signal</span><span>{String(index + 2).padStart(2, "0")}</span></div>
          <h3><a href={`/brief/${entry.id}/`}>{entry.data.title}</a></h3>
          <p class="card-source">{formatDate(entry.data.date)} · <a href={entry.data.source_url} rel="noopener noreferrer">Source</a></p>
        </article>
      ))}
    </div>}
  </section>

  <section id="about" class="about-band">
    <div><h2>The internet is loud.<br /><em>Your health brief shouldn’t be.</em></h2></div>
    <p>We translate useful research into decisions you can understand and questions you can take to your doctor. Every brief points back to its source and leaves room for context.</p>
  </section>

  <section id="subscribe" class="subscribe-card">
    <div><h2>One good signal,<br />in your inbox.</h2></div>
    <div class="subscribe-status">
      <p>The email edition is opening soon. Until then, follow every published brief in your feed reader.</p>
      <a href="/rss.xml">Follow the RSS edition <span>→</span></a>
    </div>
  </section>
</Layout>
