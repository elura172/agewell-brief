---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { publishedBriefs, topicSlug } from "../lib/publishing";
import { frontierStatusLabels, frontierTerritories } from "../data/frontier-map";

import lineageData from "../../config/biophysics-lineage.json";

const briefs = publishedBriefs(await getCollection("briefs"));
const countFor = (category: string) =>
  briefs.filter((entry) => {
    const cat = entry.data.category.toLowerCase();
    const topics = (entry.data.topics || []).map((t) => t.toLowerCase());
    return cat === category || topics.includes(category);
  }).length;
const pioneers = lineageData.pioneers || [];
---
<Layout
  title="The frontier map — Agewell Brief"
  description="A living map of functional, regenerative, quantum, and vibrational health research."
>
  <div class="frontier-page">
    <a class="back-link" href="/">← Today’s edition</a>
    <header class="frontier-header">
      <p class="eyebrow">The Living Frontier Map</p>
      <h1>The bio-energetic edge of human health.</h1>
      <p class="frontier-lede">A living field guide connecting modern biophysics, quantum biology, and cellular renewal with real-world functional longevity.</p>
    </header>

    <section class="frontier-intro" aria-labelledby="frontier-intro-heading">
      <div>
        <p class="eyebrow">Our lens</p>
        <h2 id="frontier-intro-heading">Pioneering insights. Rigorous physics. Practical vitality.</h2>
      </div>
      <div>
        <p>The human body is far more than a static chemical machine; it is an electromagnetic, biophotonic, and cellular ecosystem. We bridge early biophysics discoveries—from biophotons to structured cellular water—with today’s peer-reviewed clinical data and arXiv preprints.</p>
        <p class="frontier-takeaway"><strong>Core principles:</strong> Cellular coherence drives healthspan, biological signals precede symptoms, and practical wisdom belongs in your hands.</p>
      </div>
    </section>

    <section class="frontier-territories" aria-labelledby="territories-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Four Research Domains</p>
          <h2 id="territories-heading" class="section-title">The territories</h2>
        </div>
        <p class="section-caption">{briefs.length} published briefs across the map</p>
      </div>

      <div class="topic-filter-bar" role="group" aria-label="Filter territories by evidence position">
        <button type="button" class="filter-pill is-active" data-status="all" aria-pressed="true">All positions</button>
        <button type="button" class="filter-pill" data-status="established" aria-pressed="false">Established</button>
        <button type="button" class="filter-pill" data-status="emerging" aria-pressed="false">Emerging</button>
        <button type="button" class="filter-pill" data-status="contested" aria-pressed="false">Contested &amp; frontier</button>
      </div>

      <ol class="frontier-index-list">
        {frontierTerritories.map((territory, index) => (
          <li id={territory.slug} class="frontier-entry" data-status={territory.status}>
            <span class="frontier-num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div class="frontier-entry-body">
              <p class="frontier-status-tag">
                <span class={`frontier-status frontier-status--${territory.status}`}>{frontierStatusLabels[territory.status]}</span>
              </p>
              <h3>{territory.name}</h3>
              <p class="frontier-desc">{territory.description}</p>
              <p class="frontier-question">{territory.question}</p>
              <p class="frontier-topics">
                {territory.categories.map((category, idx) => (
                  <>
                    {idx > 0 && <span class="frontier-sep" aria-hidden="true">·</span>}
                    <a href={`/topics/${topicSlug(category)}/`}>{category} <small>({countFor(category)})</small></a>
                  </>
                ))}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="pioneer-lineage-section" aria-labelledby="lineage-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Historical Antecedents</p>
          <h2 id="lineage-heading" class="section-title">Biophysics lineage &amp; founders</h2>
        </div>
        <p class="section-caption">{pioneers.length} foundational pioneers anchoring our framework</p>
      </div>

      <ol class="pioneer-ledger">
        {pioneers.map((p) => (
          <li class="pioneer-entry">
            <div class="pioneer-meta">
              <span class="pioneer-year">{p.year}</span>
              <h3>{p.name}</h3>
              <p class="pioneer-work"><em>{p.core_work}</em></p>
            </div>
            <div class="pioneer-body">
              <p class="pioneer-summary">{p.summary}</p>
              <p class="pioneer-application"><strong>Practical legacy:</strong> {p.application}</p>
              <p class="pioneer-concepts">{p.concepts.join(" · ")}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="frontier-method" aria-labelledby="method-heading">
      <div class="frontier-method-grid">
        <div>
          <p class="eyebrow">Editorial Discipline</p>
          <h2 id="method-heading">High signal. Direct sources. Zero dogma.</h2>
        </div>
        <div>
          <p>We trace emerging preprints, peer-reviewed clinical trials, and biophysical frameworks directly to their original sources—distilling complex science into clear questions you can evaluate on the evidence.</p>
          <a class="primary-link" href="/editorial-policy/">Read the editorial policy <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </div>

  <script>
    const filterPills = document.querySelectorAll<HTMLButtonElement>(".frontier-territories .filter-pill");
    const territoryCards = document.querySelectorAll<HTMLElement>(".frontier-entry");

    filterPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const status = pill.getAttribute("data-status");

        filterPills.forEach((p) => {
          p.classList.remove("is-active");
          p.setAttribute("aria-pressed", "false");
        });
        pill.classList.add("is-active");
        pill.setAttribute("aria-pressed", "true");

        territoryCards.forEach((card) => {
          const cardStatus = card.getAttribute("data-status");
          if (
            status === "all" ||
            cardStatus === status ||
            (status === "contested" && (cardStatus === "contested" || cardStatus === "speculative"))
          ) {
            card.style.display = "";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  </script>
</Layout>

<style>
  .frontier-index-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(32px, 5vw, 72px);
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  .frontier-entry {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 16px;
    padding: 36px 0 40px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 32px;
  }
  .frontier-num {
    color: var(--saffron-ink);
    font-family: var(--serif);
    font-size: 1.55rem;
    line-height: 1.05;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .frontier-status-tag {
    margin: 0 0 8px;
  }
  .frontier-entry-body h3 {
    margin: 0 0 10px;
    font-size: clamp(1.65rem, 2.5vw, 2.2rem);
    line-height: 1.08;
  }
  .frontier-desc {
    margin: 0 0 12px;
    max-width: 52ch;
    color: var(--ink-soft);
    font-family: var(--serif);
    font-size: 1.06rem;
    line-height: 1.56;
  }
  .frontier-question {
    margin: 0 0 18px;
    max-width: 52ch;
    color: var(--saffron-ink);
    font-family: var(--serif);
    font-size: 1.06rem;
    font-style: italic;
    line-height: 1.45;
  }
  .frontier-topics {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    margin: 0;
    font-size: 0.78rem;
  }
  .frontier-topics a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    text-transform: capitalize;
  }
  .frontier-topics a:hover {
    color: var(--saffron-ink);
    text-decoration: underline;
    text-decoration-color: var(--saffron);
  }
  .frontier-topics small {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 400;
  }
  .frontier-sep {
    color: var(--line);
  }

  .pioneer-lineage-section {
    margin-top: 84px;
    padding-top: 44px;
    border-top: 1.5px solid var(--ink);
    box-shadow: inset 0 3px 0 var(--paper), inset 0 4px 0 var(--line-strong);
  }
  .pioneer-ledger {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(32px, 5vw, 72px);
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .pioneer-entry {
    padding: 28px 0 30px;
    border-bottom: 1px solid var(--line);
  }
  .pioneer-year {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--saffron-ink);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums lining-nums;
    margin-bottom: 4px;
  }
  .pioneer-meta h3 {
    margin: 0 0 4px;
    font-size: 1.45rem;
    line-height: 1.12;
  }
  .pioneer-work {
    font-family: var(--serif);
    font-size: 0.98rem;
    color: var(--muted);
    margin: 0 0 12px;
  }
  .pioneer-summary {
    font-family: var(--serif);
    font-size: 1rem;
    color: var(--ink-soft);
    line-height: 1.55;
    margin: 0 0 10px;
  }
  .pioneer-application {
    font-size: 0.84rem;
    color: var(--ink-soft);
    line-height: 1.5;
    margin: 0 0 8px;
  }
  .pioneer-concepts {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .frontier-method {
    margin-top: 84px;
    padding-top: 44px;
    border-top: 1px solid var(--ink);
  }
  .frontier-method-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 6vw;
    align-items: start;
  }
  .frontier-method h2 {
    margin: 8px 0 0;
    font-size: clamp(1.9rem, 3.4vw, 2.75rem);
    line-height: 1.08;
  }
  .frontier-method-grid > div:last-child p {
    margin: 0 0 18px;
    max-width: 56ch;
    color: var(--ink-soft);
    font-family: var(--serif);
    font-size: 1.12rem;
    line-height: 1.6;
  }

  @media (max-width: 820px) {
    .frontier-index-list,
    .pioneer-ledger,
    .frontier-method-grid {
      grid-template-columns: 1fr;
    }
    .frontier-method-grid {
      gap: 20px;
    }
  }
</style>
