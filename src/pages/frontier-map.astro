---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import QuantumLuminanceCanvas from "../components/QuantumLuminanceCanvas.astro";
import { publishedBriefs, topicSlug } from "../lib/publishing";
import { frontierStatusLabels, frontierTerritories } from "../data/frontier-map";

import lineageData from "../../config/biophysics-lineage.json";

const briefs = publishedBriefs(await getCollection("briefs"));
const countFor = (category: string) => briefs.filter((entry) => {
  const cat = entry.data.category.toLowerCase();
  const topics = (entry.data.topics || []).map((t) => t.toLowerCase());
  return cat === category || topics.includes(category);
}).length;
const pioneers = lineageData.pioneers || [];
---
<Layout
  title="The frontier map — Agewell Brief"
  description="A living map of functional, regenerative, quantum, and vibrational health research."
>
  <main class="frontier-page">
    <a class="back-link" href="/">← Today’s edition</a>
    <header class="frontier-header">
      <QuantumLuminanceCanvas height={320} />
      <p class="eyebrow">The Living Frontier Map</p>
      <h1>The bio-energetic edge of human health.</h1>
      <p class="frontier-lede">A living field guide connecting modern biophysics, quantum biology, and cellular renewal with real-world functional longevity.</p>
    </header>

    <section class="frontier-intro" aria-labelledby="frontier-intro-heading">
      <div>
        <p class="eyebrow">Our lens</p>
        <h2 id="frontier-intro-heading">Pioneering insights. Rigorous physics. Practical vitality.</h2>
      </div>
      <div>
        <p>The human body is far more than a static chemical machine; it is an electro-magnetic, biophotonic, and cellular ecosystem. We bridge early biophysics discoveries (from biophotons to structured cellular water) with today’s cutting-edge arXiv preprints and clinical data.</p>
        <p class="frontier-takeaway"><strong>Core Principles:</strong> Cellular coherence drives healthspan, biological signals precede symptoms, and practical wisdom belongs in your hands.</p>
      </div>
    </section>

    <section class="frontier-territories" aria-labelledby="territories-heading">
      <div class="section-heading">
        <h2 id="territories-heading" class="section-title">The territories</h2>
        <p class="section-caption">{briefs.length} published briefs in the map</p>
      </div>

      <div class="frontier-filter-bar">
        <span class="filter-label">Filter by Evidence Position:</span>
        <div class="filter-pills">
          <button class="frontier-pill is-active" data-status="all">All Positions</button>
          <button class="frontier-pill" data-status="established">Established</button>
          <button class="frontier-pill" data-status="emerging">Emerging</button>
          <button class="frontier-pill" data-status="contested">Contested & Frontier</button>
        </div>
      </div>

      <div class="frontier-grid">
        {frontierTerritories.map((territory, index) => (
          <article id={territory.slug} class={`frontier-territory frontier-territory--${index + 1}`} data-status={territory.status}>
            <QuantumLuminanceCanvas height={160} palette={territory.palette} />
            <div class="frontier-territory-body">
              <div class="frontier-territory-topline">
                <span class="frontier-index">{String(index + 1).padStart(2, "0")}</span>
                <span class={`frontier-status frontier-status--${territory.status}`}>{frontierStatusLabels[territory.status]}</span>
              </div>
              <h3>{territory.name}</h3>
              <p>{territory.description}</p>
              <p class="frontier-question">{territory.question}</p>
              <div class="frontier-topics">
                {territory.categories.map((category) => (
                  <a href={`/topics/${topicSlug(category)}/`}>{category} <span aria-hidden="true">↗</span><small>{countFor(category)}</small></a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="pioneer-lineage-section" aria-labelledby="lineage-heading">
      <div class="section-heading">
        <h2 id="lineage-heading" class="section-title">Biophysics Lineage & Founders</h2>
        <p class="section-caption">16 foundational pioneers anchoring our biophotonic & quantum biological framework</p>
      </div>

      <div class="lineage-grid">
        {pioneers.map((p) => (
          <article class="pioneer-card">
            <div class="pioneer-year">{p.year}</div>
            <h3>{p.name}</h3>
            <p class="pioneer-work"><em>{p.core_work}</em></p>
            <p class="pioneer-summary">{p.summary}</p>
            <div class="pioneer-concepts">
              {p.concepts.map((c) => (
                <span class="concept-tag">{c}</span>
              ))}
            </div>
            <div class="pioneer-application">
              <strong>Practical Legacy:</strong> {p.application}
            </div>
          </article>
        ))}
      </div>
    </section>

    <script>
      const filterPills = document.querySelectorAll<HTMLButtonElement>(".frontier-pill");
      const territoryCards = document.querySelectorAll<HTMLElement>(".frontier-territory");

      filterPills.forEach((pill) => {
        pill.addEventListener("click", () => {
          const status = pill.getAttribute("data-status");

          filterPills.forEach((p) => p.classList.remove("is-active"));
          pill.classList.add("is-active");

          territoryCards.forEach((card) => {
            const cardStatus = card.getAttribute("data-status");
            if (status === "all" || cardStatus === status || (status === "contested" && (cardStatus === "contested" || cardStatus === "speculative"))) {
              card.style.display = "";
            } else {
              card.style.display = "none";
            }
          });
        });
      });
    </script>

    <section class="frontier-method" aria-labelledby="method-heading">
      <p class="eyebrow">Editorial Discipline</p>
      <h2 id="method-heading">High signal. Direct sources. Zero dogma.</h2>
      <p>We trace emerging preprints, peer-reviewed clinical trials, and biophysical frameworks directly to their original sources—distilling complex science into practical questions you can use today.</p>
      <a class="primary-link" href="/editorial-policy/">Read the editorial policy <span aria-hidden="true">→</span></a>
    </section>
  </main>
</Layout>

<style>
  .frontier-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
    padding: 16px 20px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .filter-label {
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .frontier-pill {
    padding: 6px 14px;
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .frontier-pill:hover {
    color: var(--ink);
    border-color: var(--saffron);
  }
  .frontier-pill.is-active {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }

  .pioneer-lineage-section {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  .lineage-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }
  .pioneer-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px;
    position: relative;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .pioneer-card:hover {
    border-color: var(--saffron);
    transform: translateY(-2px);
  }
  .pioneer-year {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--saffron-ink);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .pioneer-card h3 {
    margin: 0 0 4px;
    font-size: 1.25rem;
  }
  .pioneer-work {
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0 0 12px;
  }
  .pioneer-summary {
    font-size: 0.9rem;
    line-height: 1.45;
    margin-bottom: 14px;
  }
  .pioneer-concepts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }
  .concept-tag {
    font-size: 0.74rem;
    font-weight: 600;
    background: var(--cream);
    color: var(--ink);
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid var(--line);
  }
  .pioneer-application {
    font-size: 0.82rem;
    color: var(--muted);
    border-top: 1px dashed var(--line);
    padding-top: 10px;
  }
</style>
