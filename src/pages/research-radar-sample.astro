---
import Layout from "../layouts/Layout.astro";
import radarData from "../data/research-radar.json";
import trialData from "../data/trial-registry.json";

const BRIEF_BASE = "https://agewellbrief.com/brief";
const briefLink = (ref: { slug: string }) => `${BRIEF_BASE}/${ref.slug}/`;

const drift = radarData.evidence_drift;
const convergence = radarData.citation_convergence;
const specificTrials = trialData.entries.filter((e: any) => e.specific);
const genericTrials = trialData.entries.filter((e: any) => !e.specific);

const activeTrials = (trials: any[]) =>
  trials.filter((t) => ["RECRUITING", "ACTIVE_NOT_RECRUITING", "NOT_YET_RECRUITING"].includes(t.status));

// Fold near-duplicate convergence entries (heavy brief overlap) into their
// larger sibling instead of listing them as independent signals — same
// judgment call made in the hand-built sample issue for Hayflick/Campisi.
function overlapNote(entry: any, all: any[]): string | null {
  const slugs = new Set(entry.briefs.map((b: any) => b.slug));
  for (const other of all) {
    if (other === entry || other.briefs.length <= entry.briefs.length) continue;
    const otherSlugs = new Set(other.briefs.map((b: any) => b.slug));
    const overlap = [...slugs].filter((s) => otherSlugs.has(s)).length;
    if (overlap === slugs.size && overlap >= 2) {
      return `All ${overlap} of these briefs also cite ${other.scientist} — read alongside that entry, not as an independent signal.`;
    }
  }
  return null;
}

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Research Radar — sample issue",
  description: "A real sample issue of Agewell Brief's Research Radar, computed live from the published archive.",
  url: "https://agewellbrief.com/research-radar-sample/"
};
---
<Layout
  title="Research Radar — sample issue"
  description={`A real sample issue computed from the live Agewell Brief archive — ${radarData.archive_size} briefs, ${radarData.archive_span.earliest} to ${radarData.archive_span.latest}.`}
  structuredData={structuredData}
>
  <main class="sample-page">
    <header class="sample-masthead">
      <p class="eyebrow">Agewell Brief · Research Radar · Sample issue</p>
      <h1>A real issue, computed live — not a mockup</h1>
      <p class="dek">This page renders straight from the same archive and scripts as every subscriber issue. Nothing here is written to look impressive; it's whatever the archive actually produced this month.</p>
      <p class="byline">The Agewell Brief Editorial Desk · Published monthly</p>
      <div class="meta-row">
        <span>Archive: {radarData.archive_span.earliest} to {radarData.archive_span.latest}</span>
        <span class="mono">{radarData.archive_size} briefs</span>
      </div>
    </header>

    <div class="integrity-note">
      Every finding below traces to a dated brief — or a ClinicalTrials.gov trial ID — you can click through and check. Full methodology: <a href="/research-radar-methodology/">agewellbrief.com/research-radar-methodology</a>.
    </div>

    <section>
      <h2>Confidence Shifts Within a Topic</h2>
      <p class="section-note">Pairs of briefs tagged with the same topic where the later brief sits higher on the evidence ladder than the earlier one, at least 7 days apart.</p>
      <p class="caveat">This tracks a topic tag, not a single mechanism — the two briefs below are often different findings that happen to share a topic, not the same claim re-confirmed.</p>

      {drift.length === 0 ? (
        <div class="empty-state"><p>No topic cleared the threshold this period.</p></div>
      ) : drift.map((e: any) => (
        <div class="entry">
          <div class="entry-head"><h3>{e.vector.replace(/\b\w/g, (c: string) => c.toUpperCase())}</h3><span class="badge">{e.climbs[0].gap_days} days</span></div>
          <p class="entry-desc">{e.climb_count} pair(s) found across {e.brief_count} briefs tagged with this topic.</p>
          <ul class="cite-list">
            {e.climbs.map((c: any) => (
              <li>
                <span class="date mono">{c.from.date}</span><strong>{c.from_position}</strong> — <a href={briefLink(c.from)} target="_blank" rel="noopener">{c.from.title}</a>
                <span class="arrow">→</span>
                <span class="date mono">{c.to.date}</span><strong>{c.to_position}</strong> — <a href={briefLink(c.to)} target="_blank" rel="noopener">{c.to.title}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section>
      <h2>Cross-Framework Convergence</h2>
      <p class="section-note">Historical antecedents independently cited by briefs in unrelated categories — a signal that disparate current research is converging on the same underlying mechanism.</p>

      {convergence.length === 0 ? (
        <div class="empty-state"><p>No antecedent was independently cited across multiple categories this period.</p></div>
      ) : convergence.map((e: any) => {
        const note = overlapNote(e, convergence);
        return (
          <div class="entry">
            <div class="entry-head"><h3>{e.scientist}</h3><span class="badge">{e.briefs.length} briefs</span></div>
            <p class="entry-desc">Cited independently across {e.category_count} categories: {e.categories.join(", ")}.</p>
            {note && <p class="entry-note">{note}</p>}
            <ul class="cite-list">
              {e.briefs.map((b: any) => (
                <li><span class="date mono">{b.date}</span><a href={briefLink(b)} target="_blank" rel="noopener">{b.title}</a></li>
              ))}
            </ul>
          </div>
        );
      })}
    </section>

    <section>
      <h2>Institutional Signal: Trial Registry Activity <span class="badge badge-prototype">Prototype</span></h2>
      <p class="section-note">For each brief, the single most specific named compound or intervention (if any) is checked against ClinicalTrials.gov.</p>
      <p class="caveat">{trialData.term_coverage} of {trialData.archive_size} briefs named something specific enough to check. Terms matching 150+ unrelated trials are excluded as noise, not signal.</p>

      {specificTrials.length === 0 ? (
        <div class="empty-state"><p>No brief this period named a compound specific enough to be real signal.</p></div>
      ) : specificTrials.map((e: any) => (
        <div class="entry">
          <div class="entry-head"><h3>{e.compound.replace(/\b\w/g, (c: string) => c.toUpperCase())}</h3><span class="badge">{activeTrials(e.trials).length} active</span></div>
          <p class="entry-desc">{e.total_count} trial(s) on ClinicalTrials.gov. Named in: {e.briefs.map((b: any, i: number) => (
            <>{i > 0 && ", "}<a href={briefLink(b)} target="_blank" rel="noopener">{b.title}</a></>
          ))}.</p>
          <ul class="cite-list">
            {e.trials.slice(0, 4).map((t: any) => (
              <li><a href={`https://clinicaltrials.gov/study/${t.nct_id}`} target="_blank" rel="noopener">{t.nct_id}</a> — {t.status}, phase {Array.isArray(t.phase) && t.phase.length ? t.phase.join("/") : "N/A"}, {t.sponsor}</li>
            ))}
          </ul>
        </div>
      ))}

      {genericTrials.length > 0 && (
        <p class="section-note" style="margin-top:4px;">{genericTrials.length} more term(s) matched but were too broad to be meaningful signal: {genericTrials.map((e: any) => e.compound).join(", ")}.</p>
      )}
    </section>

    <div class="cta-band">
      <p>Research Radar publishes monthly, $399/mo or $3,990/yr.</p>
      <a class="button" href="/research-radar/">See pricing & start a conversation →</a>
    </div>

    <footer class="sample-footer">
      Research Radar is a periodic synthesis product from Agewell Brief. This page reflects the live archive as of {radarData.archive_span.latest}.
    </footer>
  </main>
</Layout>

<style>
  .sample-page { max-width: 760px; margin: 0 auto; padding: 48px 20px 96px; }
  .sample-masthead { padding-bottom: 26px; border-bottom: 1px solid var(--line); }
  .eyebrow { margin: 0 0 10px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  h1 { margin: 0 0 10px; font-family: var(--serif); font-size: clamp(1.6rem, 4vw, 2.1rem); line-height: 1.2; text-wrap: balance; }
  .dek { margin: 0 0 6px; max-width: 62ch; color: var(--ink-soft); font-size: 1rem; }
  .byline { margin: 4px 0 0; font-size: 0.85rem; color: var(--muted); }
  .meta-row { margin-top: 14px; display: flex; gap: 16px; flex-wrap: wrap; font-size: 0.82rem; color: var(--muted); }
  .mono { font-variant-numeric: tabular-nums; }

  .integrity-note {
    margin-top: 26px; padding: 16px 18px; background: var(--paper);
    border: 1px solid var(--line); border-left: 3px solid var(--saffron);
    border-radius: 6px; font-size: 0.9rem; color: var(--ink-soft);
  }
  .integrity-note a { color: inherit; }

  section { margin-top: 44px; }
  h2 { margin: 0 0 8px; font-size: 1.2rem; font-weight: 600; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .section-note { margin: 0 0 6px; color: var(--ink-soft); font-size: 0.92rem; max-width: 66ch; }
  .caveat { margin: 0 0 20px; color: var(--muted); font-size: 0.85rem; font-style: italic; max-width: 66ch; }

  .empty-state { padding: 20px 22px; background: var(--paper); border: 1px dashed var(--line); border-radius: 6px; color: var(--ink-soft); font-size: 0.92rem; }
  .empty-state p { margin: 0; }

  .entry { padding: 18px 20px; background: var(--white, #fff); border: 1px solid var(--line); border-radius: 8px; margin-bottom: 14px; }
  .entry-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 6px; }
  .entry h3 { margin: 0; font-size: 1.02rem; font-weight: 600; }
  .badge {
    font-size: 0.66rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
    padding: 3px 9px; border-radius: 20px; white-space: nowrap; color: var(--saffron-ink); background: var(--paper);
    border: 1px solid var(--line);
  }
  .badge-prototype { color: var(--saffron-ink); background: color-mix(in oklch, var(--saffron) 22%, var(--paper)); }
  .entry-desc { margin: 0 0 10px; color: var(--ink-soft); font-size: 0.9rem; }
  .entry-note { margin: -4px 0 10px; color: var(--muted); font-size: 0.82rem; font-style: italic; }
  .cite-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; }
  .cite-list li { font-size: 0.87rem; line-height: 1.5; }
  .cite-list .date { color: var(--muted); margin-right: 6px; }
  .cite-list .arrow { margin: 0 6px; color: var(--muted); }
  .cite-list a { color: var(--ink); }

  .cta-band {
    margin-top: 44px; padding: 24px; background: var(--paper); border: 1px solid var(--line);
    border-radius: 8px; display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap;
  }
  .cta-band p { margin: 0; font-size: 0.92rem; color: var(--ink-soft); }
  .cta-band a.button {
    display: inline-block; padding: 10px 18px; border-radius: 6px; font-size: 0.88rem; font-weight: 700;
    text-decoration: none; background: var(--saffron-ink); color: #fff; white-space: nowrap;
  }

  .sample-footer { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 0.8rem; color: var(--muted); }

  @media (max-width: 560px) {
    .entry-head { flex-direction: column; align-items: flex-start; }
    .cta-band { flex-direction: column; align-items: flex-start; }
  }
</style>
