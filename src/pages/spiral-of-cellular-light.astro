---
import Layout from "../layouts/Layout.astro";
import { spiralSlugFor, spiralTeachingUrl, spiralWalkUrl, withUtm } from "../lib/publishing";

interface SpiralResource {
  slug: string;
  name: string;
  focus: string;
  axiom: string;
  description: string;
  topicHref: string;
  topicLabel: string;
  href: string;
  pdfUrl: string;
}

const resources: SpiralResource[] = [
  {
    slug: "living-waters",
    name: "Living Waters",
    focus: "Transport & Phase I/II Clearance",
    axiom: "“The skin is not where you end. It is where you exchange.”",
    description: "A foundation-oriented biophysics framework for interfacial Exclusion Zone (H₃O₂) hydration, hepatic conjugation, lymphatic flow, and vascular charge transport.",
    topicHref: "/topics/longevity/",
    topicLabel: "Longevity archive",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NA==",
    pdfUrl: "/downloads/field-guides/living-waters-field-guide.pdf"
  },
  {
    slug: "inner-garden",
    name: "Inner Garden",
    focus: "Gut Mucosal Ecology",
    axiom: "“The gut is not a tube; it is a living soil.”",
    description: "An ecological gut framework examining short-chain fatty acid (SCFA) signaling, tight-junction barrier integrity, and microbial circadian rhythmicity.",
    topicHref: "/topics/gut-health/",
    topicLabel: "Gut health archive",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ1MA==",
    pdfUrl: "/downloads/field-guides/inner-garden-field-guide.pdf"
  },
  {
    slug: "cell-shedding",
    name: "Cell Shedding",
    focus: "Senescence & Autophagic Renewal",
    axiom: "“Clearing the field so the young shoots may breathe.”",
    description: "A cellular renewal framework examining senolytic clearing cycles, SASP inflammatory attenuation, and autophagic lysosomal degradation.",
    topicHref: "/topics/cellular-senescence/",
    topicLabel: "Cellular senescence archive",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ1MA==",
    pdfUrl: "/downloads/field-guides/cell-shedding-field-guide.pdf"
  },
  {
    slug: "higher-flame",
    name: "Higher Flame",
    focus: "Mitochondrial Flexibility",
    axiom: "“Unlocking dual-fuel respiration across fasting and feeding.”",
    description: "A metabolic resilience framework for AMPK activation, mitochondrial respiration voltage, NAD+ salvage pathways, and GPR81 lactate signaling.",
    topicHref: "/topics/metabolic-health/",
    topicLabel: "Metabolic health archive",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NQ==",
    pdfUrl: "/downloads/field-guides/higher-flame-field-guide.pdf"
  },
  {
    slug: "luminous-mind",
    name: "Luminous Mind",
    focus: "Glymphatic & Neural Coherence",
    axiom: "“The brain flushes its light while the world sleeps.”",
    description: "A whole-system cognitive lens on slow-wave N3 delta sleep, glymphatic cerebrospinal waste clearance, neuroplasticity, and BDNF synthesis.",
    topicHref: "/topics/brain-health/",
    topicLabel: "Brain health archive",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0OA==",
    pdfUrl: "/downloads/field-guides/luminous-mind-field-guide.pdf"
  },
  {
    slug: "dark-mirror",
    name: "Dark Mirror",
    focus: "Intracellular Mineral Equilibrium",
    axiom: "“Restoring the mineral equilibrium hidden beneath daily stress.”",
    description: "An advanced biophysics framework for trace mineral ratios, heavy metal mobilization, cellular membrane potential, and deep tissue bio-clearing.",
    topicHref: "/topics/detoxification/",
    topicLabel: "Detoxification archive",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ1Nw==",
    pdfUrl: "/downloads/field-guides/dark-mirror-field-guide.pdf"
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Spiral of Cellular Light — Agewell Brief",
  description: "Six biophysics lenses and a diurnal rhythm connecting cellular hydration, mucosal ecology, autophagic renewal, mitochondrial resilience, glymphatic clearance, and mineral equilibrium.",
  url: new URL("/spiral-of-cellular-light/", Astro.site).href,
  isPartOf: { "@type": "WebSite", name: "Agewell Brief", url: new URL("/", Astro.site).href }
};
---
<Layout
  title="Spiral of Cellular Light — Agewell Brief"
  description="Six biophysics lenses and a diurnal rhythm connecting cellular hydration, mucosal ecology, autophagic renewal, mitochondrial resilience, glymphatic clearance, and mineral equilibrium."
  structuredData={structuredData}
>
  <main class="spiral-page">
    <a class="back-link" href="/">← Today’s edition</a>
    <header class="spiral-header">
      <p class="eyebrow">Companion Framework · Agewell Brief</p>
      <h1>Spiral of<br /><em>Cellular Light.</em></h1>
      <p class="spiral-lede">A regenerative health framework organized around six biological lenses—fluid transport, mucosal ecology, cellular renewal, metabolic respiration, glymphatic clearance, and mineral equilibrium.</p>
    </header>

    <section class="spiral-resources" aria-labelledby="spiral-resources-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The Six Lenses</p>
          <h2 id="spiral-resources-heading" class="section-title">Chapters of the Spiral</h2>
        </div>
        <p class="section-caption">Each lens pairs a primary teaching module with a field guide and ongoing reporting.</p>
      </div>
      <ol class="spiral-grid">
        {resources.map((resource, index) => (
          <li class="spiral-card" id={resource.slug}>
            <span class="spiral-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div class="spiral-resource-copy">
              <p class="spiral-focus-tag">{resource.focus}</p>
              <h3>{resource.name}</h3>
              <p class="spiral-axiom">{resource.axiom}</p>
              <p class="spiral-desc">{resource.description}</p>
              <div class="spiral-card-actions">
                <a href={spiralWalkUrl(resource.name, `spiral-page-walk-${resource.slug}`)} target="_blank" rel="noopener noreferrer" class="spiral-primary-link js-spiral-walk-link">
                  Start 28-Day Protocol ($33/mo) <span aria-hidden="true">→</span>
                </a>
                <span class="spiral-action-sep" aria-hidden="true">·</span>
                <a href={spiralTeachingUrl(resource.name, `spiral-page-teaching-${resource.slug}`)} target="_blank" rel="noopener noreferrer" class="spiral-secondary-link">
                  Biophysics monograph ↗
                </a>
                <span class="spiral-action-sep" aria-hidden="true">·</span>
                <button
                  type="button"
                  class="spiral-pdf-gate-btn spiral-secondary-link"
                  data-guide-slug={spiralSlugFor(resource.name)}
                  data-guide-name={resource.name}
                  data-pdf-url={resource.pdfUrl}
                >
                  Field guide (PDF) ↓
                </button>
                <span class="spiral-action-sep" aria-hidden="true">·</span>
                <a href={resource.topicHref} class="spiral-secondary-link">{resource.topicLabel}</a>
              </div>
              <form class="spiral-inline-gate is-hidden" data-gate-for={spiralSlugFor(resource.name)} data-pdf-url={resource.pdfUrl}>
                <input
                  type="email"
                  required
                  placeholder={`Enter your email for the ${resource.name} PDF…`}
                  aria-label={`Email address for ${resource.name} Field Guide PDF`}
                  class="spiral-gate-input"
                />
                <button type="submit" class="spiral-gate-submit">Unlock PDF ↓</button>
              </form>
              <div class="spiral-step2-box is-hidden" data-step2-for={spiralSlugFor(resource.name)}>
                <p class="spiral-step2-kicker">Step 2 · Ready When You Want Structure</p>
                <p class="spiral-step2-copy">
                  Your <strong>{resource.name}</strong> PDF is ready. Open your pre-calibrated 28-day circadian workspace:
                </p>
                <div class="spiral-step2-actions">
                  <a href={spiralWalkUrl(resource.name, `spiral-step2-walk-${resource.slug}`, "monthly")} target="_blank" rel="noopener noreferrer" class="spiral-primary-link js-spiral-walk-link">
                    28-Day Workspace ($33/mo) <span aria-hidden="true">→</span>
                  </a>
                  <span class="spiral-action-sep" aria-hidden="true">·</span>
                  <a href={spiralWalkUrl(resource.name, `spiral-step2-annual-${resource.slug}`, "annual")} target="_blank" rel="noopener noreferrer" class="spiral-secondary-link js-spiral-walk-link">
                    Annual Passage ($222/yr · Save 44%) ↗
                  </a>
                  <span class="spiral-action-sep" aria-hidden="true">·</span>
                  <a href={resource.pdfUrl} download class="spiral-secondary-link">
                    Re-download PDF ↓
                  </a>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* Diurnal Arc — clean editorial timeline */}
    <section class="diurnal-arc-section" aria-labelledby="diurnal-arc-heading">
      <div class="diurnal-header">
        <div>
          <p class="eyebrow">Diurnal Rhythm</p>
          <h2 id="diurnal-arc-heading" class="section-title">The Daily Arc</h2>
        </div>
        <p class="diurnal-intro">Four daily windows aligning light exposure, hydration, digestive ecology, metabolic respiration, and nightly clearance.</p>
      </div>
      <ol class="diurnal-steps">
        <li class="diurnal-step">
          <div class="diurnal-step-top">
            <span class="diurnal-num">01</span>
            <span class="diurnal-window">Dawn</span>
          </div>
          <h3>Opening of the Vessel</h3>
          <p>Structured hydration, electrolyte solutes, and morning light to prime vascular transport and Phase I/II hepatic clearance.</p>
          <p class="diurnal-lens-ref"><a href="#living-waters">Living Waters</a></p>
        </li>
        <li class="diurnal-step">
          <div class="diurnal-step-top">
            <span class="diurnal-num">02</span>
            <span class="diurnal-window">Midday</span>
          </div>
          <h3>The Inward Soil</h3>
          <p>Prebiotic polyphenols, fermentable fibers, and digestive pacing to support short-chain fatty acid signaling and tight-junction integrity.</p>
          <p class="diurnal-lens-ref"><a href="#inner-garden">Inner Garden</a> · <a href="#cell-shedding">Cell Shedding</a></p>
        </li>
        <li class="diurnal-step">
          <div class="diurnal-step-top">
            <span class="diurnal-num">03</span>
            <span class="diurnal-window">Afternoon</span>
          </div>
          <h3>Kindling of the Hearth</h3>
          <p>Mitochondrial cofactors, movement, and dual-fuel metabolic flexibility across feeding and unhurried cellular recovery.</p>
          <p class="diurnal-lens-ref"><a href="#higher-flame">Higher Flame</a> · <a href="#dark-mirror">Dark Mirror</a></p>
        </li>
        <li class="diurnal-step">
          <div class="diurnal-step-top">
            <span class="diurnal-num">04</span>
            <span class="diurnal-window">Dusk to Delta</span>
          </div>
          <h3>The Nightly Flush</h3>
          <p>Dimming short-wavelength light and entering slow-wave N3 sleep so glymphatic cerebrospinal flow can clear metabolic debris.</p>
          <p class="diurnal-lens-ref"><a href="#luminous-mind">Luminous Mind</a></p>
        </li>
      </ol>
    </section>

    <footer class="spiral-colophon" aria-labelledby="spiral-colophon-heading">
      <div class="spiral-colophon-grid">
        <div>
          <p class="eyebrow">Editorial &amp; Sourcing Note</p>
          <h2 id="spiral-colophon-heading">How the framework relates to Agewell Brief.</h2>
        </div>
        <div class="spiral-colophon-copy">
          <p>
            <strong>Spiral of Cellular Light</strong> (<a href="https://spiraloflight.life/walk?lens=biophysics&utm_source=agewellbrief&utm_medium=referral&utm_content=spiral-colophon" target="_blank" rel="noopener noreferrer">spiraloflight.life</a>) pairs open biophysics monographs and free PDF field guides with a paid <strong>28-Day Circadian Protocol Workspace</strong> ($33/month cycle, $222/year Annual Passage across all four seasons, or $555 Founding Patron Pass capped at 33 seats) featuring calibrated morning/evening dosing windows, Apple/Google Calendar WebCal sync, and an AI Companion. Agewell Brief keeps primary peer-reviewed reporting, clinical consensus, and the companion framework distinct so readers can evaluate each study on its own evidence.
          </p>
          <p>
            Practitioner-grade dispensary plans (Canada, US, and Europe), compounding preparations, and full molecular formularies corresponding to each lens unlock inside the <a href="https://spiraloflight.life/walk?lens=biophysics&utm_source=agewellbrief&utm_medium=referral&utm_content=spiral-page-sourcing" target="_blank" rel="noopener noreferrer">Spiral of Cellular Light Member Sanctuary</a>. Always review any protocol with a qualified healthcare professional.
          </p>
        </div>
      </div>
    </footer>
  </main>

  <script>
    function triggerPdfDownload(url: string) {
      const a = document.createElement("a");
      a.href = url;
      a.setAttribute("download", "");
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    function applySpiralEmailLinks(email: string) {
      if (!email) return;
      document.querySelectorAll<HTMLAnchorElement>(".js-spiral-walk-link").forEach((a) => {
        try {
          const u = new URL(a.href);
          u.searchParams.set("email", email);
          a.href = u.toString();
        } catch {}
      });
    }

    function revealStep2ForSlug(slug: string, email: string) {
      applySpiralEmailLinks(email);
      const step2 = document.querySelector<HTMLElement>(`.spiral-step2-box[data-step2-for="${slug}"]`);
      if (step2) step2.classList.remove("is-hidden");
    }

    try {
      const savedInit = localStorage.getItem("agewell_lead_email") || "";
      if (savedInit) applySpiralEmailLinks(savedInit);
    } catch {}

    document.querySelectorAll<HTMLButtonElement>(".spiral-pdf-gate-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const pdfUrl = btn.dataset.pdfUrl || "";
        const slug = btn.dataset.guideSlug || "waters";
        let savedEmail = "";
        try {
          savedEmail = localStorage.getItem("agewell_lead_email") || "";
        } catch {}

        if (savedEmail && pdfUrl) {
          revealStep2ForSlug(slug, savedEmail);
          triggerPdfDownload(pdfUrl);
          return;
        }

        const card = btn.closest(".spiral-resource-copy");
        const form = card?.querySelector<HTMLFormElement>(`form[data-gate-for="${slug}"]`);
        if (form) {
          form.classList.remove("is-hidden");
          form.querySelector("input")?.focus();
        }
      });
    });

    document.querySelectorAll<HTMLFormElement>(".spiral-inline-gate").forEach((form) => {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const input = form.querySelector<HTMLInputElement>("input");
        const submitBtn = form.querySelector<HTMLButtonElement>("button");
        const email = input?.value.trim().toLowerCase() || "";
        const slug = form.dataset.gateFor || "waters";
        const pdfUrl = form.dataset.pdfUrl || "";
        if (!email) return;

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Unlocking…";
        }

        try {
          await fetch("https://spiraloflight.life/api/phase0", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email,
              tier: slug === "waters" ? "gentle_waters" : "full_foundation",
              region: "us",
              guideSlug: slug,
              source: `agewell_spiral_page_${slug}`
            })
          });
        } catch {}

        try {
          localStorage.setItem("agewell_lead_email", email);
          window.dispatchEvent(
            new CustomEvent("agewell:lead-captured", {
              detail: { placement: "spiral_framework_page", spiral: slug, page_path: window.location.pathname }
            })
          );
        } catch {}

        form.classList.add("is-hidden");
        revealStep2ForSlug(slug, email);
        if (pdfUrl) triggerPdfDownload(pdfUrl);
      });
    });
  </script>
</Layout>

<style>
  .spiral-pdf-gate-btn {
    background: none;
    border: 0;
    padding: 0;
    font-family: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .spiral-inline-gate.is-hidden,
  .spiral-step2-box.is-hidden {
    display: none;
  }
  .spiral-step2-box {
    margin-top: 12px;
    padding: 12px 14px;
    background: var(--cream);
    border: 1px solid var(--line);
    border-left: 2.5px solid var(--saffron);
  }
  .spiral-step2-kicker {
    margin: 0 0 4px;
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--saffron-ink);
  }
  .spiral-step2-copy {
    margin: 0 0 8px;
    font-family: var(--sans);
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .spiral-step2-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-family: var(--sans);
    font-size: 0.78rem;
  }
  .spiral-inline-gate {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    padding: 10px 12px;
    background: var(--cream);
    border: 1px solid var(--line);
  }
  .spiral-gate-input {
    flex: 1 1 200px;
    min-height: 36px;
    padding: 7px 10px;
    font-family: var(--sans);
    font-size: 0.84rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--white);
    color: var(--ink);
  }
  .spiral-gate-submit {
    min-height: 36px;
    padding: 7px 14px;
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    border-radius: 2px;
    cursor: pointer;
  }
  .spiral-gate-submit:hover {
    background: var(--saffron-ink);
    border-color: var(--saffron-ink);
  }
  .spiral-resources {
    margin-top: 24px;
  }
  .spiral-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(32px, 5vw, 72px);
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  .spiral-card {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 16px;
    padding: 36px 0 40px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 32px;
  }
  .spiral-index {
    color: var(--saffron-ink);
    font-family: var(--serif);
    font-size: 1.55rem;
    line-height: 1.05;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .spiral-focus-tag {
    margin: 0 0 8px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .spiral-resource-copy h3 {
    margin: 0 0 10px;
    font-size: clamp(1.75rem, 2.6vw, 2.3rem);
    line-height: 1.06;
  }
  .spiral-axiom {
    font-family: var(--serif);
    font-size: 1.12rem;
    font-style: italic;
    color: var(--saffron-ink);
    line-height: 1.45;
    margin: 0 0 12px;
  }
  .spiral-desc {
    font-family: var(--serif);
    font-size: 1.06rem;
    line-height: 1.58;
    color: var(--ink-soft);
    margin: 0 0 18px;
    max-width: 54ch;
  }
  .spiral-card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-family: var(--sans);
    font-size: 0.8rem;
  }
  .spiral-primary-link {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1.5px solid var(--saffron);
    padding-bottom: 1px;
  }
  .spiral-primary-link span {
    color: var(--saffron-ink);
    padding-left: 4px;
  }
  .spiral-primary-link:hover {
    color: var(--saffron-ink);
  }
  .spiral-secondary-link {
    color: var(--muted);
    font-weight: 600;
    text-decoration: none;
  }
  .spiral-secondary-link:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--saffron);
  }
  .spiral-action-sep {
    color: var(--line);
  }

  /* Diurnal Arc — clean editorial timeline */
  .diurnal-arc-section {
    margin: 88px 0 0;
    padding-top: 44px;
    border-top: 1.5px solid var(--ink);
    box-shadow: inset 0 3px 0 var(--paper), inset 0 4px 0 var(--line-strong);
  }
  .diurnal-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 32px;
    margin-bottom: 36px;
  }
  .diurnal-intro {
    max-width: 46ch;
    margin: 0;
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .diurnal-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .diurnal-step {
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .diurnal-step-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .diurnal-num {
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--saffron-ink);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .diurnal-window {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .diurnal-step h3 {
    margin: 0 0 10px;
    font-size: 1.35rem;
    line-height: 1.15;
  }
  .diurnal-step p {
    margin: 0 0 12px;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .diurnal-lens-ref {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .diurnal-lens-ref a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .diurnal-lens-ref a:hover {
    color: var(--saffron-ink);
  }

  /* Quiet Editorial Colophon */
  .spiral-colophon {
    margin: 88px 0 0;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .spiral-colophon-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 6vw;
    align-items: start;
  }
  .spiral-colophon h2 {
    margin: 8px 0 0;
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    line-height: 1.12;
  }
  .spiral-colophon-copy p {
    margin: 0 0 14px;
    font-size: 0.92rem;
    line-height: 1.6;
