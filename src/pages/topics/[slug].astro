---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { publishedBriefs, spiralSlugFor, spiralTeachingUrl, spiralWalkUrl, topicSlug, typographic, withUtm } from "../../lib/publishing";

export async function getStaticPaths() {
  const entries = publishedBriefs(await getCollection("briefs"));
  const grouped = new Map<string, typeof entries>();
  for (const entry of entries) {
    const current = grouped.get(entry.data.category) ?? [];
    current.push(entry);
    grouped.set(entry.data.category, current);
  }
  return [...grouped.entries()].map(([category, briefs]) => ({
    params: { slug: topicSlug(category) },
    props: { category, briefs }
  }));
}

const { category, briefs } = Astro.props;
const topicGuides: Record<string, { lede: string; question: string; resource?: { name: string; label: string; href: string; pdfUrl: string } }> = {
  "brain health": {
    lede: "Readable reporting on memory, sleep, stress, learning, and the conditions that help a mind stay engaged.",
    question: "What helps the brain stay capable, curious, and well supported?",
    resource: {
      name: "Luminous Mind",
      label: "Explore Luminous Mind",
      href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0OA==",
      pdfUrl: "/downloads/field-guides/luminous-mind-field-guide.pdf"
    }
  },
  "cellular senescence": {
    lede: "A grounded guide to senescence research, healthspan questions, and what remains unsettled about senolytic approaches.",
    question: "What can senescence research tell us, and what is still a hypothesis?",
    resource: {
      name: "Cell Shedding",
      label: "Explore Cell Shedding",
      href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ1MA==",
      pdfUrl: "/downloads/field-guides/cell-shedding-field-guide.pdf"
    }
  },
  "detoxification": {
    lede: "Context for liver processing, elimination pathways, mineral-clearing ideas, and the questions worth asking before an intensive protocol.",
    question: "What does clearing mean, and how should a person think about sequence and safety?",
    resource: {
      name: "Living Waters",
      label: "Explore Living Waters",
      href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NA==",
      pdfUrl: "/downloads/field-guides/living-waters-field-guide.pdf"
    }
  },
  "gut health": {
    lede: "Reporting and practical context on the gut ecosystem, digestion, microbial balance, and the gut-brain conversation.",
    question: "How do we make sense of gut health without reducing it to one microbe or one product?",
    resource: {
      name: "Inner Garden",
      label: "Explore Inner Garden",
      href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0OQ==",
      pdfUrl: "/downloads/field-guides/inner-garden-field-guide.pdf"
    }
  },
  "metabolic health": {
    lede: "Clear signals on blood sugar, fuel use, fasting, food timing, and the everyday choices that shape metabolic health.",
    question: "Which metabolic ideas are useful, and which deserve a closer look?",
    resource: {
      name: "Higher Flame",
      label: "Explore Higher Flame",
      href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NQ==",
      pdfUrl: "/downloads/field-guides/higher-flame-field-guide.pdf"
    }
  },
  "longevity": {
    lede: "Biophysical precision on lifespan extensions, cellular resilience, and systemic vitality.",
    question: "What drives physical longevity beyond genetic predisposition?",
    resource: {
      name: "Dark Mirror",
      label: "Explore Dark Mirror",
      href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ1Nw==",
      pdfUrl: "/downloads/field-guides/dark-mirror-field-guide.pdf"
    }
  },
  "sleep health": {
    lede: "Slow-wave N3 sleep architecture, circadian light hygiene, and nightly glymphatic clearance.",
    question: "How does deep sleep clear metabolic waste and preserve cognitive longevity?",
    resource: {
      name: "Luminous Mind",
      label: "Explore Luminous Mind",
      href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0OA==",
      pdfUrl: "/downloads/field-guides/luminous-mind-field-guide.pdf"
    }
  },
  "nutrition": {
    lede: "Nutrient signaling, polyphenol hormesis, fasting mimetics, and mitochondrial substrate flexibility.",
    question: "Which dietary signals meaningfully shift cellular bioenergetics in humans?",
    resource: {
      name: "Higher Flame",
      label: "Explore Higher Flame",
      href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NQ==",
      pdfUrl: "/downloads/field-guides/higher-flame-field-guide.pdf"
    }
  },
  "mobility": {
    lede: "Musculoskeletal resilience, joint remodeling, mitochondrial myokines, and functional strength across decades.",
    question: "What preserves muscle energetics and joint integrity as tissues age?",
    resource: {
      name: "Higher Flame",
      label: "Explore Higher Flame",
      href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NQ==",
      pdfUrl: "/downloads/field-guides/higher-flame-field-guide.pdf"
    }
  },
  "consumer safety": {
    lede: "Evidence-backed scrutiny of environmental toxicants, trace metal contamination, and supplement purity.",
    question: "Where do hidden exposures accumulate, and how are they safely avoided or cleared?",
    resource: {
      name: "Dark Mirror",
      label: "Explore Dark Mirror",
      href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ1Nw==",
      pdfUrl: "/downloads/field-guides/dark-mirror-field-guide.pdf"
    }
  },
  "general wellness": {
    lede: "Foundational physiological habits across hydration, microcirculation, light exposure, and autonomic balance.",
    question: "Which foundational daily inputs carry the highest signal-to-noise ratio?",
    resource: {
      name: "Living Waters",
      label: "Explore Living Waters",
      href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NA==",
      pdfUrl: "/downloads/field-guides/living-waters-field-guide.pdf"
    }
  }
};
const guide = topicGuides[category.toLowerCase()] ?? {
  lede: `Agewell Brief reporting and useful signals on ${category}, with original sources and practical context.`,
  question: `What is worth understanding about ${category}?`
};
const description = `${guide.lede} Original sources, useful context, and questions worth carrying forward.`;
const topicURL = new URL(`/topics/${topicSlug(category)}/`, Astro.site).href;

// Topic pages are the surface a topical query lands on, so they carry their own
// schema: the collection itself, its ordered briefs, and the framing question
// answered in prose above.
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${category} — Agewell Brief`,
    description,
    url: topicURL,
    about: { "@type": "Thing", name: category },
    isPartOf: {
      "@type": "WebSite",
      name: "Agewell Brief",
      url: new URL("/", Astro.site).href
    },
    publisher: {
      "@type": "Organization",
      name: "Agewell Brief",
      url: new URL("/", Astro.site).href
    },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: briefs.length,
      itemListElement: briefs.map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: new URL(`/brief/${entry.id}/`, Astro.site).href,
        name: entry.data.title
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: guide.question,
        acceptedAnswer: { "@type": "Answer", text: guide.lede }
      }
    ]
  }
];
---
<Layout title={`${category} — Agewell Brief`} description={description} structuredData={structuredData}>
  <main class="topic-page">
    <a class="back-link" href="/">← Today’s edition</a>
    <header class="topic-header">
      <div class="topic-header-topline"><p class="eyebrow">Agewell topic desk</p><span>{briefs.length} {briefs.length === 1 ? "brief" : "briefs"}</span></div>
      <h1>{category}</h1>
      <p>{guide.lede}</p>
    </header>
    <section class="topic-context" aria-labelledby="topic-context-heading">
      <div>
        <p class="eyebrow">The useful question</p>
        <h2 id="topic-context-heading">{guide.question}</h2>
      </div>
      {guide.resource && <div
        class="topic-resource"
        data-spiral-slug={spiralSlugFor(guide.resource.name)}
        data-pdf-url={guide.resource.pdfUrl}
      >
        <p>28-Day Companion Protocol · {guide.resource.name}</p>
        <a class="js-topic-walk-link" href={spiralWalkUrl(guide.resource.name, `topic-walk-${topicSlug(category)}`, "monthly")} rel="noopener noreferrer" target="_blank">Start 28-Day {guide.resource.name} Protocol ($33/mo) <span aria-hidden="true">→</span></a>
        <a class="topic-framework-link" href={spiralTeachingUrl(guide.resource.name, `topic-teaching-${topicSlug(category)}`)} rel="noopener noreferrer" target="_blank">Open biophysics monograph <span aria-hidden="true">↗</span></a>
        <form id="topic-guide-form" class="topic-guide-form">
          <input
            type="email"
            id="topic-guide-email"
            required
            placeholder="Email for free Field Guide PDF…"
            aria-label={`Email address for ${guide.resource.name} Field Guide PDF`}
            class="topic-guide-input"
          />
          <button type="submit" id="topic-guide-btn" class="topic-guide-btn">
            Send PDF ↓
          </button>
        </form>
        <div id="topic-guide-unlocked" class="topic-guide-unlocked is-hidden">
          <p class="topic-step-kicker">Step 2 · Next Step</p>
          <p class="topic-step-copy">
            Your <strong>{guide.resource.name}</strong> Field Guide is unlocked. Ready to run the calibrated 28-day schedule?
          </p>
          <div class="topic-step-actions">
            <a class="topic-step-primary js-topic-walk-link" href={spiralWalkUrl(guide.resource.name, `topic-step2-walk-${topicSlug(category)}`, "monthly")} rel="noopener noreferrer" target="_blank">
              Start 28-Day Workspace ($33/mo) →
            </a>
            <a class="topic-step-secondary js-topic-walk-link" href={spiralWalkUrl(guide.resource.name, `topic-step2-annual-${topicSlug(category)}`, "annual")} rel="noopener noreferrer" target="_blank">
              Annual Passage ($222/yr · Save 44%) ↗
            </a>
            <a id="topic-guide-pdf-link" href={guide.resource.pdfUrl} download class="topic-pdf-download">
              Re-download {guide.resource.name} PDF ↓
            </a>
          </div>
        </div>
        <small>
          Practitioner dispensary plans and calibrated dosing windows unlock inside the{" "}
          <a class="js-topic-walk-link" href={spiralWalkUrl(guide.resource.name, "topic-page-sourcing", "monthly")} rel="noopener noreferrer" target="_blank">
            28-Day Protocol Workspace
          </a>.
        </small>
      </div>}
    </section>
    <section class="topic-list" aria-labelledby="topic-list-heading">
      <div class="section-heading">
        <h2 id="topic-list-heading" class="section-title">Published briefs</h2>
        <p class="section-caption">Source-linked reading</p>
      </div>
      <ol>
        {briefs.map((entry, index) => <li>
          <span class="topic-index">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <p>{entry.data.date.toLocaleDateString("en-CA", { month: "long", day: "numeric", year: "numeric" })} · {entry.data.source_name}</p>
            <h3><a href={`/brief/${entry.id}/`}>{typographic(entry.data.title)}</a></h3>
          </div>
        </li>)}
      </ol>
    </section>
  </main>

  <script>
    const resourceBox = document.querySelector(".topic-resource") as HTMLElement | null;
    const topicForm = document.getElementById("topic-guide-form") as HTMLFormElement | null;
    const topicEmail = document.getElementById("topic-guide-email") as HTMLInputElement | null;
    const topicBtn = document.getElementById("topic-guide-btn") as HTMLButtonElement | null;
    const topicUnlocked = document.getElementById("topic-guide-unlocked");
    const topicPdfLink = document.getElementById("topic-guide-pdf-link") as HTMLAnchorElement | null;
    const spiralSlug = resourceBox?.dataset.spiralSlug || "waters";

    function applyTopicWalkEmail(email: string) {
      if (!email) return;
      document.querySelectorAll<HTMLAnchorElement>(".js-topic-walk-link").forEach((a) => {
        try {
          const u = new URL(a.href);
          u.searchParams.set("email", email);
          a.href = u.toString();
        } catch {}
      });
    }

    try {
      const saved = localStorage.getItem("agewell_lead_email");
      if (saved && topicForm && topicUnlocked) {
        applyTopicWalkEmail(saved);
        topicForm.style.display = "none";
        topicUnlocked.classList.remove("is-hidden");
      }
    } catch {}

    if (topicForm && topicEmail && topicBtn && topicUnlocked) {
      topicForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = topicEmail.value.trim().toLowerCase();
        if (!email) return;
        topicBtn.disabled = true;
        topicBtn.textContent = "Unlocking…";

        try {
          await fetch("https://spiraloflight.life/api/phase0", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email,
              tier: spiralSlug === "waters" ? "gentle_waters" : "full_foundation",
              region: "us",
              guideSlug: spiralSlug,
              source: `agewell_topic_${spiralSlug}`
            })
          });
        } catch {}

        try {
          localStorage.setItem("agewell_lead_email", email);
          window.dispatchEvent(
            new CustomEvent("agewell:lead-captured", {
              detail: { placement: "topic_page", spiral: spiralSlug, page_path: window.location.pathname }
            })
          );
        } catch {}

        applyTopicWalkEmail(email);
        topicForm.style.display = "none";
        topicUnlocked.classList.remove("is-hidden");
        if (topicPdfLink) topicPdfLink.click();
      });
    }
  </script>
</Layout>

<style>
  .topic-guide-form {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 6px;
  }
  .topic-guide-input {
    flex: 1 1 170px;
    min-height: 36px;
    padding: 6px 10px;
    font-family: var(--sans);
    font-size: 0.82rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--white);
    color: var(--ink);
  }
  .topic-guide-btn {
    min-height: 36px;
    padding: 6px 12px;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    border-radius: 2px;
    cursor: pointer;
  }
  .topic-guide-btn:hover {
    background: var(--saffron-ink);
    border-color: var(--saffron-ink);
  }
  .topic-guide-unlocked.is-hidden {
    display: none;
  }
  .topic-guide-unlocked {
    margin: 10px 0 8px;
    padding: 10px 12px;
    background: var(--cream);
    border: 1px solid var(--line);
    border-left: 2.5px solid var(--saffron);
  }
  .topic-step-kicker {
    margin: 0 0 4px !important;
    font-size: 0.68rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--saffron-ink) !important;
  }
  .topic-step-copy {
    margin: 0 0 8px !important;
    font-size: 0.82rem !important;
    line-height: 1.45;
    color: var(--ink) !important;
  }
  .topic-step-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }
  .topic-step-primary {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--saffron-ink);
  }
  .topic-step-secondary,
  .topic-pdf-download {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration-color: var(--line);
  }
  .topic-step-secondary:hover,
  .topic-pdf-download:hover {
    color: var(--saffron-ink);
    text-decoration-color: var(--saffron);
  }
</style>
