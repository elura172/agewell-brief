---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { publishedBriefs, topicSlug, typographic } from "../../lib/publishing";

export async function getStaticPaths() {
  const entries = publishedBriefs(await getCollection("briefs"));
  const grouped = new Map<string, typeof entries>();
  for (const entry of entries) {
    const current = grouped.get(entry.data.category) ?? [];
    current.push(entry);
    grouped.set(entry.data.category, current);
  }
  return [...grouped.entries()].map(([category, briefs]) => ({
    params: { slug: topicSlug(category) },
    props: { category, briefs }
  }));
}

const { category, briefs } = Astro.props;
const topicGuides: Record<string, { lede: string; question: string; resource?: { label: string; href: string; pdfUrl: string } }> = {
  "brain health": {
    lede: "Readable reporting on memory, sleep, stress, learning, and the conditions that help a mind stay engaged.",
    question: "What helps the brain stay capable, curious, and well supported?",
    resource: {
      label: "Explore Luminous Mind",
      href: "https://ca.fullscript.com/u/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0OA==",
      pdfUrl: "/downloads/field-guides/luminous-mind-field-guide.pdf"
    }
  },
  "cellular senescence": {
    lede: "A grounded guide to senescence research, healthspan questions, and what remains unsettled about senolytic approaches.",
    question: "What can senescence research tell us, and what is still a hypothesis?",
    resource: {
      label: "Explore Cell Shedding",
      href: "https://ca.fullscript.com/u/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ1MA==",
      pdfUrl: "/downloads/field-guides/cell-shedding-field-guide.pdf"
    }
  },
  "detoxification": {
    lede: "Context for liver processing, elimination pathways, mineral-clearing ideas, and the questions worth asking before an intensive protocol.",
    question: "What does clearing mean, and how should a person think about sequence and safety?",
    resource: {
      label: "Explore Living Waters",
      href: "https://ca.fullscript.com/u/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NA==",
      pdfUrl: "/downloads/field-guides/living-waters-field-guide.pdf"
    }
  },
  "gut health": {
    lede: "Reporting and practical context on the gut ecosystem, digestion, microbial balance, and the gut-brain conversation.",
    question: "How do we make sense of gut health without reducing it to one microbe or one product?",
    resource: {
      label: "Explore Inner Garden",
      href: "https://ca.fullscript.com/u/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0OQ==",
      pdfUrl: "/downloads/field-guides/inner-garden-field-guide.pdf"
    }
  },
  "metabolic health": {
    lede: "Clear signals on blood sugar, fuel use, fasting, food timing, and the everyday choices that shape metabolic health.",
    question: "Which metabolic ideas are useful, and which deserve a closer look?",
    resource: {
      label: "Explore Higher Flame",
      href: "https://ca.fullscript.com/u/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NQ==",
      pdfUrl: "/downloads/field-guides/higher-flame-field-guide.pdf"
    }
  },
  "longevity": {
    lede: "Biophysical precision on lifespan extensions, cellular resilience, and systemic vitality.",
    question: "What drives physical longevity beyond genetic predisposition?",
    resource: {
      label: "Explore Dark Mirror",
      href: "https://ca.fullscript.com/u/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ1Nw==",
      pdfUrl: "/downloads/field-guides/dark-mirror-field-guide.pdf"
    }
  }
};
const guide = topicGuides[category.toLowerCase()] ?? {
  lede: `Agewell Brief reporting and useful signals on ${category}, with original sources and practical context.`,
  question: `What is worth understanding about ${category}?`
};
const description = `${guide.lede} Original sources, useful context, and questions worth carrying forward.`;
const topicURL = new URL(`/topics/${topicSlug(category)}/`, Astro.site).href;

// Topic pages are the surface a topical query lands on, so they carry their own
// schema: the collection itself, its ordered briefs, and the framing question
// answered in prose above.
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${category} — Agewell Brief`,
    description,
    url: topicURL,
    about: { "@type": "Thing", name: category },
    isPartOf: {
      "@type": "WebSite",
      name: "Agewell Brief",
      url: new URL("/", Astro.site).href
    },
    publisher: {
      "@type": "Organization",
      name: "Agewell Brief",
      url: new URL("/", Astro.site).href
    },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: briefs.length,
      itemListElement: briefs.map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: new URL(`/brief/${entry.id}/`, Astro.site).href,
        name: entry.data.title
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: guide.question,
        acceptedAnswer: { "@type": "Answer", text: guide.lede }
      }
    ]
  }
];
---
<Layout title={`${category} — Agewell Brief`} description={description} structuredData={structuredData}>
  <main class="topic-page">
    <a class="back-link" href="/">← Today’s edition</a>
    <header class="topic-header">
      <div class="topic-header-topline"><p class="eyebrow">Agewell topic desk</p><span>{briefs.length} {briefs.length === 1 ? "brief" : "briefs"}</span></div>
      <h1>{category}</h1>
      <p>{guide.lede}</p>
    </header>
    <section class="topic-context" aria-labelledby="topic-context-heading">
      <div>
        <p class="eyebrow">The useful question</p>
        <h2 id="topic-context-heading">{guide.question}</h2>
      </div>
      {guide.resource && <div class="topic-resource">
        <p>Program perspective</p>
        <a class="topic-framework-link" href="/spiral-of-cellular-light/">About the framework <span aria-hidden="true">→</span></a>
        <a href={guide.resource.href} rel="sponsored noopener noreferrer">{guide.resource.label} <span aria-hidden="true">→</span></a>
        <a href={guide.resource.pdfUrl} download class="topic-pdf-download">📄 Download Companion Field Guide (PDF)</a>
        <small>Commission-supported; no added cost to you.</small>
      </div>}
    </section>
    <section class="topic-list" aria-labelledby="topic-list-heading">
      <div class="section-heading">
        <h2 id="topic-list-heading" class="section-title">Published briefs</h2>
        <p class="section-caption">Source-linked reading</p>
      </div>
      <ol>
        {briefs.map((entry, index) => <li>
          <span class="topic-index">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <p>{entry.data.date.toLocaleDateString("en-CA", { month: "long", day: "numeric", year: "numeric" })} · {entry.data.source_name}</p>
            <h3><a href={`/brief/${entry.id}/`}>{typographic(entry.data.title)}</a></h3>
          </div>
        </li>)}
      </ol>
    </section>
  </main>
</Layout>

<style>
  .topic-pdf-download {
    display: inline-block;
    margin-top: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--saffron-ink);
    text-decoration: none;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
    transition: all 0.2s ease;
  }
  .topic-pdf-download:hover {
    border-color: var(--saffron);
    background: var(--cream);
  }
</style>
