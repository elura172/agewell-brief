---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { isCommercialLink, linkRel, plainTextExcerpt, publishedBriefs, readingTimeMinutes, spiralSlugFor, spiralTeachingUrl, spiralWalkUrl, topicSlug, typographic, withUtm } from "../../lib/publishing";
import EditorialImage from "../../components/EditorialImage.astro";
import { frontierForCategory } from "../../data/frontier-map";

export async function getStaticPaths() {
  const entries = (await getCollection("briefs"))
    .filter((entry) => import.meta.env.DEV || !entry.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.edition_rank - b.data.edition_rank);
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      newerBrief: index > 0 ? entries[index - 1] : undefined,
      olderBrief: index < entries.length - 1 ? entries[index + 1] : undefined
    }
  }));
}

const { entry, newerBrief, olderBrief } = Astro.props;
const { Content } = await render(entry);
const formatShortDate = (date: Date) => date.toLocaleDateString("en-CA", { month: "short", day: "numeric", year: "numeric" });
const formatDate = entry.data.date.toLocaleDateString("en-CA", { month: "long", day: "numeric", year: "numeric" });
const readMinutes = readingTimeMinutes(entry.body ?? "");
const formatDateTime = entry.data.date.toLocaleString("en-CA", {
  month: "long",
  day: "numeric",
  year: "numeric",
  hour: "numeric",
  minute: "2-digit",
  timeZone: "America/Toronto",
  timeZoneName: "short"
});
const isLongform = ["lead", "evergreen", "editorial"].includes(entry.data.content_type);
const description = entry.data.description || plainTextExcerpt((entry.body ?? "").split("\n\n")[0], 190);
const articleURL = new URL(`/brief/${entry.id}/`, Astro.site).href;
const authorURL = new URL("/about/#editorial-desk", Astro.site).href;
const logoURL = new URL("/logo.svg", Astro.site).href;
const related = publishedBriefs(await getCollection("briefs"))
  .filter((candidate) => candidate.id !== entry.id && candidate.data.category === entry.data.category)
  .slice(0, 2);
const categoryToProtocol: Record<string, { icon: string; name: string; focus: string; href: string; pdfUrl: string }> = {
  "brain health": {
    icon: "⚡",
    name: "Luminous Mind Protocol",
    focus: "Whole-system cognitive care, sleep, and neural resilience",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0OA==",
    pdfUrl: "/downloads/field-guides/luminous-mind-field-guide.pdf"
  },
  "cellular senescence": {
    icon: "🍃",
    name: "Cell Shedding Protocol",
    focus: "Targeted cellular renewal and senolytic support",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ1MA==",
    pdfUrl: "/downloads/field-guides/cell-shedding-field-guide.pdf"
  },
  "gut health": {
    icon: "🌱",
    name: "Inner Garden Protocol",
    focus: "Microbiome balance, gut mucosal integrity, and motility",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0OQ==",
    pdfUrl: "/downloads/field-guides/inner-garden-field-guide.pdf"
  },
  "metabolic health": {
    icon: "🔥",
    name: "Higher Flame Protocol",
    focus: "Metabolic flexibility, glucose transport, and mitochondrial energy",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NQ==",
    pdfUrl: "/downloads/field-guides/higher-flame-field-guide.pdf"
  },
  "detoxification": {
    icon: "🌊",
    name: "Living Waters Protocol",
    focus: "Liver sequence processing, hydration, and cellular transport",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NA==",
    pdfUrl: "/downloads/field-guides/living-waters-field-guide.pdf"
  },
  "longevity": {
    icon: "🪞",
    name: "Dark Mirror Protocol",
    focus: "Advanced mineral clearing and biological aging support",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ1Nw==",
    pdfUrl: "/downloads/field-guides/dark-mirror-field-guide.pdf"
  }
};

// Prefer the spiral the pipeline actually routed this brief to. Routing applies
// keyword overrides on top of the category — a chelation story filed under brain
// health goes to Dark Mirror — so resolving the closing card from the category
// alone made the two cards on the page recommend different programs.
const protocolByName = Object.fromEntries(
  Object.values(categoryToProtocol).map((p) => [p.name.replace(" Protocol", "").toLowerCase(), p])
);
const protocolCard =
  protocolByName[(entry.data.spiral ?? "").toLowerCase()] ??
  categoryToProtocol[entry.data.category.toLowerCase()] ??
  categoryToProtocol["brain health"];

const spiralName = protocolCard.name.replace(" Protocol", "");
const protocolSlug = spiralSlugFor(spiralName);
const protocolProgramUrl = spiralTeachingUrl(spiralName, "brief-closing-teaching");
const protocolHeaderTeachingUrl = spiralTeachingUrl(spiralName, "brief-header-teaching");
const protocolWalkUrl = spiralWalkUrl(spiralName, "brief-closing-walk", "monthly");
const protocolAnnualUrl = spiralWalkUrl(spiralName, "brief-closing-annual", "annual");
const protocolTopWalkUrl = spiralWalkUrl(spiralName, "brief-top-step2-walk", "monthly");
const protocolTopAnnualUrl = spiralWalkUrl(spiralName, "brief-top-step2-annual", "annual");
const protocolHeaderWalkUrl = spiralWalkUrl(spiralName, "brief-header-walk", "monthly");
const frontierLinks = frontierForCategory(entry.data.category);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    headline: entry.data.title,
    description,
    datePublished: entry.data.date.toISOString(),
    dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
    mainEntityOfPage: { "@type": "WebPage", "@id": articleURL },
    isAccessibleForFree: true,
    articleSection: entry.data.category,
    about: { "@type": "Thing", name: entry.data.category },
    keywords: [entry.data.category, "biophysics", "longevity science", "healthspan"],
    author: {
      "@type": "Organization",
      name: entry.data.author,
      url: authorURL
    },
    publisher: {
      "@type": "Organization",
      name: "Agewell Brief",
      url: new URL("/", Astro.site).href,
      logo: { "@type": "ImageObject", url: logoURL, width: 512, height: 512 }
    },
    citation: entry.data.source_url,
    ...(entry.data.image ? { image: [new URL(entry.data.image, Astro.site).href] } : {})
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: entry.data.category, item: new URL(`/topics/${topicSlug(entry.data.category)}/`, Astro.site).href },
      { "@type": "ListItem", position: 3, name: entry.data.title, item: articleURL }
    ]
  }
];
---
<Layout
  title={`${typographic(entry.data.title)} — Agewell Brief`}
  description={description}
  ogType="article"
  image={entry.data.image}
  imageAlt={entry.data.image_alt}
  imageWidth={entry.data.image_width}
  imageHeight={entry.data.image_height}
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updated ?? entry.data.date}
  structuredData={structuredData}
>
  <article class:list={["article-page", { "is-lead": isLongform }]}>
    <a class="back-link" href="/">← All briefs</a>
    <header class="article-header">
      <div class="article-kicker">
        <a class="article-category-link" href={`/topics/${topicSlug(entry.data.category)}/`}>{entry.data.category}</a>
        <span class="article-kicker-sep" aria-hidden="true">·</span>
        <span class={`evidence-badge evidence-badge--${entry.data.evidence_position}`}>{entry.data.evidence_position}</span>
        <span class="article-kicker-sep" aria-hidden="true">·</span>
        <time datetime={entry.data.date.toISOString()}>{formatDate}</time>
        <span class="article-kicker-sep" aria-hidden="true">·</span>
        <span>{readMinutes} min read</span>
      </div>
      <h1>{typographic(entry.data.title)}</h1>
      <div class="article-meta-bar">
        <div class="article-meta">
          <p class="article-byline">By <a href="/about/#editorial-desk">{entry.data.author}</a> · <span>Published {formatDateTime}</span></p>
          {/* The six programme explainers cite our own storefront rather than a
              study. It already carries rel="sponsored", but calling a shop
              "Original reporting" is the part that misleads. */}
          <p class="article-source">{isCommercialLink(entry.data.source_url) ? "Programme reference: " : "Original reporting: "}<a href={entry.data.source_url} rel={linkRel(entry.data.source_url)}>{entry.data.source_title}</a></p>
          {frontierLinks.length > 0 && <p class="article-frontier">On the frontier: {frontierLinks.slice(0, 2).map((frontier, index) => <><a href={`/frontier-map/#${frontier.slug}`}>{frontier.shortName}</a>{index < Math.min(frontierLinks.length, 2) - 1 ? ", " : ""}</>)}</p>}
        </div>
        <div class="article-util-actions" aria-label="Article tools">
          <button type="button" id="copy-link-btn" class="article-util-btn" data-url={articleURL}>Copy link</button>
          <button type="button" id="print-brief-btn" class="article-util-btn">Print</button>
          <span id="copy-link-status" class="sr-only" role="status" aria-live="polite"></span>
        </div>
      </div>
      <div class="article-companion-strip" aria-label={`${spiralName} protocol bridge`}>
        <span class="companion-strip-label">Companion lens: <strong>{spiralName}</strong></span>
        <span class="companion-strip-links">
          <a href={protocolHeaderTeachingUrl} target="_blank" rel="noopener noreferrer">Biophysics monograph ↗</a>
          <span aria-hidden="true">·</span>
          <a href={protocolHeaderWalkUrl} target="_blank" rel="noopener noreferrer" class="companion-strip-cta js-personalized-walk-link">28-Day Protocol ($33/mo) →</a>
        </span>
      </div>
    </header>
    {entry.data.image && <div class="article-hero">
      <EditorialImage
        src={entry.data.image}
        alt={entry.data.image_alt ?? "Illustrative photograph for this Agewell Brief article"}
        photographer={entry.data.image_photographer}
        photographerUrl={entry.data.image_photographer_url}
        sourceUrl={entry.data.image_source_url}
        provider={entry.data.image_provider}
        width={entry.data.image_width}
        height={entry.data.image_height}
        avgColor={entry.data.image_avg_color}
        variant="article"
        eager={true}
      />
      <p class="article-image-note"><span>In the frame</span> {typographic(entry.data.image_caption) || "A glimpse of the everyday routines behind this story."}</p>
    </div>}

    <aside
      class="brief-top-guide-callout brief-guide-widget"
      aria-label={`Free ${spiralName} Biophysics Field Guide PDF`}
      data-spiral-slug={protocolSlug}
      data-placement="brief_top_callout"
    >
      <form class="protocol-guide-form js-brief-guide-form">
        <div class="brief-top-guide-head">
          <span class="brief-top-guide-kicker">Companion Field Guide · {spiralName}</span>
          <span class="brief-top-guide-meta">4-Page Printable PDF · Free</span>
        </div>
        <label for="brief-top-guide-email" class="protocol-guide-label">
          Get the <strong>{spiralName} Biophysics Field Guide</strong>—dosing windows, Phase I/II transport sequence &amp; daily schedule:
        </label>
        <div class="protocol-guide-row">
          <input
            type="email"
            id="brief-top-guide-email"
            name="email"
            required
            placeholder="Enter your email for instant PDF download…"
            class="protocol-guide-input"
          />
          <button type="submit" class="protocol-guide-submit">
            Download Free PDF ↓
          </button>
        </div>
      </form>

      <div class="protocol-guide-unlocked js-brief-guide-unlocked is-hidden">
        <p class="protocol-guide-step-kicker">Step 2 · Ready When You Want Structure</p>
        <p class="protocol-guide-unlocked-title">
          Your <strong>{spiralName}</strong> Field Guide is unlocked. Want to run the 28-day circadian schedule with daily AM/PM windows, Apple/Google Calendar sync &amp; AI Companion?
        </p>
        <div class="protocol-guide-unlocked-actions">
          <a
            href={protocolTopWalkUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="primary-link js-personalized-walk-link"
          >
            Start 28-Day {spiralName} Workspace ($33/mo) →
          </a>
          <a
            href={protocolTopAnnualUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="protocol-secondary-link js-personalized-walk-link"
          >
            Annual Passage ($222/yr · Save 44%) ↗
          </a>
          <a href={protocolCard.pdfUrl} download class="protocol-secondary-link">
            Re-download {spiralName} PDF ↓
          </a>
        </div>
      </div>
    </aside>

    <div class="article-content"><Content /></div>

    {entry.data.autoresearch_antecedents && entry.data.autoresearch_antecedents.length > 0 && (
      <aside class="article-lineage-card" aria-label="Historical Biophysics Antecedents">
        <div class="lineage-card-header">
          <span class="lineage-eyebrow">Pioneer Lineage · Historical Precursors</span>
          <h3>Scientific Precursors & Foundational Discoveries</h3>
        </div>
        <div class="lineage-timeline">
          {entry.data.autoresearch_antecedents.map((item) => (
            <div class="lineage-item">
              <span class="lineage-year">{item.year}</span>
              <span class="lineage-scientist">{item.scientist}</span>
              <p class="lineage-discovery">{item.discovery}</p>
            </div>
          ))}
        </div>
      </aside>
    )}

    <aside
      class="article-protocol-card"
      aria-label={`${spiralName} companion protocol`}
      data-spiral-slug={protocolSlug}
      data-spiral-name={spiralName}
    >
      <p class="protocol-eyebrow">Spiral of Cellular Light · 28-Day Circadian Protocol</p>
      <h3>{spiralName}</h3>
      <p class="protocol-focus">
        {protocolCard.focus}. Read the open biophysics monograph freely, or run {spiralName} inside the calibrated 28-Day Circadian Protocol Workspace—with morning &amp; evening dosing windows, Apple/Google Calendar WebCal sync, and AI Companion.
      </p>
      <div class="protocol-card-actions">
        <a class="primary-link js-personalized-walk-link" href={protocolWalkUrl} rel="noopener noreferrer" target="_blank">
          Start 28-Day {spiralName} Protocol · $33/mo <span aria-hidden="true">→</span>
        </a>
        <a class="protocol-secondary-link js-personalized-walk-link" href={protocolAnnualUrl} rel="noopener noreferrer" target="_blank">
          Annual Passage ($222/yr · Save 44%) ↗
        </a>
        <a class="protocol-secondary-link" href={protocolProgramUrl} rel="noopener noreferrer" target="_blank">
          Open biophysics monograph ↗
        </a>
        <a class="protocol-secondary-link" href="/spiral-of-cellular-light/">
          All six spirals
        </a>
      </div>

      <div class="protocol-guide-box brief-guide-widget" data-placement="brief_protocol_card">
        <form id="brief-guide-form" class="protocol-guide-form js-brief-guide-form">
          <label for="brief-guide-email" class="protocol-guide-label">
            Free printable <strong>{spiralName} Field Guide (PDF)</strong> + companion protocol notes:
          </label>
          <div class="protocol-guide-row">
            <input
              type="email"
              id="brief-guide-email"
              name="email"
              required
              placeholder="Enter your email address…"
              class="protocol-guide-input"
            />
            <button type="submit" id="brief-guide-btn" class="protocol-guide-submit">
              Unlock Field Guide PDF →
            </button>
          </div>
        </form>
        <div id="brief-guide-unlocked" class="protocol-guide-unlocked js-brief-guide-unlocked is-hidden">
          <p class="protocol-guide-step-kicker">Step 2 · Next Step</p>
          <p class="protocol-guide-unlocked-title">
            Your <strong>{spiralName}</strong> Field Guide is unlocked. Step into your pre-calibrated 28-Day Protocol Workspace (email pre-filled):
          </p>
          <div class="protocol-guide-unlocked-actions">
            <a
              id="brief-guide-walk-link"
              href={protocolWalkUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="primary-link js-personalized-walk-link"
            >
              Start 28-Day {spiralName} Workspace ($33/mo) →
            </a>
            <a
              href={protocolAnnualUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="protocol-secondary-link js-personalized-walk-link"
            >
              Annual Passage ($222/yr · Save 44%) ↗
            </a>
            <a id="brief-guide-pdf-link" href={protocolCard.pdfUrl} download class="protocol-secondary-link">
              Re-download {spiralName} PDF ↓
            </a>
          </div>
        </div>
      </div>

      <p class="protocol-sourcing">
        Complete molecular formulary, practitioner dispensary plans (Canada, US &amp; Europe), and morning/evening dosing windows unlock inside the
        <a href={protocolWalkUrl} rel="noopener noreferrer" target="_blank">28-Day Protocol Workspace</a>.
      </p>
    </aside>

    {related.length > 0 && <section class="related-briefs" aria-labelledby="related-heading">
      <div>
        <p class="eyebrow">Continue the thread</p>
        <h2 id="related-heading">More on {entry.data.category}</h2>
        <a class="topic-link" href={`/topics/${topicSlug(entry.data.category)}/`}>Browse the full topic <span>→</span></a>
      </div>
      <ol>
        {related.map((candidate) => <li><a href={`/brief/${candidate.id}/`}>{typographic(candidate.data.title)}</a><span>{candidate.data.source_name}</span></li>)}
      </ol>
    </section>}
    {(olderBrief || newerBrief) && (
      <nav class="article-pager" aria-label="Adjacent briefs">
        {olderBrief ? (
          <a class="pager-slot pager-slot--prev" href={`/brief/${olderBrief.id}/`}>
            <span class="pager-dir"><span aria-hidden="true">←</span> Earlier brief</span>
            <span class="pager-title">{typographic(olderBrief.data.title)}</span>
            <span class="pager-meta">{olderBrief.data.category} · {formatShortDate(olderBrief.data.date)}</span>
          </a>
        ) : (
          <div class="pager-slot pager-slot--empty" aria-hidden="true"></div>
        )}
        {newerBrief && (
          <a class="pager-slot pager-slot--next" href={`/brief/${newerBrief.id}/`}>
            <span class="pager-dir">Newer brief <span aria-hidden="true">→</span></span>
            <span class="pager-title">{typographic(newerBrief.data.title)}</span>
            <span class="pager-meta">{newerBrief.data.category} · {formatShortDate(newerBrief.data.date)}</span>
          </a>
        )}
      </nav>
    )}
    <footer class="article-footer"><span>Keep asking better questions.</span><a href="/#subscribe">Get tomorrow’s edition →</a></footer>
  </article>

  <script>
    const copyBtn = document.getElementById("copy-link-btn") as HTMLButtonElement | null;
    const copyStatus = document.getElementById("copy-link-status");
    const printBtn = document.getElementById("print-brief-btn");
    let copyTimer: number | undefined;

    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        const url = copyBtn.getAttribute("data-url") || window.location.href;
        let copied = false;
        try {
          await navigator.clipboard.writeText(url);
          copied = true;
        } catch {
          const fallback = document.createElement("textarea");
          fallback.value = url;
          fallback.setAttribute("readonly", "");
          fallback.style.position = "absolute";
          fallback.style.left = "-9999px";
          document.body.appendChild(fallback);
          fallback.select();
          copied = document.execCommand("copy");
          document.body.removeChild(fallback);
        }

        if (copied) {
          copyBtn.textContent = "Link copied";
          copyBtn.setAttribute("data-copied", "true");
          if (copyStatus) copyStatus.textContent = "Article link copied to clipboard.";
          if (copyTimer) window.clearTimeout(copyTimer);
          copyTimer = window.setTimeout(() => {
            copyBtn.textContent = "Copy link";
            copyBtn.removeAttribute("data-copied");
          }, 2000);
        }
      });
    }

    if (printBtn) {
      printBtn.addEventListener("click", () => {
        window.print();
      });
    }

    const protocolCardEl = document.querySelector(".article-protocol-card") as HTMLElement | null;
    const spiralSlug = protocolCardEl?.dataset.spiralSlug || "waters";

    function applyPersonalizedWalkHref(email: string) {
      if (!email) return;
      document.querySelectorAll<HTMLAnchorElement>(".js-personalized-walk-link").forEach((link) => {
        try {
          const u = new URL(link.href);
          u.searchParams.set("email", email);
          link.href = u.toString();
        } catch {}
      });
    }

    function revealAllGuideUnlockedStates(email: string) {
      applyPersonalizedWalkHref(email);
      document.querySelectorAll<HTMLFormElement>(".js-brief-guide-form").forEach((form) => {
        form.style.display = "none";
      });
      document.querySelectorAll<HTMLElement>(".js-brief-guide-unlocked").forEach((box) => {
        box.classList.remove("is-hidden");
      });
    }

    try {
      const savedEmail = localStorage.getItem("agewell_lead_email");
      if (savedEmail) {
        revealAllGuideUnlockedStates(savedEmail);
      }
    } catch {}

    document.querySelectorAll<HTMLFormElement>(".js-brief-guide-form").forEach((form) => {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
        const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const widget = form.closest<HTMLElement>(".brief-guide-widget");
        const placement = widget?.dataset.placement || "brief_protocol_card";
        const email = emailInput?.value.trim().toLowerCase() || "";
        if (!email) return;

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Unlocking…";
        }

        const activeSpirals = {
          waters: true,
          garden: spiralSlug === "garden",
          flame: spiralSlug === "flame",
          mind: spiralSlug === "mind",
          shedding: spiralSlug === "shedding",
          mirror: spiralSlug === "mirror"
        };

        try {
          await fetch("https://spiraloflight.life/api/phase0", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email,
              tier: spiralSlug === "waters" ? "gentle_waters" : "full_foundation",
              region: "us",
              activeSpirals,
              guideSlug: spiralSlug,
              source: `agewell_${placement}_${spiralSlug}`
            })
          });
        } catch {}

        try {
          localStorage.setItem("agewell_lead_email", email);
          window.dispatchEvent(
            new CustomEvent("agewell:lead-captured", {
              detail: {
                placement,
                spiral: spiralSlug,
                page_path: window.location.pathname
              }
            })
          );
        } catch {}

        revealAllGuideUnlockedStates(email);

        const pdfLink = document.getElementById("brief-guide-pdf-link") as HTMLAnchorElement | null;
        if (pdfLink) pdfLink.click();
      });
    });
  </script>

</Layout>

<style>
  .article-lineage-card,
  .article-protocol-card {
    margin: 56px 0 0;
    padding: 28px 0 0;
    border-top: 1px solid var(--ink);
  }
  .lineage-eyebrow,
  .protocol-eyebrow {
    display: block;
    margin: 0 0 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--saffron-ink);
  }
  .article-lineage-card h3 {
    margin: 0 0 20px;
    font-size: 1.45rem;
  }
  .lineage-timeline {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .lineage-item {
    padding-left: 16px;
    border-left: 1px solid var(--line);
