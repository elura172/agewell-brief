---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { linkRel, plainTextExcerpt, publishedBriefs, topicSlug } from "../../lib/publishing";
import EditorialImage from "../../components/EditorialImage.astro";
import EZWaterCalculator from "../../components/EZWaterCalculator.astro";
import GlymphaticCalculator from "../../components/GlymphaticCalculator.astro";
import { frontierForCategory } from "../../data/frontier-map";

export async function getStaticPaths() {
  const entries = await getCollection("briefs");
  return entries
    .filter((entry) => import.meta.env.DEV || !entry.data.draft)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const formatDate = entry.data.date.toLocaleDateString("en-CA", { month: "long", day: "numeric", year: "numeric" });
const formatDateTime = entry.data.date.toLocaleString("en-CA", {
  month: "long",
  day: "numeric",
  year: "numeric",
  hour: "numeric",
  minute: "2-digit",
  timeZone: "America/Toronto",
  timeZoneName: "short"
});
const isLongform = ["lead", "evergreen", "editorial"].includes(entry.data.content_type);
const description = plainTextExcerpt((entry.body ?? "").split("\n\n")[0], 190);
const articleURL = new URL(`/brief/${entry.id}/`, Astro.site).href;
const authorURL = new URL("/about/#editorial-desk", Astro.site).href;
const logoURL = new URL("/logo.svg", Astro.site).href;
const related = publishedBriefs(await getCollection("briefs"))
  .filter((candidate) => candidate.id !== entry.id && candidate.data.category === entry.data.category)
  .slice(0, 2);
const categoryToProtocol: Record<string, { icon: string; name: string; focus: string; href: string; pdfUrl: string }> = {
  "brain health": {
    icon: "⚡",
    name: "Luminous Mind Protocol",
    focus: "Whole-system cognitive care, sleep, and neural resilience",
    href: "https://ca.fullscript.com/u/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0OA==",
    pdfUrl: "/downloads/field-guides/luminous-mind-field-guide.pdf"
  },
  "cellular senescence": {
    icon: "🍃",
    name: "Cell Shedding Protocol",
    focus: "Targeted cellular renewal and senolytic support",
    href: "https://ca.fullscript.com/u/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ1MA==",
    pdfUrl: "/downloads/field-guides/cell-shedding-field-guide.pdf"
  },
  "gut health": {
    icon: "🌱",
    name: "Inner Garden Protocol",
    focus: "Microbiome balance, gut mucosal integrity, and motility",
    href: "https://ca.fullscript.com/u/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0OQ==",
    pdfUrl: "/downloads/field-guides/inner-garden-field-guide.pdf"
  },
  "metabolic health": {
    icon: "🔥",
    name: "Higher Flame Protocol",
    focus: "Metabolic flexibility, glucose transport, and mitochondrial energy",
    href: "https://ca.fullscript.com/u/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NQ==",
    pdfUrl: "/downloads/field-guides/higher-flame-field-guide.pdf"
  },
  "detoxification": {
    icon: "🌊",
    name: "Living Waters Protocol",
    focus: "Liver sequence processing, hydration, and cellular transport",
    href: "https://ca.fullscript.com/u/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NA==",
    pdfUrl: "/downloads/field-guides/living-waters-field-guide.pdf"
  },
  "longevity": {
    icon: "🪞",
    name: "Dark Mirror Protocol",
    focus: "Advanced mineral clearing and biological aging support",
    href: "https://ca.fullscript.com/u/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ1Nw==",
    pdfUrl: "/downloads/field-guides/dark-mirror-field-guide.pdf"
  }
};

const protocolCard = categoryToProtocol[entry.data.category.toLowerCase()] ?? categoryToProtocol["brain health"];
const frontierLinks = frontierForCategory(entry.data.category);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    headline: entry.data.title,
    description,
    datePublished: entry.data.date.toISOString(),
    dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
    mainEntityOfPage: { "@type": "WebPage", "@id": articleURL },
    isAccessibleForFree: true,
    articleSection: entry.data.category,
    about: { "@type": "Thing", name: entry.data.category },
    keywords: [entry.data.category, "biophysics", "longevity science", "healthspan"],
    author: {
      "@type": "Organization",
      name: entry.data.author,
      url: authorURL
    },
    publisher: {
      "@type": "Organization",
      name: "Agewell Brief",
      url: new URL("/", Astro.site).href,
      logo: { "@type": "ImageObject", url: logoURL, width: 512, height: 512 }
    },
    citation: entry.data.source_url,
    ...(entry.data.image ? { image: [new URL(entry.data.image, Astro.site).href] } : {})
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: entry.data.category, item: new URL(`/topics/${topicSlug(entry.data.category)}/`, Astro.site).href },
      { "@type": "ListItem", position: 3, name: entry.data.title, item: articleURL }
    ]
  }
];
---
<Layout
  title={`${entry.data.title} — Agewell Brief`}
  description={description}
  ogType="article"
  image={entry.data.image}
  imageAlt={entry.data.image_alt}
  imageWidth={entry.data.image_width}
  imageHeight={entry.data.image_height}
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updated ?? entry.data.date}
  structuredData={structuredData}
>
  <article class:list={["article-page", { "is-lead": isLongform }]}>
    <a class="back-link" href="/">← All briefs</a>
    <div class="article-intro-bar">
      <p class="eyebrow">Agewell Brief <span aria-hidden="true">·</span> Clear signals. Better questions.</p>
      <a href="/#subscribe">Get tomorrow’s edition <span aria-hidden="true">→</span></a>
    </div>
    <header class="article-header">
      <div class="signal-rail">
        <div class="signal-rail-tags">
          <span>{entry.data.category}</span>
          <span class={`evidence-badge evidence-badge--${entry.data.evidence_position}`}>{entry.data.evidence_position}</span>
          {(entry.data.frameworks && entry.data.frameworks.length > 0 ? entry.data.frameworks : [protocolCard.name.replace("Protocol", "Framework")]).map((fw) => (
            <a class="framework-header-badge" href={protocolCard.pdfUrl} download title="Download Biophysics Field Guide PDF">
              ⚡ {fw}
            </a>
          ))}
        </div>
        <i></i>
        <span>{formatDate}</span>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="article-byline">By <a href="/about/#editorial-desk">{entry.data.author}</a> · <time datetime={entry.data.date.toISOString()}>Published {formatDateTime}</time></p>
      <p class="article-source">Original reporting: <a href={entry.data.source_url} rel={linkRel(entry.data.source_url)}>{entry.data.source_title}</a></p>
      {frontierLinks.length > 0 && <p class="article-frontier">On the frontier: {frontierLinks.slice(0, 2).map((frontier, index) => <><a href={`/frontier-map/#${frontier.slug}`}>{frontier.shortName}</a>{index < Math.min(frontierLinks.length, 2) - 1 ? ", " : ""}</>)}</p>}
    </header>
    {entry.data.image && <div class="article-hero">
      <EditorialImage
        src={entry.data.image}
        alt={entry.data.image_alt ?? "Illustrative photograph for this Agewell Brief article"}
        photographer={entry.data.image_photographer}
        photographerUrl={entry.data.image_photographer_url}
        sourceUrl={entry.data.image_source_url}
        provider={entry.data.image_provider}
        width={entry.data.image_width}
        height={entry.data.image_height}
        avgColor={entry.data.image_avg_color}
        variant="article"
        eager={true}
      />
      <p class="article-image-note"><span>In the frame</span> {entry.data.image_caption ?? "A glimpse of the everyday routines behind this story."}</p>
    <div class="article-content"><Content /></div>

    {/* Interactive Biophysics Calculators */}
    {(entry.data.category === "longevity" || entry.id.includes("water") || entry.id.includes("living") || entry.id.includes("hydration")) && (
      <EZWaterCalculator />
    )}
    {(entry.data.category === "brain health" || entry.data.category === "sleep health" || entry.id.includes("sleep") || entry.id.includes("mind") || entry.id.includes("alzheimer")) && (
      <GlymphaticCalculator />
    )}

    {entry.data.autoresearch_antecedents && entry.data.autoresearch_antecedents.length > 0 && (
      <aside class="article-lineage-card" aria-label="Historical Biophysics Antecedents">
        <div class="lineage-card-header">
          <span class="lineage-eyebrow">Pioneer Lineage · Historical Precursors</span>
          <h3>Scientific Precursors & Foundational Discoveries</h3>
        </div>
        <div class="lineage-timeline">
          {entry.data.autoresearch_antecedents.map((item) => (
            <div class="lineage-item">
              <span class="lineage-year">{item.year}</span>
              <span class="lineage-scientist">{item.scientist}</span>
              <p class="lineage-discovery">{item.discovery}</p>
            </div>
          ))}
        </div>
      </aside>
    )}

    <aside class="article-protocol-card" aria-label="Recommended Fullscript Protocol">
      <div class="protocol-card-header">
        <span class="protocol-eyebrow">Program Protocol · Fullscript Direct</span>
        <h3>{protocolCard.icon} {protocolCard.name}</h3>
        <p class="protocol-focus">{protocolCard.focus}</p>
      </div>
      <div class="protocol-card-actions">
        <a class="protocol-primary-btn" href={protocolCard.href} rel="sponsored noopener noreferrer" target="_blank">
          View Protocol on Fullscript <span aria-hidden="true">→</span>
        </a>
        <a class="protocol-pdf-btn" href={protocolCard.pdfUrl} download>
          📄 Download Companion Guide (PDF)
        </a>
      </div>
      <p class="protocol-disclosure">Verified practitioner formulation. Commission-supported; no added cost to you.</p>
    </aside>

    {related.length > 0 && <section class="related-briefs" aria-labelledby="related-heading">
      <div>
        <p class="eyebrow">Continue the thread</p>
        <h2 id="related-heading">More on {entry.data.category}</h2>
        <a class="topic-link" href={`/topics/${topicSlug(entry.data.category)}/`}>Browse the full topic <span>→</span></a>
      </div>
      <ol>
        {related.map((candidate) => <li><a href={`/brief/${candidate.id}/`}>{candidate.data.title}</a><span>{candidate.data.source_name}</span></li>)}
      </ol>
    </section>}
    <footer class="article-footer"><span>Keep asking better questions.</span><a href="/#subscribe">Get tomorrow’s edition →</a></footer>
  </article>

  {/* Floating Sticky Reader Bar */}
  <aside id="floating-reader-bar" class="floating-reader-bar" aria-label="Subscribe reminder">
    <div class="reader-bar-inner">
      <span>📩 Enjoying this biophysics analysis? Get 3x daily signals + 6 PDF Field Guides.</span>
      <a href="/#subscribe" class="reader-bar-btn">Get Free Briefs <span aria-hidden="true">→</span></a>
    </div>
  </aside>
</Layout>

<style>
  .article-protocol-card {
    margin: 40px 0;
    padding: 28px 32px;
    background: var(--cream);
    border: 1px solid var(--saffron-soft);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
  }

  .article-lineage-card {
    margin: 40px 0;
    padding: 28px 32px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .lineage-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--saffron-ink);
  }
  .article-lineage-card h3 {
    margin: 4px 0 20px;
    font-size: 1.3rem;
  }
  .lineage-timeline {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .lineage-item {
    padding-left: 16px;
    border-left: 2px solid var(--saffron);
  }
  .lineage-year {
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--saffron-ink);
    margin-right: 8px;
  }
  .lineage-scientist {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .lineage-discovery {
    margin: 4px 0 0;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.4;
  }
  .protocol-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--saffron-ink);
    margin-bottom: 6px;
  }
  .article-protocol-card h3 {
    font-family: var(--serif);
    font-size: 1.35rem;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .protocol-focus {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .protocol-card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }
  .protocol-primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 20px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .protocol-primary-btn:hover {
    background: var(--saffron-ink);
  }
  .protocol-pdf-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 600;
    border: 1px solid var(--line);
    border-radius: 20px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .protocol-pdf-btn:hover {
    border-color: var(--saffron);
    background: var(--cream);
  }
  .protocol-disclosure {
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0;
  }

  .framework-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 12px;
    background: var(--cream);
    color: var(--saffron-ink);
    border: 1px solid var(--saffron-soft);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .framework-header-badge:hover {
    background: var(--saffron-soft);
    color: var(--ink);
  }

  /* Floating Sticky Reader Bar */
  .floating-reader-bar {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 99;
    max-width: 680px;
    width: 90vw;
    background: var(--paper);
    border: 1px solid var(--saffron-soft);
    border-radius: 30px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    padding: 10px 20px;
  }
  .reader-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink);
  }
  .reader-bar-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 14px;
    background: var(--saffron-ink);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    border-radius: 20px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease;
  }
  .reader-bar-btn:hover {
    background: var(--ink);
  }
</style>
