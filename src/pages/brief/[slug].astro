---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { isCommercialLink, linkRel, plainTextExcerpt, publishedBriefs, spiralTeachingUrl, topicSlug, typographic, withUtm } from "../../lib/publishing";
import EditorialImage from "../../components/EditorialImage.astro";
import { frontierForCategory } from "../../data/frontier-map";

export async function getStaticPaths() {
  const entries = await getCollection("briefs");
  return entries
    .filter((entry) => import.meta.env.DEV || !entry.data.draft)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const formatDate = entry.data.date.toLocaleDateString("en-CA", { month: "long", day: "numeric", year: "numeric" });
const formatDateTime = entry.data.date.toLocaleString("en-CA", {
  month: "long",
  day: "numeric",
  year: "numeric",
  hour: "numeric",
  minute: "2-digit",
  timeZone: "America/Toronto",
  timeZoneName: "short"
});
const isLongform = ["lead", "evergreen", "editorial"].includes(entry.data.content_type);
const description = plainTextExcerpt((entry.body ?? "").split("\n\n")[0], 190);
const articleURL = new URL(`/brief/${entry.id}/`, Astro.site).href;
const authorURL = new URL("/about/#editorial-desk", Astro.site).href;
const logoURL = new URL("/logo.svg", Astro.site).href;
const related = publishedBriefs(await getCollection("briefs"))
  .filter((candidate) => candidate.id !== entry.id && candidate.data.category === entry.data.category)
  .slice(0, 2);
const categoryToProtocol: Record<string, { icon: string; name: string; focus: string; href: string; pdfUrl: string }> = {
  "brain health": {
    icon: "⚡",
    name: "Luminous Mind Protocol",
    focus: "Whole-system cognitive care, sleep, and neural resilience",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0OA==",
    pdfUrl: "/downloads/field-guides/luminous-mind-field-guide.pdf"
  },
  "cellular senescence": {
    icon: "🍃",
    name: "Cell Shedding Protocol",
    focus: "Targeted cellular renewal and senolytic support",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ1MA==",
    pdfUrl: "/downloads/field-guides/cell-shedding-field-guide.pdf"
  },
  "gut health": {
    icon: "🌱",
    name: "Inner Garden Protocol",
    focus: "Microbiome balance, gut mucosal integrity, and motility",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0OQ==",
    pdfUrl: "/downloads/field-guides/inner-garden-field-guide.pdf"
  },
  "metabolic health": {
    icon: "🔥",
    name: "Higher Flame Protocol",
    focus: "Metabolic flexibility, glucose transport, and mitochondrial energy",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NQ==",
    pdfUrl: "/downloads/field-guides/higher-flame-field-guide.pdf"
  },
  "detoxification": {
    icon: "🌊",
    name: "Living Waters Protocol",
    focus: "Liver sequence processing, hydration, and cellular transport",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ0NA==",
    pdfUrl: "/downloads/field-guides/living-waters-field-guide.pdf"
  },
  "longevity": {
    icon: "🪞",
    name: "Dark Mirror Protocol",
    focus: "Advanced mineral clearing and biological aging support",
    href: "https://ca.fullscript.com/s/spiraloflight/shop/plans/TXVsdGlQYXRpZW50UGxhbi0xMDQ1Nw==",
    pdfUrl: "/downloads/field-guides/dark-mirror-field-guide.pdf"
  }
};

// Prefer the spiral the pipeline actually routed this brief to. Routing applies
// keyword overrides on top of the category — a chelation story filed under brain
// health goes to Dark Mirror — so resolving the closing card from the category
// alone made the two cards on the page recommend different programs.
const protocolByName = Object.fromEntries(
  Object.values(categoryToProtocol).map((p) => [p.name.replace(" Protocol", "").toLowerCase(), p])
);
const protocolCard =
  protocolByName[(entry.data.spiral ?? "").toLowerCase()] ??
  categoryToProtocol[entry.data.category.toLowerCase()] ??
  categoryToProtocol["brain health"];

const spiralName = protocolCard.name.replace(" Protocol", "");
const protocolProgramUrl = spiralTeachingUrl(spiralName);
const frontierLinks = frontierForCategory(entry.data.category);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    headline: entry.data.title,
    description,
    datePublished: entry.data.date.toISOString(),
    dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
    mainEntityOfPage: { "@type": "WebPage", "@id": articleURL },
    isAccessibleForFree: true,
    articleSection: entry.data.category,
    about: { "@type": "Thing", name: entry.data.category },
    keywords: [entry.data.category, "biophysics", "longevity science", "healthspan"],
    author: {
      "@type": "Organization",
      name: entry.data.author,
      url: authorURL
    },
    publisher: {
      "@type": "Organization",
      name: "Agewell Brief",
      url: new URL("/", Astro.site).href,
      logo: { "@type": "ImageObject", url: logoURL, width: 512, height: 512 }
    },
    citation: entry.data.source_url,
    ...(entry.data.image ? { image: [new URL(entry.data.image, Astro.site).href] } : {})
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: entry.data.category, item: new URL(`/topics/${topicSlug(entry.data.category)}/`, Astro.site).href },
      { "@type": "ListItem", position: 3, name: entry.data.title, item: articleURL }
    ]
  }
];
---
<Layout
  title={`${typographic(entry.data.title)} — Agewell Brief`}
  description={description}
  ogType="article"
  image={entry.data.image}
  imageAlt={entry.data.image_alt}
  imageWidth={entry.data.image_width}
  imageHeight={entry.data.image_height}
  publishedTime={entry.data.date}
  modifiedTime={entry.data.updated ?? entry.data.date}
  structuredData={structuredData}
>
  <article class:list={["article-page", { "is-lead": isLongform }]}>
    <a class="back-link" href="/">← All briefs</a>
    <div class="article-intro-bar">
      <p class="eyebrow">Agewell Brief <span aria-hidden="true">·</span> Clear signals. Better questions.</p>
    </div>
    <header class="article-header">
      <div class="signal-rail">
        <div class="signal-rail-tags">
          <span>{entry.data.category}</span>
          <span class={`evidence-badge evidence-badge--${entry.data.evidence_position}`}>{entry.data.evidence_position}</span>
        </div>
        <i></i>
        <span>{formatDate}</span>
      </div>
      <h1>{typographic(entry.data.title)}</h1>
      <p class="article-byline">By <a href="/about/#editorial-desk">{entry.data.author}</a> · <time datetime={entry.data.date.toISOString()}>Published {formatDateTime}</time></p>
      {/* The six programme explainers cite our own storefront rather than a
          study. It already carries rel="sponsored", but calling a shop
          "Original reporting" is the part that misleads. */}
      <p class="article-source">{isCommercialLink(entry.data.source_url) ? "Programme reference: " : "Original reporting: "}<a href={entry.data.source_url} rel={linkRel(entry.data.source_url)}>{entry.data.source_title}</a></p>
      {frontierLinks.length > 0 && <p class="article-frontier">On the frontier: {frontierLinks.slice(0, 2).map((frontier, index) => <><a href={`/frontier-map/#${frontier.slug}`}>{frontier.shortName}</a>{index < Math.min(frontierLinks.length, 2) - 1 ? ", " : ""}</>)}</p>}
    </header>
    {entry.data.image && <div class="article-hero">
      <EditorialImage
        src={entry.data.image}
        alt={entry.data.image_alt ?? "Illustrative photograph for this Agewell Brief article"}
        photographer={entry.data.image_photographer}
        photographerUrl={entry.data.image_photographer_url}
        sourceUrl={entry.data.image_source_url}
        provider={entry.data.image_provider}
        width={entry.data.image_width}
        height={entry.data.image_height}
        avgColor={entry.data.image_avg_color}
        variant="article"
        eager={true}
      />
      <p class="article-image-note"><span>In the frame</span> {typographic(entry.data.image_caption) || "A glimpse of the everyday routines behind this story."}</p>
    </div>}
    <div class="article-content"><Content /></div>

    {entry.data.autoresearch_antecedents && entry.data.autoresearch_antecedents.length > 0 && (
      <aside class="article-lineage-card" aria-label="Historical Biophysics Antecedents">
        <div class="lineage-card-header">
          <span class="lineage-eyebrow">Pioneer Lineage · Historical Precursors</span>
          <h3>Scientific Precursors & Foundational Discoveries</h3>
        </div>
        <div class="lineage-timeline">
          {entry.data.autoresearch_antecedents.map((item) => (
            <div class="lineage-item">
              <span class="lineage-year">{item.year}</span>
              <span class="lineage-scientist">{item.scientist}</span>
              <p class="lineage-discovery">{item.discovery}</p>
            </div>
          ))}
        </div>
      </aside>
    )}

    <aside class="article-protocol-card" aria-label={`${spiralName} companion framework`}>
      <p class="protocol-eyebrow">Spiral of Cellular Light · Companion lens</p>
      <h3>{spiralName}</h3>
      <p class="protocol-focus">{protocolCard.focus}.</p>
      <div class="protocol-card-actions">
        <a class="primary-link" href={protocolProgramUrl} rel="noopener noreferrer" target="_blank">
          Walk the {spiralName} spiral <span aria-hidden="true">→</span>
        </a>
        <a class="protocol-secondary-link" href={protocolCard.pdfUrl} download>
          Companion field guide (PDF) ↓
        </a>
        <a class="protocol-secondary-link" href="/spiral-of-cellular-light/">
          All six spirals
        </a>
      </div>
      <p class="protocol-sourcing">
        In Canada, protocol supplements are stocked at
        <a href={withUtm(protocolCard.href, "brief-page-sourcing")} rel="sponsored noopener noreferrer" target="_blank">our Fullscript dispensary</a>
        (commission-supported; no added cost to you).
      </p>
    </aside>

    {related.length > 0 && <section class="related-briefs" aria-labelledby="related-heading">
      <div>
        <p class="eyebrow">Continue the thread</p>
        <h2 id="related-heading">More on {entry.data.category}</h2>
        <a class="topic-link" href={`/topics/${topicSlug(entry.data.category)}/`}>Browse the full topic <span>→</span></a>
      </div>
      <ol>
        {related.map((candidate) => <li><a href={`/brief/${candidate.id}/`}>{typographic(candidate.data.title)}</a><span>{candidate.data.source_name}</span></li>)}
      </ol>
    </section>}
    <footer class="article-footer"><span>Keep asking better questions.</span><a href="/#subscribe">Get tomorrow’s edition →</a></footer>
  </article>

</Layout>

<style>
  .article-lineage-card,
  .article-protocol-card {
    max-width: 700px;
    margin: 52px 0 0 10%;
    padding: 28px 0 0;
    border-top: 1px solid var(--ink);
  }
  .article-page.is-lead .article-lineage-card,
  .article-page.is-lead .article-protocol-card {
    max-width: 760px;
  }
  .lineage-eyebrow,
  .protocol-eyebrow {
    display: block;
    margin: 0 0 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--saffron-ink);
  }
  .article-lineage-card h3 {
    margin: 0 0 20px;
    font-size: 1.5rem;
  }
  .lineage-timeline {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .lineage-item {
    padding-left: 16px;
    border-left: 2px solid var(--saffron);
  }
  .lineage-year {
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--saffron-ink);
    margin-right: 8px;
  }
  .lineage-scientist {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .lineage-discovery {
    margin: 4px 0 0;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.45;
  }
  .article-protocol-card {
    padding: 26px 28px 24px;
    background: color-mix(in oklch, var(--mist) 35%, var(--paper));
    border: 1px solid var(--line);
    border-left: 3px solid var(--saffron);
  }
  .article-protocol-card h3 {
    font-family: var(--serif);
    font-size: 1.75rem;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .protocol-focus {
    font-family: var(--serif);
    font-size: 1.08rem;
    color: var(--ink-soft);
    margin: 0 0 18px;
    max-width: 58ch;
  }
  .protocol-card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-bottom: 14px;
  }
  .protocol-secondary-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration-color: var(--line);
  }
  .protocol-secondary-link:hover {
    color: var(--saffron-ink);
    text-decoration-color: var(--saffron);
  }
  .protocol-sourcing {
    max-width: 62ch;
    margin: 12px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.45;
  }
  .protocol-sourcing a {
    color: var(--ink-soft);
    font-weight: 600;
  }
  @media (max-width: 700px) {
    .article-lineage-card,
    .article-protocol-card {
      margin-left: 0;
    }
    .article-protocol-card {
      padding: 22px 20px 20px;
    }
  }
</style>
