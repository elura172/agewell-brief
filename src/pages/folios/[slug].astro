---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import FolioSolarPlate from "../../components/FolioSolarPlate.astro";
import { linkRel, readingTimeMinutes, spiralSlugFor, spiralTeachingUrl, spiralWalkUrl, typographic } from "../../lib/publishing";

export async function getStaticPaths() {
  const folios = (await getCollection("folios"))
    .filter((entry) => import.meta.env.DEV || !entry.data.draft)
    .sort((a, b) => b.data.issue_number - a.data.issue_number);

  return folios.map((folio) => ({
    params: { slug: folio.id },
    props: { folio }
  }));
}

const { folio } = Astro.props;
const { Content } = await render(folio);

const allBriefs = await getCollection("briefs");
const briefById = new Map(allBriefs.map((entry) => [entry.id, entry]));

const boundDispatches = folio.data.featured_briefs.map((item, idx) => {
  const matched = briefById.get(item.slug);
  if (!matched) {
    throw new Error(`Folio "${folio.id}" references missing brief slug: ${item.slug}`);
  }
  return {
    index: idx + 1,
    role: item.role,
    note: item.note,
    entry: matched
  };
});

const readMinutes = readingTimeMinutes(folio.body ?? "");
const issueLabel = `Folio No. ${String(folio.data.issue_number).padStart(2, "0")}`;
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-CA", { month: "long", day: "numeric", year: "numeric" });
const formatShortDate = (date: Date) =>
  date.toLocaleDateString("en-CA", { month: "short", day: "numeric", year: "numeric" });

const folioURL = new URL(`/folios/${folio.id}/`, Astro.site).href;
const folioSpiralSlug = folio.data.spiral ? spiralSlugFor(folio.data.spiral) : "";
const folioPdfBySlug: Record<string, string> = {
  waters: "/downloads/field-guides/living-waters-field-guide.pdf",
  garden: "/downloads/field-guides/inner-garden-field-guide.pdf",
  shedding: "/downloads/field-guides/cell-shedding-field-guide.pdf",
  flame: "/downloads/field-guides/higher-flame-field-guide.pdf",
  mind: "/downloads/field-guides/luminous-mind-field-guide.pdf",
  mirror: "/downloads/field-guides/dark-mirror-field-guide.pdf"
};
const folioPdfUrl = folioPdfBySlug[folioSpiralSlug] || "/downloads/field-guides/living-waters-field-guide.pdf";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: folio.data.title,
    description: folio.data.description,
    ...(folio.data.image ? { image: [new URL(folio.data.image, Astro.site).href] } : {}),
    datePublished: folio.data.date.toISOString(),
    author: {
      "@type": "Organization",
      name: "Agewell Brief Editorial Desk",
      url: new URL("/about/#editorial-desk", Astro.site).href
    },
    publisher: {
      "@type": "Organization",
      name: "Agewell Brief",
      logo: { "@type": "ImageObject", url: new URL("/logo.svg", Astro.site).href }
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": folioURL }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Agewell Brief", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: "Broadsheet Folios", item: new URL("/folios/", Astro.site).href },
      { "@type": "ListItem", position: 3, name: `${issueLabel}: ${folio.data.title}`, item: folioURL }
    ]
  }
];
---
<Layout
  title={`${issueLabel}: ${folio.data.title} · Agewell Brief`}
  description={folio.data.description}
  canonicalURL={folioURL}
  ogType="article"
  image={folio.data.image}
  imageAlt={folio.data.image_alt}
  imageWidth={folio.data.image_width}
  imageHeight={folio.data.image_height}
  publishedTime={folio.data.date}
  structuredData={structuredData}
>
  <article class="folio-issue-page">
    <div class="folio-issue-topbar">
      <a class="back-link" href="/folios/">← All Broadsheet Folios</a>
      <div class="article-util-actions" aria-label="Folio reading tools">
        <button type="button" class="article-util-btn" id="folio-copy-btn" data-url={folioURL}>
          Copy link
        </button>
        <button type="button" class="article-util-btn folio-print-btn" id="folio-print-btn">
          Print two-column broadsheet
        </button>
      </div>
    </div>

    <header class="folio-issue-header">
      <div class="edition-mast folio-issue-mast">
        <span>{issueLabel} · {formatDate(folio.data.date)}</span>
        <span>{folio.data.solar_marker}</span>
        <span>{readMinutes} min synthesis · {boundDispatches.length} primary dispatches</span>
      </div>

      <div class="folio-issue-hero-grid">
        <div class="folio-issue-title-block">
          <p class="eyebrow">Seasonal Broadsheet Synthesis</p>
          <h1>{typographic(folio.data.title)}</h1>
          <p class="folio-issue-subtitle">{typographic(folio.data.subtitle)}</p>

          <ul class="folio-domain-pills" aria-label="Folio domains">
            {folio.data.spiral && (
              <li>
                <a href="/spiral-of-cellular-light/">Spiral · {folio.data.spiral}</a>
              </li>
            )}
            {folio.data.theme_domains.map((domain) => (
              <li>{domain}</li>
            ))}
          </ul>
        </div>

        <figure class="folio-issue-plate-figure">
          {folio.data.image ? (
            <div class="folio-lithograph-frame" style={`--image-tone: ${folio.data.image_avg_color ?? "#f4efe4"}`}>
              <img
                src={folio.data.image}
                alt={folio.data.image_alt ?? `${issueLabel}: ${folio.data.title}`}
                width={folio.data.image_width ?? 1376}
                height={folio.data.image_height ?? 768}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          ) : (
            <FolioSolarPlate season={folio.data.season} size="hero" />
          )}
          <figcaption>
            <span>Plate {String(folio.data.issue_number).padStart(2, "0")} · {folio.data.image_photographer ?? "Agewell Brief Visual Desk"}</span>
            <span>{folio.data.solar_marker}</span>
          </figcaption>
        </figure>
      </div>
    </header>

    <div class="folio-prose">
      <Content />
    </div>

    <section class="folio-dossier" aria-labelledby="dossier-heading">
      <div class="section-heading folio-dossier-heading">
        <div>
          <p class="eyebrow">Primary Evidence Ledger</p>
          <h2 id="dossier-heading" class="section-title">Dispatches bound in this Folio</h2>
        </div>
        <p class="section-caption">{boundDispatches.length} peer-reviewed and preprint analyses from the Agewell desk</p>
      </div>

      <ol class="folio-dossier-grid">
        {boundDispatches.map(({ index, role, note, entry }) => (
          <li class="folio-dossier-item">
            <div class="folio-dossier-topline">
              <span class="folio-dossier-num">{String(index).padStart(2, "0")}</span>
              <span class="folio-dossier-role">{role}</span>
              <span class={`evidence-badge evidence-badge--${entry.data.evidence_position}`}>
                {entry.data.evidence_position}
              </span>
            </div>
            <h3>
              <a href={`/brief/${entry.id}/`}>{typographic(entry.data.title)}</a>
            </h3>
            <p class="folio-dossier-note">{note}</p>
            <div class="folio-dossier-foot">
              <span>{formatShortDate(entry.data.date)} · {entry.data.source_name}</span>
              <div class="folio-dossier-links">
                <a href={`/brief/${entry.id}/`}>Read brief <span aria-hidden="true">→</span></a>
                <a href={entry.data.source_url} rel={linkRel(entry.data.source_url)}>Source <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <footer class="folio-colophon">
      {folio.data.spiral && (
        <aside class="folio-guide-box" data-spiral-slug={folioSpiralSlug} data-pdf-url={folioPdfUrl}>
          <form id="folio-guide-form" class="folio-guide-form">
            <label for="folio-guide-email" class="folio-guide-label">
              <strong>Companion Field Guide · {folio.data.spiral}:</strong> Download the 4-page printable protocol PDF (dosing windows, Phase I/II sequence &amp; seasonal rhythm):
            </label>
            <div class="folio-guide-row">
              <input
                type="email"
                id="folio-guide-email"
                required
                placeholder="Enter your email for instant PDF download…"
                class="folio-guide-input"
              />
              <button type="submit" id="folio-guide-btn" class="folio-guide-btn">
                Unlock Field Guide PDF ↓
              </button>
            </div>
          </form>
          <div id="folio-guide-unlocked" class="folio-guide-unlocked is-hidden">
            <p class="folio-step-kicker">Step 2 · Ready When You Want Structure</p>
            <p class="folio-step-copy">
              Your <strong>{folio.data.spiral}</strong> Field Guide is unlocked. Step into your pre-calibrated 28-Day Protocol Workspace:
            </p>
            <div class="folio-step-actions">
              <a class="primary-link js-folio-walk-link" href={spiralWalkUrl(folio.data.spiral, `folio-step2-walk-${folio.id}`, "monthly")} target="_blank" rel="noopener noreferrer">
                Start 28-Day {folio.data.spiral} Workspace ($33/mo) →
              </a>
              <a class="js-folio-walk-link" href={spiralWalkUrl(folio.data.spiral, `folio-step2-annual-${folio.id}`, "annual")} target="_blank" rel="noopener noreferrer">
                Annual Passage ($222/yr · Save 44%) ↗
              </a>
              <a id="folio-guide-pdf-link" href={folioPdfUrl} download>
                Re-download {folio.data.spiral} PDF ↓
              </a>
            </div>
          </div>
        </aside>
      )}
      <p>
        <strong>Colophon &amp; Evidence Note:</strong> {folio.data.colophon_note}
      </p>
      <div class="folio-colophon-links">
        <a href="/folios/">← Solar Folio Index</a>
        {folio.data.spiral && (
          <a class="js-folio-walk-link" href={spiralWalkUrl(folio.data.spiral, `folio-walk-${folio.id}`, "annual")} target="_blank" rel="noopener noreferrer">
            Run {folio.data.spiral} in the 28-Day Protocol ($33/mo · $222/yr) →
          </a>
        )}
        {folio.data.spiral && (
          <a href={spiralTeachingUrl(folio.data.spiral, `folio-teaching-${folio.id}`)} target="_blank" rel="noopener noreferrer">
            {folio.data.spiral} biophysics monograph ↗
          </a>
        )}
        <a href="/frontier-map/">Explore the Living Frontier Map →</a>
      </div>
    </footer>
  </article>

  <script>
    const copyBtn = document.getElementById("folio-copy-btn");
    const printBtn = document.getElementById("folio-print-btn");

    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        const url = copyBtn.getAttribute("data-url") || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          const prev = copyBtn.textContent;
          copyBtn.textContent = "Link copied";
          copyBtn.setAttribute("data-copied", "true");
          setTimeout(() => {
            copyBtn.textContent = prev;
            copyBtn.removeAttribute("data-copied");
          }, 1800);
        } catch (_) {}
      });
    }

    if (printBtn) {
      printBtn.addEventListener("click", () => window.print());
    }

    const folioBox = document.querySelector(".folio-guide-box") as HTMLElement | null;
    const folioForm = document.getElementById("folio-guide-form") as HTMLFormElement | null;
    const folioEmail = document.getElementById("folio-guide-email") as HTMLInputElement | null;
    const folioBtn = document.getElementById("folio-guide-btn") as HTMLButtonElement | null;
    const folioUnlocked = document.getElementById("folio-guide-unlocked");
    const folioPdfLink = document.getElementById("folio-guide-pdf-link") as HTMLAnchorElement | null;
    const folioSlug = folioBox?.dataset.spiralSlug || "waters";

    function applyFolioEmail(email: string) {
      if (!email) return;
      document.querySelectorAll<HTMLAnchorElement>(".js-folio-walk-link").forEach((a) => {
        try {
          const u = new URL(a.href);
          u.searchParams.set("email", email);
          a.href = u.toString();
        } catch {}
      });
    }

    try {
      const saved = localStorage.getItem("agewell_lead_email");
      if (saved && folioForm && folioUnlocked) {
        applyFolioEmail(saved);
        folioForm.style.display = "none";
        folioUnlocked.classList.remove("is-hidden");
      }
    } catch {}

    if (folioForm && folioEmail && folioBtn && folioUnlocked) {
      folioForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = folioEmail.value.trim().toLowerCase();
        if (!email) return;
        folioBtn.disabled = true;
        folioBtn.textContent = "Unlocking…";

        try {
          await fetch("https://spiraloflight.life/api/phase0", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email,
              tier: folioSlug === "waters" ? "gentle_waters" : "full_foundation",
              region: "us",
              guideSlug: folioSlug,
              source: `agewell_folio_${folioSlug}`
            })
          });
        } catch {}

        try {
          localStorage.setItem("agewell_lead_email", email);
          window.dispatchEvent(
            new CustomEvent("agewell:lead-captured", {
              detail: { placement: "folio_page", spiral: folioSlug, page_path: window.location.pathname }
            })
          );
        } catch {}

        applyFolioEmail(email);
        folioForm.style.display = "none";
        folioUnlocked.classList.remove("is-hidden");
        if (folioPdfLink) folioPdfLink.click();
      });
    }
  </script>

  <style>
    .folio-guide-box {
      margin: 0 0 22px;
      padding: 16px 18px;
      background: var(--cream);
      border: 1px solid var(--line);
      border-left: 3px solid var(--saffron);
    }
    .folio-guide-label {
      display: block;
      margin: 0 0 10px;
      font-family: var(--sans);
      font-size: 0.85rem;
      color: var(--ink-soft);
    }
    .folio-guide-label strong {
      color: var(--ink);
    }
    .folio-guide-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .folio-guide-input {
      flex: 1 1 220px;
      min-height: 38px;
      padding: 8px 12px;
      font-family: var(--sans);
      font-size: 0.88rem;
      border: 1px solid var(--line-strong);
      border-radius: 2px;
      background: var(--white);
      color: var(--ink);
    }
    .folio-guide-btn {
      min-height: 38px;
      padding: 8px 14px;
      font-family: var(--sans);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      background: var(--ink);
      color: var(--paper);
      border: 1px solid var(--ink);
      border-radius: 2px;
      cursor: pointer;
    }
    .folio-guide-btn:hover {
      background: var(--saffron-ink);
      border-color: var(--saffron-ink);
    }
    .folio-guide-unlocked.is-hidden {
      display: none;
    }
    .folio-step-kicker {
      margin: 0 0 4px;
      font-family: var(--sans);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--saffron-ink);
    }
    .folio-step-copy {
      margin: 0 0 10px;
      font-family: var(--sans);
      font-size: 0.86rem;
      color: var(--ink);
    }
    .folio-step-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px 18px;
      font-family: var(--sans);
      font-size: 0.82rem;
      font-weight: 600;
    }
  </style>
</Layout>
