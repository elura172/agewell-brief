---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { frontierTerritories } from "../data/frontier-map";
import { plainTextExcerpt } from "../lib/publishing";

const entries = (await getCollection("briefs"))
  .filter((entry) => import.meta.env.DEV || !entry.data.draft);

const categoryColors: Record<string, string> = {
  "brain-health": "oklch(0.72 0.16 220)",
  "cellular-senescence": "oklch(0.75 0.18 55)",
  "gut-health": "oklch(0.70 0.17 145)",
  "longevity": "oklch(0.74 0.15 190)",
  "metabolic-health": "oklch(0.72 0.18 35)",
  "detoxification": "oklch(0.68 0.14 290)",
  "general-wellness": "oklch(0.70 0.12 120)",
  "consumer-safety": "oklch(0.65 0.15 15)",
  "nutrition": "oklch(0.72 0.15 80)",
  "sleep-health": "oklch(0.68 0.15 250)"
};

// Build graph nodes from collection
const nodes = [
  ...frontierTerritories.map((t, i) => ({
    id: `territory-${t.slug}`,
    name: t.name,
    category: "Frontier Territory",
    type: "territory",
    evidence: t.status,
    seedIdea: t.description,
    url: `/frontier-map/#${t.slug}`,
    antecedents: [],
    baseX: (i % 2 === 0 ? -1 : 1) * (260 + i * 40),
    baseY: (i < 2 ? -1 : 1) * (180 + i * 30),
    x: (i % 2 === 0 ? -1 : 1) * (260 + i * 40),
    y: (i < 2 ? -1 : 1) * (180 + i * 30),
    radius: 20,
    color: "oklch(0.75 0.18 55)"
  })),
  ...entries.map((e, i) => {
    const color = categoryColors[e.data.category] || "oklch(0.68 0.15 200)";
    const baseX = Math.cos(i * 0.35) * (140 + (i % 5) * 65);
    const baseY = Math.sin(i * 0.35) * (140 + (i % 5) * 65);
    return {
      id: e.id,
      name: e.data.title,
      category: e.data.category,
      type: "brief",
      evidence: e.data.evidence_position,
      seedIdea: plainTextExcerpt((e.body ?? "").split("\n\n")[0], 220),
      ancestralInsight: e.data.ancestral_insight || "",
      url: `/brief/${e.id}/`,
      antecedents: e.data.autoresearch_antecedents || [],
      baseX,
      baseY,
      x: baseX,
      y: baseY,
      radius: 12,
      color
    };
  })
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Mind Ocean — Agewell Brief",
  description: "An interactive biophotonic semantic ocean visualizing thought lineages, cellular evidence, and biophysics antecedents.",
  url: new URL("/mind-ocean/", Astro.site).href
};
---
<Layout
  title="Mind Ocean — Agewell Brief"
  description="An interactive biophotonic semantic ocean visualizing thought lineages, cellular evidence, and biophysics antecedents."
  structuredData={structuredData}
>
  <main class="mind-ocean-page">
    <header class="ocean-header">
      <div>
        <a class="back-link" href="/">← Today’s edition</a>
        <p class="eyebrow">Metaphysical Brain Vault · Agewell Brief</p>
        <h1>Mind <em>Ocean.</em></h1>
      </div>
      <div class="ocean-controls">
        <button id="live-toggle-btn" type="button" class="ocean-btn ocean-btn--live is-active" aria-label="Toggle Live Stream">
          <span class="btn-icon">✨</span>
          <span class="btn-text">Live View: Active</span>
        </button>
        <button id="audio-toggle-btn" type="button" class="ocean-btn ocean-btn--audio" aria-label="Toggle ambient audio">
          <span class="btn-icon">🔇</span>
          <span class="btn-text">Ambient Sound: Muted</span>
        </button>
        <a class="ocean-btn" href="/frontier-map/">Frontier Map ↗</a>
      </div>
    </header>

    <div class="ocean-filter-bar">
      <input id="ocean-search-input" type="search" class="ocean-search" placeholder="Search biophysics ocean..." aria-label="Search ocean" />
      <div class="filter-pills" id="filter-pills">
        <button class="filter-pill is-active" data-category="all">All Currents</button>
        <button class="filter-pill" data-category="brain-health">Luminous Mind</button>
        <button class="filter-pill" data-category="cellular-senescence">Cell Shedding</button>
        <button class="filter-pill" data-category="gut-health">Inner Garden</button>
        <button class="filter-pill" data-category="longevity">Living Waters</button>
        <button class="filter-pill" data-category="metabolic-health">Higher Flame</button>
        <button class="filter-pill" data-category="detoxification">Dark Mirror</button>
      </div>
    </div>

    <div class="ocean-stage-container" id="ocean-stage">
      <canvas id="mind-ocean-canvas" data-nodes={JSON.stringify(nodes)}></canvas>
      
      <div id="node-tooltip" class="node-tooltip is-hidden"></div>

      <div id="ocean-inspector" class="ocean-inspector is-hidden" aria-label="Node inspector">
        <button id="inspector-close-btn" class="inspector-close" type="button">×</button>
        <span id="inspector-category" class="inspector-badge">Topic</span>
        <h3 id="inspector-title">Select a node</h3>
        <p id="inspector-evidence" class="inspector-meta"></p>
        <p id="inspector-seed-idea" class="inspector-seed-idea"></p>
        <div id="inspector-antecedents" class="inspector-antecedents"></div>
        <a id="inspector-link" class="primary-link" href="#" target="_blank">Open article <span>→</span></a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .mind-ocean-page {
    max-width: 1340px;
    margin: 0 auto;
    padding: 40px 5vw 80px;
  }
  .ocean-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
  }
  .ocean-header h1 {
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    line-height: 1;
  }
  .ocean-header h1 em {
    font-weight: 400;
    color: var(--muted);
  }
  .ocean-controls {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .ocean-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 30px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .ocean-btn:hover {
    border-color: var(--saffron);
    box-shadow: var(--shadow-sm);
  }
  .ocean-btn--audio.is-active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--saffron);
  }
  .ocean-btn--live.is-active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--saffron);
    box-shadow: 0 0 16px rgba(230, 160, 40, 0.3);
  }
  .ocean-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .ocean-search {
    padding: 10px 18px;
    border-radius: 24px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.85rem;
    min-width: 260px;
  }
  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .filter-pill {
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter-pill:hover,
  .filter-pill.is-active {
    color: var(--ink);
    border-color: var(--saffron);
    background: var(--cream);
  }
  .filter-pill--dream {
    border-color: oklch(0.70 0.22 310);
    color: oklch(0.40 0.18 310);
  }
  .filter-pill--dream.is-active {
    background: oklch(0.30 0.18 310);
    color: oklch(0.95 0.15 310);
  }
  .ocean-stage-container {
    position: relative;
    width: 100%;
    height: 720px;
    border-radius: 16px;
    border: 1px solid oklch(0.25 0.04 250);
    background: oklch(0.10 0.03 250);
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(10, 20, 35, 0.6);
    transition: background 0.6s ease, border-color 0.6s ease;
  }
  .ocean-stage-container.is-dreaming {
    background: oklch(0.12 0.06 295);
    border-color: oklch(0.40 0.18 310);
    box-shadow: 0 0 40px rgba(180, 50, 255, 0.2);
  }
  #mind-ocean-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
  }
  #mind-ocean-canvas:active {
    cursor: grabbing;
  }
  .node-tooltip {
    position: absolute;
    padding: 6px 12px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 6px;
    pointer-events: none;
    transition: opacity 0.15s ease;
    z-index: 20;
    box-shadow: var(--shadow-sm);
  }
  .node-tooltip.is-hidden {
    opacity: 0;
  }
  .ocean-inspector {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 360px;
    max-height: calc(100% - 48px);
    overflow-y: auto;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
    box-shadow: var(--shadow-lg);
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 10;
  }
  .ocean-inspector.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateX(20px);
  }
  .inspector-close {
    position: absolute;
    top: 14px;
    right: 16px;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--muted);
  }
  .inspector-badge {
    display: inline-block;
    color: var(--saffron-ink);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }
  .ocean-inspector h3 {
    margin: 0 0 10px;
    font-size: 1.35rem;
    line-height: 1.25;
  }
  .inspector-meta {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .inspector-seed-idea {
    font-family: var(--serif);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink);
    margin-bottom: 16px;
  }
  .inspector-antecedents {
    margin-bottom: 18px;
    font-size: 0.85rem;
    line-height: 1.45;
    background: var(--cream);
    padding: 12px;
    border-radius: 6px;
    border: 1px solid var(--line);
  }
  .inspector-antecedents h4 {
    margin: 0 0 6px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
</style>

<script>
  import { MindOceanAudio } from "../lib/mind-ocean-audio";

  const audioEngine = new MindOceanAudio();
  const audioBtn = document.getElementById("audio-toggle-btn");
  const liveBtn = document.getElementById("live-toggle-btn");
  const searchInput = document.getElementById("ocean-search-input") as HTMLInputElement;
  const filterPills = document.getElementById("filter-pills");

  let isLiveStreaming = true;
  let activeCategoryFilter = "all";
  let searchQuery = "";

  if (liveBtn) {
    liveBtn.addEventListener("click", () => {
      isLiveStreaming = !isLiveStreaming;
      const text = liveBtn.querySelector(".btn-text");
      const icon = liveBtn.querySelector(".btn-icon");
      if (isLiveStreaming) {
        liveBtn.classList.add("is-active");
        if (icon) icon.textContent = "✨";
        if (text) text.textContent = "Live View: Active";
      } else {
        liveBtn.classList.remove("is-active");
        if (icon) icon.textContent = "⏸️";
        if (text) text.textContent = "Live View: Paused";
      }
    });
  }
  
  if (audioBtn) {
    audioBtn.addEventListener("click", () => {
      const isMuted = audioEngine.toggleMute();
      const icon = audioBtn.querySelector(".btn-icon");
      const text = audioBtn.querySelector(".btn-text");
      
      if (isMuted) {
        audioBtn.classList.remove("is-active");
        if (icon) icon.textContent = "🔇";
        if (text) text.textContent = "Ambient Sound: Muted";
      } else {
        audioBtn.classList.add("is-active");
        if (icon) icon.textContent = "🔊";
        if (text) text.textContent = "Ambient Sound: Playing";
      }
    });
  }

  // Interactive 2D Force Field Canvas Initialization
  const canvas = document.getElementById("mind-ocean-canvas") as HTMLCanvasElement;
  const inspector = document.getElementById("ocean-inspector");
  const closeBtn = document.getElementById("inspector-close-btn");
  const tooltip = document.getElementById("node-tooltip");

  if (closeBtn && inspector) {
    closeBtn.addEventListener("click", () => {
      inspector.classList.add("is-hidden");
    });
  }

  if (canvas) {
    const ctx = canvas.getContext("2d");
    const rawNodesData = canvas.dataset.nodes || "[]";
    const nodes = JSON.parse(rawNodesData);

    let width = canvas.clientWidth;
    let height = canvas.clientHeight;
    let panX = width / 2;
    let panY = height / 2;
    let zoom = 1;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let hoveredNode: any = null;
    let selectedNode: any = null;

    function resize() {
      if (!canvas || !ctx) return;
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width * window.devicePixelRatio;
      canvas.height = height * window.devicePixelRatio;
      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }

    function render(time: number) {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      // Organic sine wave floating motion
      nodes.forEach((n: any) => {
        n.x = n.baseX + Math.sin(time * 0.0012 + n.baseY * 0.02) * 12;
        n.y = n.baseY + Math.cos(time * 0.0015 + n.baseX * 0.02) * 12;
      });

      ctx.save();
      ctx.translate(panX, panY);
      ctx.scale(zoom, zoom);

      // Draw biophotonic connecting currents
      ctx.lineWidth = 1;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[j].x - nodes[i].x;
          const dy = nodes[j].y - nodes[i].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 180) {
            const isHighlighted = (hoveredNode && (hoveredNode.id === nodes[i].id || hoveredNode.id === nodes[j].id)) ||
                                  (selectedNode && (selectedNode.id === nodes[i].id || selectedNode.id === nodes[j].id));
            ctx.strokeStyle = isHighlighted ? nodes[i].color : "rgba(80, 120, 160, 0.35)";
            ctx.lineWidth = isHighlighted ? 2 : 1;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();

            // Moving biophotonic light bead along stream
            const progress = (time * 0.0006 + (i + j) * 0.1) % 1;
            const beadX = nodes[i].x + dx * progress;
            const beadY = nodes[i].y + dy * progress;
            ctx.fillStyle = isHighlighted ? nodes[i].color : "rgba(150, 210, 255, 0.75)";
            ctx.beginPath();
            ctx.arc(beadX, beadY, isHighlighted ? 3 : 1.8, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }

      // Draw living nodes
      nodes.forEach((n: any) => {
        const isSelected = selectedNode && selectedNode.id === n.id;
        const isHovered = hoveredNode && hoveredNode.id === n.id;

        ctx.fillStyle = n.color || "oklch(0.68 0.15 200)";
        ctx.beginPath();
        ctx.arc(n.x, n.y, isSelected ? n.radius * 1.4 : isHovered ? n.radius * 1.2 : n.radius, 0, Math.PI * 2);
        ctx.fill();

        // Node aura pulse
        ctx.fillStyle = n.color || "oklch(0.68 0.15 200)";
        ctx.globalAlpha = isSelected ? 0.4 : isHovered ? 0.3 : 0.15 + Math.sin(time * 0.002 + n.x) * 0.08;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.radius * (isSelected ? 3.2 : 2.2), 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = 1;
      });

      ctx.restore();
      requestAnimationFrame(render);
    }

    window.addEventListener("resize", resize);
    resize();
    requestAnimationFrame(render);

    // Node hit testing helper
    function getCanvasCoords(e: MouseEvent) {
      const rect = canvas.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;
      const worldX = (mouseX - panX) / zoom;
      const worldY = (mouseY - panY) / zoom;
      return { mouseX, mouseY, worldX, worldY };
    }

    function findNodeAt(worldX: number, worldY: number) {
      return nodes.find((n: any) => {
        const dx = n.x - worldX;
        const dy = n.y - worldY;
        return Math.sqrt(dx * dx + dy * dy) <= n.radius * 1.5;
      });
    }

    // Hover tooltip
    canvas.addEventListener("mousemove", (e) => {
      const { mouseX, mouseY, worldX, worldY } = getCanvasCoords(e);
      if (isDragging) {
        panX = e.clientX - dragStartX;
        panY = e.clientY - dragStartY;
        if (tooltip) tooltip.classList.add("is-hidden");
        return;
      }

      hoveredNode = findNodeAt(worldX, worldY);
      if (hoveredNode && tooltip) {
        tooltip.textContent = hoveredNode.name;
        tooltip.style.left = `${mouseX + 15}px`;
        tooltip.style.top = `${mouseY + 15}px`;
        tooltip.classList.remove("is-hidden");
      } else if (tooltip) {
        tooltip.classList.add("is-hidden");
      }
    });

    // Node Selection & Audition
    canvas.addEventListener("click", (e) => {
      const { worldX, worldY } = getCanvasCoords(e);
      const clicked = findNodeAt(worldX, worldY);
      if (clicked) {
        selectedNode = clicked;
        audioEngine.playNodeAudition(220 + (nodes.indexOf(clicked) % 8) * 54);

        if (inspector) {
          const categoryEl = document.getElementById("inspector-category");
          const titleEl = document.getElementById("inspector-title");
          const evidenceEl = document.getElementById("inspector-evidence");
          const seedEl = document.getElementById("inspector-seed-idea");
          const antEl = document.getElementById("inspector-antecedents");
          const linkEl = document.getElementById("inspector-link") as HTMLAnchorElement;

          if (categoryEl) categoryEl.textContent = clicked.category;
          if (titleEl) titleEl.textContent = clicked.name;
          if (evidenceEl) evidenceEl.textContent = `Evidence Position: ${clicked.evidence}`;
          if (seedEl) seedEl.textContent = clicked.seedIdea || "";

          if (antEl) {
            if (clicked.antecedents && clicked.antecedents.length > 0) {
              antEl.innerHTML = `<h4>Historical Biophysics Lineage</h4>` + 
                clicked.antecedents.map((a: any) => `<div><strong>${a.scientist} (${a.year}):</strong> ${a.discovery}</div>`).join("");
              antEl.style.display = "block";
            } else {
              antEl.style.display = "none";
            }
          }

          if (linkEl) {
            linkEl.href = clicked.url;
            linkEl.style.display = clicked.url ? "inline-flex" : "none";
          }

          inspector.classList.remove("is-hidden");
        }
      }
    });

    // Pan & Zoom controls
    canvas.addEventListener("mousedown", (e) => {
      isDragging = true;
      dragStartX = e.clientX - panX;
      dragStartY = e.clientY - panY;
    });

    window.addEventListener("mouseup", () => {
      isDragging = false;
    });

    canvas.addEventListener("wheel", (e) => {
      e.preventDefault();
      const zoomFactor = e.deltaY < 0 ? 1.08 : 0.92;
      zoom = Math.max(0.4, Math.min(2.5, zoom * zoomFactor));
    });
  }
</script>
