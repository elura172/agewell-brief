---
import FieldGuideGate from "../components/FieldGuideGate.astro";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  publishedTime?: Date;
  modifiedTime?: Date;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

import "../styles/global.css";

const {
  title = "Agewell Brief — Global Biophysics & Longevity Science Intelligence",
  description = "Independent daily synthesis of biophysics, cellular longevity, quantum biology, and healthspan preprints. Source-linked, direct science for human vitality.",
  ogType = "website",
  image = "/og-default.png",
  imageAlt = "Agewell Brief — Clear signals. Better questions.",
  imageWidth = 1200,
  imageHeight = 630,
  publishedTime,
  modifiedTime,
  structuredData
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = image ? new URL(image, Astro.site) : undefined;
const structuredDataJSON = structuredData
  ? JSON.stringify(structuredData).replaceAll("<", "\\u003c")
  : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Agewell Brief RSS" href={new URL("/rss.xml", Astro.site)} />
    <link rel="sitemap" href={new URL("/sitemap-index.xml", Astro.site)} />

    {/* PostHog Analytics Initialization */}
    <script>
      import posthog from "posthog-js";
      const phKey = import.meta.env.PUBLIC_POSTHOG_KEY || "phc_wSfGJVVVCEyhwRLphKpaTKXHQjditqCQwmWDWFjgjUSR";
      const phHost = import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com";

      if (phKey) {
        posthog.init(phKey, {
          api_host: phHost,
          person_profiles: "identified_only",
          capture_pageview: true,
          capture_pageleave: true
        });

        // Global Event Listeners for Conversion Tracking
        document.addEventListener("click", (e) => {
          const target = (e.target as HTMLElement)?.closest("a");
          if (!target) return;
          const href = target.getAttribute("href") || "";
          
          if (href.includes("fullscript.com")) {
            posthog.capture("fullscript_link_clicked", { url: href, text: target.innerText });
          } else if (href.includes("substack.com")) {
            posthog.capture("substack_link_clicked", { url: href, text: target.innerText });
          } else if (href.includes(".pdf")) {
            posthog.capture("pdf_download_clicked", { pdf: href, name: target.innerText });
          }
        });
      }
    </script>

    <meta property="og:site_name" content="Agewell Brief" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {imageURL && <meta property="og:image" content={imageURL} />}
    {imageURL && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {imageURL && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageURL && <meta property="og:image:height" content={String(imageHeight)} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    {imageURL && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {structuredDataJSON && <script type="application/ld+json" set:html={structuredDataJSON} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Agewell Brief home">
        <img class="wordmark-mark" src="/logo-mark.svg" width="36" height="36" alt="" aria-hidden="true" loading="eager" decoding="async" fetchpriority="high" />
        <span>Agewell <em>Brief</em></span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#latest" title="Today's Lead Feature & Signals">Latest</a>
        <a href="/archive/" title="Full Archive — Every Published Brief">Archive</a>
        <a href="/frontier-map/" title="Frontier Map — Visual Index of Biophysics Research Territories">Frontier map</a>
        <a href="/mind-ocean/" title="Mind Ocean — Interactive Biophotonic Semantic Canvas">Mind ocean</a>
        <a href="/spiral-of-cellular-light/" title="The Spiral of Cellular Light — Protocol Program">Protocols</a>
        <a href="https://agewellbrief.substack.com" target="_blank" rel="noopener noreferrer" title="Agewell Brief on Substack">Substack ↗</a>
        <a href="/about/" title="About — Editorial Discipline & Mission">About</a>
        <button type="button" id="font-size-btn" class="font-size-btn" title="Toggle Reader Text Size (Normal / Medium / Large)" aria-label="Text size: Normal. Activate to change.">
          <span aria-hidden="true">Aa</span>
        </button>
        <a class="nav-subscribe" href="/#subscribe">Get the brief</a>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <FieldGuideGate />
    <footer class="site-footer">
      <div class="footer-signature"><span>AGEWELL BRIEF</span><span>Clear signals. Better questions.</span></div>
      <nav class="footer-links" aria-label="Publication information">
        <a href="/about/">About</a>
        <a href="https://agewellbrief.substack.com" target="_blank" rel="noopener noreferrer">Substack ↗</a>
        <a href="/editorial-policy/">Editorial policy</a>
        <a href="/spiral-of-cellular-light/">Spiral framework</a>
        <a href="/quarterly-report/">Quarterly report</a>
        <a href="/for-clinics/">For clinics & brands</a>
        <a href="/research-radar/">Research Radar</a>
        <a href="/affiliate-disclosure/">Disclosure</a>
        <a href="/privacy/">Privacy</a>
        <a href="/contact/">Contact</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </footer>

    <script>
      const SIZES = ["normal", "medium", "large"];
      const SIZE_LABELS = { normal: "Normal", medium: "Medium", large: "Large" };
      let currentIdx = 0;

      const btn = document.getElementById("font-size-btn");

      const announceSize = (size: string) => {
        if (btn) btn.setAttribute("aria-label", `Text size: ${SIZE_LABELS[size as keyof typeof SIZE_LABELS]}. Activate to change.`);
      };

      const savedSize = localStorage.getItem("agewell_font_size");
      if (savedSize && SIZES.includes(savedSize)) {
        document.documentElement.setAttribute("data-font-size", savedSize);
        currentIdx = SIZES.indexOf(savedSize);
        announceSize(savedSize);
      }

      if (btn) {
        btn.addEventListener("click", () => {
          currentIdx = (currentIdx + 1) % SIZES.length;
          const nextSize = SIZES[currentIdx];
          document.documentElement.setAttribute("data-font-size", nextSize);
          localStorage.setItem("agewell_font_size", nextSize);
          announceSize(nextSize);
        });
      }
    </script>
  </body>
</html>
