---
interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  structuredData?: Record<string, unknown>;
}

import "../styles/global.css";

const {
  title = "Agewell Brief — clear signals for a longer life",
  description = "Readable, source-linked health and longevity news for staying capable, curious, and independent.",
  ogType = "website",
  image,
  publishedTime,
  modifiedTime,
  structuredData
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = image ? new URL(image, Astro.site) : undefined;
const structuredDataJSON = structuredData
  ? JSON.stringify(structuredData).replaceAll("<", "\\u003c")
  : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Agewell Brief RSS" href={new URL("/rss.xml", Astro.site)} />
    <link rel="sitemap" href={new URL("/sitemap-index.xml", Astro.site)} />
    <meta property="og:site_name" content="Agewell Brief" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {imageURL && <meta property="og:image" content={imageURL} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {structuredDataJSON && <script type="application/ld+json" set:html={structuredDataJSON} />}
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Agewell Brief home">
        <span class="wordmark-mark" aria-hidden="true">A</span>
        <span>Agewell <em>Brief</em></span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#latest">Latest</a>
        <a href="/about/">About</a>
        <a class="nav-subscribe" href="/#subscribe">Get the brief</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-signature"><span>AGEWELL BRIEF</span><span>Clear signals. Better questions.</span></div>
      <nav class="footer-links" aria-label="Publication information">
        <a href="/about/">About</a>
        <a href="/editorial-policy/">Editorial policy</a>
        <a href="/affiliate-disclosure/">Disclosure</a>
        <a href="/privacy/">Privacy</a>
        <a href="/contact/">Contact</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </footer>
  </body>
</html>
