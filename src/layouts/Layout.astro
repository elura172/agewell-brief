---
interface Props {
  title?: string;
  description?: string;
}

import "../styles/global.css";

const {
  title = "Agewell Brief — clear signals for a longer life",
  description = "Readable, source-linked health and longevity news for staying capable, curious, and independent."
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Agewell Brief home">
        <span class="wordmark-mark" aria-hidden="true">A</span>
        <span>Agewell <em>Brief</em></span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#latest">Latest</a>
        <a href="/#about">About</a>
        <a class="nav-subscribe" href="/#subscribe">Get the brief</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>AGEWELL BRIEF</span>
      <span>Clear signals. Better questions.</span>
      <a href="/#subscribe">Join the morning edition →</a>
    </footer>
  </body>
</html>
