---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  eyebrow: string;
  lede: string;
}

const { title, eyebrow, lede } = Astro.props;
---
<Layout title={`${title} — Agewell Brief`} description={lede}>
  <article class="info-page">
    <header class="info-header">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p>{lede}</p>
    </header>
    <div class="info-content"><slot /></div>
  </article>
</Layout>
